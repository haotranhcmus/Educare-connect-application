<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ir_actions_server_view_form" model="ir.ui.view">
        <field name="name">ir.actions.server.view.form.inherit.ai</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <data>
                <!-- Add invisible fields needed for modifiers -->
                <field name="state" position="after">
                    <field name="ai_tool_is_candidate" invisible="1"/>
                    <field name="ai_tool_has_schema" invisible="1"/>
                    <field name="ai_tool_show_warning" invisible="1"/>
                </field>
                
                <!-- Add Usage tab after field code's page in notebook -->
                <xpath expr="//field[@name='code']/.." position="after">
                    <page string="Usage" name="ai_usage" invisible="not ai_tool_is_candidate">
                        <group>
                            <field name="use_in_ai" invisible="not ai_tool_is_candidate" readonly="context.get('default_use_in_ai', False)"/>
                            <field name="ai_tool_allow_end_message" invisible="not ai_tool_is_candidate" readonly="context.get('default_use_in_ai', False)"/>
                        </group>
                        <separator string="Description"/>
                        <field name="ai_tool_description"
                            invisible="not ai_tool_is_candidate or not use_in_ai" 
                            placeholder="Short explanation of what this does"
                            widget="text"
                            nolabel="1"/>
                        <separator string="Schema"/>
                        <field name="ai_tool_schema"
                            placeholder="JSON schema for the parameters of the action (leave empty if no arguments are needed)"
                            invisible="not ai_tool_is_candidate or not use_in_ai or not ai_tool_has_schema"
                            widget="ai_json_schema"
                            nolabel="1"/>
                    </page>
                </xpath>
                
                <!-- Modify notebook to show for both code and ai states -->
                <xpath expr="//notebook[@invisible]" position="attributes">
                    <attribute name="invisible">state not in ('code', 'ai')</attribute>
                </xpath>
                
                <!-- Hide Code page when state is ai -->
                <xpath expr="//field[@name='code']/.." position="attributes">
                    <attribute name="invisible">state != 'code'</attribute>
                </xpath>
                
                <!-- Hide Help page when state is ai -->
                <xpath expr="//notebook/page[2]" position="attributes">
                    <attribute name="invisible">state != 'code'</attribute>
                </xpath>
                
                <!-- Add AI Prompt page before Help page in notebook -->
                <xpath expr="//notebook/page[2]" position="before">
                    <page string="Prompt" name="ai_action_prompt" invisible="state != 'ai'">
                        <group>
                            <label for="ai_tool_ids"/>
                            <div class="d-flex flex-row align-items-baseline">
                                <i
                                    class="fa fa-warning text-warning me-2"
                                    invisible="not ai_tool_show_warning"
                                    aria-hidden="true"
                                    title="The AI will not be limited by the groups defined on tools"/>
                                <field name="ai_tool_ids"
                                    nolabel="1"
                                    widget="many2many_tags"
                                    domain="[('use_in_ai', '=', True), ('model_name', '=', model_name)]"
                                    options="{'no_create': True, 'no_create_edit': True}"/>
                            </div>
                            <field name="ai_action_prompt"
                                widget="ai_prompt"
                                options="{'model_reference_field': 'model_name'}"/>
                        </group>
                    </page>
                </xpath>
                
                <!-- Hide create_action button in AI context -->
                <xpath expr="//button[@name='create_action']" position="attributes">
                    <attribute name="invisible">context.get('default_use_in_ai', False)</attribute>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
