<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_topic_form" model="ir.ui.view">
        <field name="name">ai.topic.form</field>
        <field name="model">ai.topic</field>
        <field name="arch" type="xml">
            <form string="AI Topic">
                <sheet>
                    <group>
                        <field name="name" placeholder="Topic name"/>
                        <field name="description" placeholder="Brief description"/>
                    </group>
                    <group string="Configuration">
                        <field name="instructions" 
                               widget="text" 
                               placeholder="Instructions for AI agent"/>
                        <field name="tool_ids" 
                               widget="many2many_tags"
                               domain="[('use_in_ai', '=', True)]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_topic_tree" model="ir.ui.view">
        <field name="name">ai.topic.tree</field>
        <field name="model">ai.topic</field>
        <field name="arch" type="xml">
            <tree string="AI Topics">
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="action_ai_topic" model="ir.actions.act_window">
        <field name="name">AI Topics</field>
        <field name="res_model">ai.topic</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new AI Topic
            </p>
            <p>
                AI Topics group instructions and tools to guide AI agents in specific contexts.
                Configure mobile app restrictions at the Agent level (mobile_bundle_ids field).
            </p>
        </field>
    </record>

    <menuitem id="menu_ai_topic"
              name="AI Topics"
              parent="base.menu_administration"
              action="action_ai_topic"
              sequence="100"
              groups="base.group_system"/>
</odoo>
