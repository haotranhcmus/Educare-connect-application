<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ai_composer_form_mobile_inherit" model="ir.ui.view">
            <field name="name">ai.composer.form.mobile.inherit</field>
            <field name="model">ai.composer</field>
            <field name="inherit_id" ref="ai_app.ai_composer_form"/>
            <field name="arch" type="xml">
                <field name="ai_agent" position="after">
                    <field name="mobile_bundle_ids" 
                           invisible="interface_key != 'mobile_app'"
                           placeholder="e.g., com.xboss.*, com.pms.app"
                           help="Mobile apps that can use this agent. Supports wildcards (com.xboss.*). Leave empty to ignore."/>
                </field>
            </field>
        </record>
        
        <record id="ai_composer_tree_mobile_inherit" model="ir.ui.view">
            <field name="name">ai.composer.tree.mobile.inherit</field>
            <field name="model">ai.composer</field>
            <field name="inherit_id" ref="ai_app.ai_composer_tree"/>
            <field name="arch" type="xml">
                <field name="ai_agent" position="after">
                    <field name="mobile_bundle_ids" optional="hide"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
