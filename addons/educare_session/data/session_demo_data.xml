        <field name="phase">intervention</field>
        <field name="prompt_level_used">gestural_prompt</field>
        <field name="teaching_method">dtt</field>
        <field name="notes">Tre chi dap ung khi co goi y bang cu chi. Co 3/10 lan yeu cau doc lap.</field>
