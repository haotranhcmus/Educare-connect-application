<!--
    Session Demo Data
    =================
    Creates 8 reviewed sessions for Student An + 4 for Student Binh.
    All sessions are set to status='done' so their results are picked up by
    current_accuracy_pct, progress_pct, trend, and consecutive computations.

    Resulting progress after this data:

    Student An – Plan active
      obj_01_01 (Communication, target=80%, weight=3):
        Sessions: 30/40/50/50/60/60/70/70 %
        current = avg(60,70,70) = 66.7 %  |  progress ≈ 79 %  |  trend = improving

      obj_02_01 (Behavior - sit still, target=80%, weight=2):
        Sessions: 30/40/40/50 %
        current = avg(40,40,50) = 43 %  |  progress ≈ 47 %  |  trend = improving

      Goal 01 weighted progress = (79%×3 + 0%×1) / 4 ≈ 59 %
      Goal 02 weighted progress = 47 %
-->
<odoo noupdate="1">

    <!-- ============================================================ -->
    <!-- STUDENT AN – 8 sessions                                       -->
