    <!-- ============================================================ -->

    <!-- Buổi AN-01  (ngày -56)  obj_01_01=3/10  obj_02_01=3/10 -->
    <record id="demo_session_an_01" model="educare.session.log">
        <field name="name">SES-DEMO-AN-01</field>
        <field name="student_id" ref="educare_iep.demo_student_an" />
        <field name="teacher_id" ref="educare_security.user_educare_teacher_01" />
        <field name="session_date"
            eval="(DateTime.today() - relativedelta(days=56)).strftime('%Y-%m-%d')" />
        <field name="start_time">8.0</field>
        <field name="end_time">9.0</field>
        <field name="status">done</field>
        <field name="objective_ids"
            eval="[(4, ref('educare_iep.demo_obj_01_01')), (4, ref('educare_iep.demo_obj_02_01'))]" />
    </record>
    <record id="demo_result_an_01_c" model="educare.session.result">
        <field name="session_id" ref="demo_session_an_01" />
        <field name="objective_id" ref="educare_iep.demo_obj_01_01" />
        <field name="correct_trials">3</field>
        <field name="total_trials">10</field>
        <field name="result_type">trial_by_trial</field>
        <field name="phase">intervention</field>
        <field name="prompt_level_used">gestural_prompt</field>
        <field name="teaching_method">dtt</field>
        <field name="notes">Trẻ chỉ đáp ứng khi có gợi ý bằng cử chỉ. Có 3/10 lần yêu cầu độc lập.</field>
    </record>
    <record id="demo_result_an_01_b" model="educare.session.result">
        <field name="session_id" ref="demo_session_an_01" />
        <field name="objective_id" ref="educare_iep.demo_obj_02_01" />
        <field name="correct_trials">3</field>
        <field name="total_trials">10</field>
        <field name="result_type">trial_by_trial</field>
        <field name="phase">intervention</field>
        <field name="prompt_level_used">partial_physical</field>
        <field name="teaching_method">dtt</field>
        <field name="notes">Tần suất hành vi tự kích thích cao. Đã xác nhận baseline.</field>
    </record>

