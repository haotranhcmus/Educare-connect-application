            eval="(DateTime.today() - relativedelta(days=56)).strftime('%Y-%m-%d')" />
        <field name="start_time">8.0</field>
        <field name="end_time">9.0</field>
        <field name="status">done</field>
        <field name="attendance">present</field>
        <field name="mood">neutral</field>
        <field name="energy_level">normal</field>
        <field name="engagement_level">somewhat_engaged</field>
        <field name="notes">Tuan 1. Tre can nhieu goi y ho tro. Dang thiet lap nep hoc va moi quan he voi giao vien.</field>
        <field name="objective_ids"
