<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_session_result_tree" model="ir.ui.view">
        <field name="name">educare.session.result.tree</field>
        <field name="model">educare.session.result</field>
        <field name="arch" type="xml">
            <tree string="Session Results"
                decoration-success="mastery_achieved == True">
                <field name="session_id" />
                <field name="objective_id" />
                <field name="result_type" optional="hide" />
                <field name="correct_trials" />
                <field name="total_trials" />
                <field name="accuracy_pct" />
                <field name="prompt_level_used" />
                <field name="mastery_achieved" />
            </tree>
        </field>
    </record>
</odoo>