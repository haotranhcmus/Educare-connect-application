<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_session_log" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="res_model">educare.session.log</field>
        <field name="view_mode">tree,form,calendar</field>
        <field name="search_view_id" ref="view_session_log_search" />
        <field name="context">{'search_default_my_sessions': 1, 'search_default_active_sessions': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first session
            </p>
        </field>
    </record>

    <record id="action_session_result" model="ir.actions.act_window">
        <field name="name">Session Results</field>
        <field name="res_model">educare.session.result</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_session_result_search" />
    </record>
</odoo>