<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Session Log: Teacher sees own sessions -->
        <record id="session_log_teacher_rule" model="ir.rule">
            <field name="name">Session Log: Teacher → Own Sessions</field>
            <field name="model_id" ref="model_educare_session_log" />
            <field name="domain_force">[('teacher_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('educare_security.group_teacher'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="False" />
        </record>

        <!-- Session Log: Supervisor sees sessions in their center(s) -->
        <record id="session_log_supervisor_rule" model="ir.rule">
            <field name="name">Session Log: Supervisor → Center Sessions</field>
            <field name="model_id" ref="model_educare_session_log" />
            <field name="domain_force">[('center_id', 'in', user.educare_profile_ids.center_id.ids)]</field>
            <field name="groups" eval="[(4, ref('educare_security.group_supervisor'))]" />
        </record>

        <!-- Session Log: Admin → unrestricted -->
        <record id="session_log_admin_rule" model="ir.rule">
            <field name="name">Session Log: Admin → All</field>
            <field name="model_id" ref="model_educare_session_log" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('educare_security.group_admin'))]" />
        </record>

        <!-- Session Log: Parent sees own child's sessions -->
        <record id="session_log_parent_rule" model="ir.rule">
            <field name="name">Session Log: Parent → Own Child</field>
            <field name="model_id" ref="model_educare_session_log" />
            <field name="domain_force">[('student_id.parent_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('educare_security.group_parent'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <!-- Session Result: Teacher sees own session results -->
        <record id="session_result_teacher_rule" model="ir.rule">
            <field name="name">Session Result: Teacher → Own Sessions</field>
            <field name="model_id" ref="model_educare_session_result" />
            <field name="domain_force">[('session_id.teacher_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('educare_security.group_teacher'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="False" />
        </record>

        <!-- Session Result: Supervisor sees center results -->
        <record id="session_result_supervisor_rule" model="ir.rule">
            <field name="name">Session Result: Supervisor → Center</field>
            <field name="model_id" ref="model_educare_session_result" />
            <field name="domain_force">[('session_id.center_id', 'in',
                user.educare_profile_ids.center_id.ids)]</field>
            <field name="groups" eval="[(4, ref('educare_security.group_supervisor'))]" />
        </record>

        <!-- Session Result: Admin → unrestricted -->
        <record id="session_result_admin_rule" model="ir.rule">
            <field name="name">Session Result: Admin → All</field>
            <field name="model_id" ref="model_educare_session_result" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('educare_security.group_admin'))]" />
        </record>

        <!-- Session Result: Parent sees own child's results -->
        <record id="session_result_parent_rule" model="ir.rule">
            <field name="name">Session Result: Parent → Own Child</field>
            <field name="model_id" ref="model_educare_session_result" />
            <field name="domain_force">[('session_id.student_id.parent_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('educare_security.group_parent'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

    </data>
</odoo>