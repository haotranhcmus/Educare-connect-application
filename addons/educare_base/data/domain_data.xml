<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- 1. Giao tiếp -->
        <record id="domain_communication" model="educare.domain">
            <field name="name">Giao tiếp</field>
            <field name="code">COMM</field>
            <field name="icon">fa-comments</field>
            <field name="color">#E57373</field>
            <field name="sequence">10</field>
            <field name="description">Kỹ năng ngôn ngữ tiếp nhận, diễn đạt, giao tiếp phi ngôn ngữ
                và sử dụng ngôn ngữ trong bối cảnh xã hội.</field>
        </record>

        <!-- 2. Xã hội -->
        <record id="domain_social" model="educare.domain">
            <field name="name">Xã hội</field>
            <field name="code">SOCIAL</field>
            <field name="icon">fa-users</field>
            <field name="color">#FF8A65</field>
            <field name="sequence">20</field>
            <field name="description">Kỹ năng tương tác, xây dựng mối quan hệ, nhận biết cảm xúc và
                phát triển tình bạn.</field>
        </record>

        <!-- 3. Nhận thức -->
        <record id="domain_cognitive" model="educare.domain">
            <field name="name">Nhận thức</field>
            <field name="code">COGNITIVE</field>
            <field name="icon">fa-brain</field>
            <field name="color">#FFD54F</field>
            <field name="sequence">30</field>
            <field name="description">Tư duy, giải quyết vấn đề, trí nhớ, chú ý và khả năng xử lý
                thông tin nhận thức.</field>
        </record>

        <!-- 4. Vận động thô -->
        <record id="domain_motor_gross" model="educare.domain">
            <field name="name">Vận động thô</field>
            <field name="code">MOTOR_GROSS</field>
            <field name="icon">fa-running</field>
            <field name="color">#4FC3F7</field>
            <field name="sequence">40</field>
            <field name="description">Phát triển nhóm cơ lớn: đi, chạy, nhảy, leo trèo, giữ thăng
                bằng và phối hợp cơ thể.</field>
        </record>

        <!-- 5. Vận động tinh -->
        <record id="domain_motor_fine" model="educare.domain">
            <field name="name">Vận động tinh</field>
            <field name="code">MOTOR_FINE</field>
            <field name="icon">fa-hand-paper</field>
            <field name="color">#BA68C8</field>
            <field name="sequence">50</field>
            <field name="description">Phát triển cơ bàn tay và ngón tay: cầm nắm, vẽ, cắt, ghép hình
                và viết.</field>
        </record>

        <!-- 6. Tự phục vụ -->
        <record id="domain_self_care" model="educare.domain">
            <field name="name">Tự phục vụ</field>
            <field name="code">SELF_CARE</field>
            <field name="icon">fa-heart</field>
            <field name="color">#8D6E63</field>
            <field name="sequence">60</field>
            <field name="description">Kỹ năng độc lập trong sinh hoạt hàng ngày: ăn uống, vệ sinh cá
                nhân, mặc đồ và các nếp tự phục vụ.</field>
        </record>

        <!-- 7. Hành vi -->
        <record id="domain_behavior" model="educare.domain">
            <field name="name">Hành vi</field>
            <field name="code">BEHAVIOR</field>
            <field name="icon">fa-chart-line</field>
            <field name="color">#4DB6AC</field>
            <field name="sequence">70</field>
            <field name="description">Điều chỉnh hành vi, kiểm soát cảm xúc, giảm hành vi thách thức
                và xây dựng hành vi tích cực.</field>
        </record>

        <!-- 8. Học tập -->
        <record id="domain_academic" model="educare.domain">
            <field name="name">Học tập</field>
            <field name="code">ACADEMIC</field>
            <field name="icon">fa-graduation-cap</field>
            <field name="color">#42A5F5</field>
            <field name="sequence">80</field>
            <field name="description">Kỹ năng tiền học đường và học đường: đọc, viết, toán và các
                khái niệm học tập nền tảng.</field>
        </record>

        <!-- 9. Thích ứng -->
        <record id="domain_adaptive" model="educare.domain">
            <field name="name">Thích ứng</field>
            <field name="code">ADAPTIVE</field>
            <field name="icon">fa-sync</field>
            <field name="color">#EC407A</field>
            <field name="sequence">90</field>
            <field name="description">Khả năng thích nghi với môi trường mới, chuyển đổi giữa các
                hoạt động và linh hoạt trong thói quen hàng ngày.</field>
        </record>

    </data>
</odoo>