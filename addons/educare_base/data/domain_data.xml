<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- 1. Giao tiep -->
        <record id="domain_communication" model="educare.domain">
            <field name="name">Giao tiep</field>
            <field name="code">COMM</field>
            <field name="icon">fa-comments</field>
            <field name="color">#E57373</field>
            <field name="sequence">10</field>
            <field name="description">Ky nang ngon ngu tiep nhan, dien dat, giao tiep phi ngon ngu va su dung ngon ngu trong boi canh xa hoi.</field>
        </record>

        <!-- 2. Xa hoi -->
        <record id="domain_social" model="educare.domain">
            <field name="name">Xa hoi</field>
            <field name="code">SOCIAL</field>
            <field name="icon">fa-users</field>
            <field name="color">#FF8A65</field>
            <field name="sequence">20</field>
            <field name="description">Ky nang tuong tac, xay dung moi quan he, nhan biet cam xuc va phat trien tinh ban.</field>
        </record>

        <!-- 3. Nhan thuc -->
        <record id="domain_cognitive" model="educare.domain">
            <field name="name">Nhan thuc</field>
            <field name="code">COGNITIVE</field>
            <field name="icon">fa-brain</field>
            <field name="color">#FFD54F</field>
            <field name="sequence">30</field>
            <field name="description">Tu duy, giai quyet van de, tri nho, chu y va kha nang xu ly thong tin nhan thuc.</field>
        </record>

        <!-- 4. Van dong tho -->
        <record id="domain_motor_gross" model="educare.domain">
            <field name="name">Van dong tho</field>
            <field name="code">MOTOR_GROSS</field>
            <field name="icon">fa-running</field>
            <field name="color">#4FC3F7</field>
            <field name="sequence">40</field>
            <field name="description">Phat trien nhom co lon: di, chay, nhay, leo treo, giu thang bang va phoi hop co the.</field>
        </record>

        <!-- 5. Van dong tinh -->
        <record id="domain_motor_fine" model="educare.domain">
            <field name="name">Van dong tinh</field>
            <field name="code">MOTOR_FINE</field>
            <field name="icon">fa-hand-paper</field>
            <field name="color">#BA68C8</field>
            <field name="sequence">50</field>
            <field name="description">Phat trien co ban tay va ngon tay: cam nam, ve, cat, ghep hinh va viet.</field>
        </record>

        <!-- 6. Tu phuc vu -->
        <record id="domain_self_care" model="educare.domain">
            <field name="name">Tu phuc vu</field>
            <field name="code">SELF_CARE</field>
            <field name="icon">fa-heart</field>
            <field name="color">#8D6E63</field>
            <field name="sequence">60</field>
            <field name="description">Ky nang doc lap trong sinh hoat hang ngay: an uong, ve sinh ca nhan, mac do va cac nep tu phuc vu.</field>
        </record>

        <!-- 7. Hanh vi -->
        <record id="domain_behavior" model="educare.domain">
            <field name="name">Hanh vi</field>
            <field name="code">BEHAVIOR</field>
            <field name="icon">fa-chart-line</field>
            <field name="color">#4DB6AC</field>
            <field name="sequence">70</field>
            <field name="description">Dieu chinh hanh vi, kiem soat cam xuc, giam hanh vi thach thuc va xay dung hanh vi tich cuc.</field>
        </record>

        <!-- 8. Hoc tap -->
        <record id="domain_academic" model="educare.domain">
            <field name="name">Hoc tap</field>
            <field name="code">ACADEMIC</field>
            <field name="icon">fa-graduation-cap</field>
            <field name="color">#42A5F5</field>
            <field name="sequence">80</field>
            <field name="description">Ky nang tien hoc duong va hoc duong: doc, viet, toan va cac khai niem hoc tap nen tang.</field>
        </record>

        <!-- 9. Thich ung -->
        <record id="domain_adaptive" model="educare.domain">
            <field name="name">Thich ung</field>
            <field name="code">ADAPTIVE</field>
            <field name="icon">fa-sync</field>
            <field name="color">#EC407A</field>
            <field name="sequence">90</field>
            <field name="description">Kha nang thich nghi voi moi truong moi, chuyen doi giua cac hoat dong va linh hoat trong thoi quen hang ngay.</field>
        </record>

    </data>
</odoo>