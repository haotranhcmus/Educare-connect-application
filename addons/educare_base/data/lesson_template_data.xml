<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             COMMUNICATION DOMAIN TEMPLATES
             ============================================================ -->

        <!-- T-COMM-01: Yeu cau bang loi noi (Manding) -->
        <record id="template_manding_basic" model="educare.lesson.template">
            <field name="name">Yeu cau co ban bang loi noi (Manding)</field>
            <field name="code">T-COMM-01</field>
            <field name="domain_id" ref="domain_communication" />
            <field name="difficulty_level">beginner</field>
            <field name="target_age_min">24</field>
            <field name="target_age_max">60</field>
            <field name="session_duration_mins">30</field>
            <field name="source">vbmapp</field>
            <field name="objectives_text">Tre se yeu cau do vat hoac hoat dong yeu thich bang tu don hoac cum 2 tu trong 8/10 co hoi.</field>
            <field name="materials_needed">Do vat tre yeu thich (do choi, do an nhe), bang lua chon bang tranh, bang token.</field>
            <field name="sequence">10</field>
        </record>

        <record id="activity_manding_1" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_manding_basic" />
            <field name="sequence">10</field>
            <field name="name">Khoi dong - Diem danh va on dinh</field>
            <field name="activity_type">transition</field>
            <field name="duration_mins">5</field>
            <field name="prompt_level_suggested">verbal</field>
            <field name="reinforcement_type">Khen bang loi + token</field>
            <field name="description">Tre chao giao vien va ngoi vao vi tri duoc chi dinh. Diem danh theo ten.</field>
        </record>

        <record id="activity_manding_2" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_manding_basic" />
            <field name="sequence">20</field>
            <field name="name">DTT - Yeu cau do vat yeu thich</field>
            <field name="activity_type">dtt</field>
            <field name="duration_mins">10</field>
            <field name="prompt_level_suggested">gestural</field>
            <field name="reinforcement_type">Cho do vat da yeu cau + khen bang loi</field>
            <field name="description">Dat 2-3 do vat truoc mat tre. Tao dong luc bang cach tri hoan ngan viec cho tre lay do vat. Cho tre tu phat yeu cau. Neu sau 3 giay khong phan hoi thi dung prompt bang loi.</field>
            <field name="data_collection_note">Ghi nhan: Tu phat / Prompt bang loi / Prompt bang cu chi / Khong phan hoi</field>
        </record>

        <record id="activity_manding_3" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_manding_basic" />
            <field name="sequence">30</field>
            <field name="name">NET - Yeu cau trong hoat dong tu nhien</field>
            <field name="activity_type">net</field>
            <field name="duration_mins">10</field>
            <field name="prompt_level_suggested">verbal</field>
            <field name="reinforcement_type">Cho tre tiep can hoat dong da yeu cau</field>
            <field name="description">Trong gio choi tu do, tao tinh huong tu nhien can tre yeu cau (dat do choi ngoai tam voi, giu manh ghep, v.v.).</field>
        </record>

        <!-- T-COMM-02: Goi ten do vat (Tacting) -->
        <record id="template_tacting_objects" model="educare.lesson.template">
            <field name="name">Goi ten do vat quen thuoc (Tacting)</field>
            <field name="code">T-COMM-02</field>
            <field name="domain_id" ref="domain_communication" />
            <field name="difficulty_level">beginner</field>
            <field name="target_age_min">30</field>
            <field name="target_age_max">72</field>
            <field name="session_duration_mins">30</field>
            <field name="source">ablls_r</field>
            <field name="objectives_text">Tre se goi ten it nhat 20 do vat quen thuoc khi xem tranh hoac vat that trong 4/5 lan thu.</field>
            <field name="materials_needed">The tranh do vat hang ngay, vat that (ly, but, giay), phieu ghi du lieu.</field>
            <field name="sequence">20</field>
        </record>

        <record id="activity_tacting_1" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_tacting_objects" />
            <field name="sequence">10</field>
            <field name="name">On tap - Tu vung da hoc</field>
            <field name="activity_type">dtt</field>
            <field name="duration_mins">8</field>
            <field name="prompt_level_suggested">independent</field>
            <field name="reinforcement_type">He thong token</field>
            <field name="description">On 10 the da hoc. Moi lan goi dung duoc 1 token. Doi 5 token lay cuong co yeu thich.</field>
        </record>

        <record id="activity_tacting_2" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_tacting_objects" />
            <field name="sequence">20</field>
            <field name="name">Hoc moi - 3 do vat moi</field>
            <field name="activity_type">dtt</field>
            <field name="duration_mins">12</field>
            <field name="prompt_level_suggested">full_physical</field>
            <field name="reinforcement_type">Khen + token ngay sau phan hoi dung</field>
            <field name="description">Gioi thieu 3 the moi. Dung phuong phap hoc khong loi: dua the va lam mau ngay cach goi ten. Sau 3 lan lap lai, tao do tre 1-2 giay truoc khi prompt.</field>
        </record>

        <!-- ============================================================
             SOCIAL DOMAIN TEMPLATES
             ============================================================ -->

        <!-- T-SOCIAL-01: Luan phien trong tro choi -->
        <record id="template_turn_taking" model="educare.lesson.template">
            <field name="name">Luan phien trong tro choi</field>
            <field name="code">T-SOCIAL-01</field>
            <field name="domain_id" ref="domain_social" />
            <field name="difficulty_level">beginner</field>
            <field name="target_age_min">36</field>
            <field name="target_age_max">84</field>
            <field name="session_duration_mins">45</field>
            <field name="source">original</field>
            <field name="objectives_text">Tre se choi luan phien voi nguoi khac trong tro choi co cau truc ma khong co hanh vi thach thuc, dat 8/10 lan thu.</field>
            <field name="materials_needed">Tro choi ban don gian (Bingo, xuc xac), dong ho cat, the "Den luot con / Den luot co".</field>
            <field name="sequence">10</field>
        </record>

        <record id="activity_turn_1" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_turn_taking" />
            <field name="sequence">10</field>
            <field name="name">Gioi thieu khai niem luan phien</field>
            <field name="activity_type">social</field>
            <field name="duration_mins">10</field>
            <field name="prompt_level_suggested">verbal</field>
            <field name="reinforcement_type">Dap tay + khen bang loi</field>
            <field name="description">Dung the hinh anh de giai thich "Den luot con" va "Den luot co". Luyen voi giao vien truoc khi bat dau tro choi.</field>
        </record>

        <record id="activity_turn_2" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_turn_taking" />
            <field name="sequence">20</field>
            <field name="name">Tro choi luan phien co cau truc</field>
            <field name="activity_type">play</field>
            <field name="duration_mins">20</field>
            <field name="prompt_level_suggested">gestural</field>
            <field name="reinforcement_type">Token cho moi lan luan phien thanh cong</field>
            <field name="description">Choi tro choi ban don gian. Dung dong ho cat de danh dau ro tung luot. Khi tre cho dung cach, khen ngay lap tuc.</field>
            <field name="data_collection_note">Dem so luot thanh cong / tong co hoi. Ghi chu neu co hanh vi thach thuc.</field>
        </record>

        <record id="activity_turn_3" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_turn_taking" />
            <field name="sequence">30</field>
            <field name="name">Ha nhiet va tong ket</field>
            <field name="activity_type">transition</field>
            <field name="duration_mins">5</field>
            <field name="prompt_level_suggested">verbal</field>
            <field name="reinforcement_type">Hoat dong yeu thich trong 5 phut</field>
            <field name="description">Dem so token da dat. Doi token lay cuong co. Tong ket diem tre lam tot.</field>
        </record>

        <!-- ============================================================
             COGNITIVE DOMAIN TEMPLATES
             ============================================================ -->

        <!-- T-COG-01: Phan loai mau sac va hinh dang -->
        <record id="template_sorting_colors" model="educare.lesson.template">
            <field name="name">Phan loai mau sac va hinh dang co ban</field>
            <field name="code">T-COG-01</field>
            <field name="domain_id" ref="domain_cognitive" />
            <field name="difficulty_level">beginner</field>
            <field name="target_age_min">24</field>
            <field name="target_age_max">60</field>
            <field name="session_duration_mins">30</field>
            <field name="source">twinkl</field>
            <field name="objectives_text">Tre se phan loai dung do vat theo mau (do, xanh duong, vang) va hinh dang (tron, vuong, tam giac) trong 9/10 lan thu.</field>
            <field name="materials_needed">Khoi hinh hoc co mau, hop phan loai 3 ngan, the mau, do vat mau thuc te.</field>
            <field name="sequence">10</field>
        </record>

        <record id="activity_sorting_1" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_sorting_colors" />
            <field name="sequence">10</field>
            <field name="name">DTT - Phan loai mau (ghep tuong ung)</field>
            <field name="activity_type">dtt</field>
            <field name="duration_mins">12</field>
            <field name="prompt_level_suggested">partial_physical</field>
            <field name="reinforcement_type">Token cho moi 3 lan phan loai dung</field>
            <field name="description">Dat 3 hop mau (do/xanh duong/vang) va do vat tron lan. Huong dan tre bo moi do vat vao hop dung mau. Bat dau tu 1 mau roi tang dan.</field>
            <field name="data_collection_note">Ty le dung: khong prompt / prompt ho tro mot phan / prompt ho tro toan phan</field>
        </record>

        <record id="activity_sorting_2" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_sorting_colors" />
            <field name="sequence">20</field>
            <field name="name">NET - Phan loai trong hoat dong tu nhien</field>
            <field name="activity_type">net</field>
            <field name="duration_mins">10</field>
            <field name="prompt_level_suggested">gestural</field>
            <field name="reinforcement_type">Khen bang loi + duoc tham gia hoat dong</field>
            <field name="description">Trong luc don do choi, khuyen khich tre bo do choi theo mau vao hop dung. Tan dung co hoi tu nhien, khong qua cung nhac theo cau truc trial.</field>
        </record>

        <!-- ============================================================
             BEHAVIOR DOMAIN TEMPLATES
             ============================================================ -->

        <!-- T-BEH-01: Lam theo huong dan mot buoc -->
        <record id="template_following_instructions" model="educare.lesson.template">
            <field name="name">Lam theo huong dan mot buoc don gian</field>
            <field name="code">T-BEH-01</field>
            <field name="domain_id" ref="domain_behavior" />
            <field name="difficulty_level">beginner</field>
            <field name="target_age_min">18</field>
            <field name="target_age_max">48</field>
            <field name="session_duration_mins">30</field>
            <field name="source">ablls_r</field>
            <field name="objectives_text">Tre se thuc hien lenh mot buoc (ngoi xuong, dung len, dua tay, v.v.) trong vong 5 giay sau lenh, dat 9/10 lan thu.</field>
            <field name="materials_needed">Bang token, danh sach 10 lenh co ban, cuong co yeu thich.</field>
            <field name="sequence">10</field>
        </record>

        <record id="activity_instructions_1" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_following_instructions" />
            <field name="sequence">10</field>
            <field name="name">On tap - Lenh da hoc truoc do</field>
            <field name="activity_type">dtt</field>
            <field name="duration_mins">10</field>
            <field name="prompt_level_suggested">independent</field>
            <field name="reinforcement_type">He thong token (5 token doi cuong co)</field>
            <field name="description">Dung 5 lenh da thanh thao. Xen ke lenh moi theo ti le 3:1 (cu:moi). Giu toc do nhanh de duy tri chu y.</field>
            <field name="data_collection_note">Ghi ty le phan hoi dung trong 3 giay cho tung lenh.</field>
        </record>

        <record id="activity_instructions_2" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_following_instructions" />
            <field name="sequence">20</field>
            <field name="name">Lenh moi - Day hoc khong loi</field>
            <field name="activity_type">dtt</field>
            <field name="duration_mins">15</field>
            <field name="prompt_level_suggested">full_physical</field>
            <field name="reinforcement_type">Cuong co ngay sau moi phan hoi dung</field>
            <field name="description">Gioi thieu 1-2 lenh moi. Dua lenh, cho 0 giay, sau do ho tro toan phan. Giam dan prompt theo Most-to-Least. Dat mastery khi co 3 phan hoi dung lien tiep va doc lap.</field>
        </record>

        <!-- ============================================================
             SELF-CARE DOMAIN TEMPLATES
             ============================================================ -->

        <!-- T-SELF-01: Chuoi rua tay dung quy trinh -->
        <record id="template_handwashing" model="educare.lesson.template">
            <field name="name">Rua tay: Dung chuoi 6 buoc</field>
            <field name="code">T-SELF-01</field>
            <field name="domain_id" ref="domain_self_care" />
            <field name="difficulty_level">intermediate</field>
            <field name="target_age_min">36</field>
            <field name="target_age_max">96</field>
            <field name="session_duration_mins">20</field>
            <field name="source">original</field>
            <field name="objectives_text">Tre se hoan thanh doc lap chuoi rua tay 6 buoc (khong prompt) trong 3 co hoi lien tiep.</field>
            <field name="materials_needed">The phan tich nhiem vu 6 buoc bang hinh anh, xa phong, khan, bang sticker.</field>
            <field name="sequence">10</field>
        </record>

        <record id="activity_handwashing_1" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_handwashing" />
            <field name="sequence">10</field>
            <field name="name">Gioi thieu phan tich nhiem vu rua tay</field>
            <field name="activity_type">academic</field>
            <field name="duration_mins">5</field>
            <field name="prompt_level_suggested">verbal</field>
            <field name="reinforcement_type">Khen bang loi cho moi buoc dung</field>
            <field name="description">On the 6 buoc voi tre: (1) Mo nuoc, (2) Lam uot tay, (3) Xoa xa phong, (4) Cha 20 giay, (5) Xa sach, (6) Lau kho tay. Tre chi vao tung buoc.</field>
        </record>

        <record id="activity_handwashing_2" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_handwashing" />
            <field name="sequence">20</field>
            <field name="name">Thuc hanh rua tay - Backward chaining</field>
            <field name="activity_type">motor</field>
            <field name="duration_mins">10</field>
            <field name="prompt_level_suggested">partial_physical</field>
            <field name="reinforcement_type">Sticker sau khi hoan thanh chuoi</field>
            <field name="description">Dung backward chaining: giao vien lam buoc 1-5, tre lam buoc 6 (lau kho tay). Sau khi thanh thao buoc 6 thi them buoc 5, tiep tuc nhu vay.</field>
            <field name="data_collection_note">Ghi buoc nao can prompt va muc prompt (I/V/G/PP/FP).</field>
        </record>

    </data>
</odoo>