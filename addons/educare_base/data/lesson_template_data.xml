<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             COMMUNICATION DOMAIN TEMPLATES
             ============================================================ -->

        <!-- T-COMM-01: Yêu cầu bằng lời nói (Manding) -->
        <record id="template_manding_basic" model="educare.lesson.template">
            <field name="name">Yêu cầu cơ bản bằng lời nói (Manding)</field>
            <field name="code">T-COMM-01</field>
            <field name="domain_id" ref="domain_communication" />
            <field name="difficulty_level">beginner</field>
            <field name="target_age_min">24</field>
            <field name="target_age_max">60</field>
            <field name="session_duration_mins">30</field>
            <field name="source">vbmapp</field>
            <field name="objectives_text">Trẻ sẽ yêu cầu đồ vật hoặc hoạt động yêu thích bằng từ đơn
                hoặc cụm 2 từ trong 8/10 cơ hội.</field>
            <field name="materials_needed">Đồ vật trẻ yêu thích (đồ chơi, đồ ăn nhẹ), bảng lựa chọn
                bằng tranh, bảng token.</field>
            <field name="sequence">10</field>
        </record>

        <record id="activity_manding_1" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_manding_basic" />
            <field name="sequence">10</field>
            <field name="name">Khởi động - Điểm danh và ổn định</field>
            <field name="activity_type">transition</field>
            <field name="duration_mins">5</field>
            <field name="prompt_level_suggested">verbal</field>
            <field name="reinforcement_type">Khen bằng lời + token</field>
            <field name="description">Trẻ chào giáo viên và ngồi vào vị trí được chỉ định. Điểm danh
                theo tên.</field>
        </record>

        <record id="activity_manding_2" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_manding_basic" />
            <field name="sequence">20</field>
            <field name="name">DTT - Yêu cầu đồ vật yêu thích</field>
            <field name="activity_type">dtt</field>
            <field name="duration_mins">10</field>
            <field name="prompt_level_suggested">gestural</field>
            <field name="reinforcement_type">Cho đồ vật đã yêu cầu + khen bằng lời</field>
            <field name="description">Dạt 2-3 đồ vật trước mặt trẻ. Tạo động lực bằng cách trì hoãn
                ngắn việc cho trẻ lấy đồ vật. Cho trẻ tự phát yêu cầu. Nếu sau 3 giây không phản hồi
                thì dùng prompt bằng lời.</field>
            <field name="data_collection_note">Ghi nhận: Tự phát / Prompt bằng lời / Prompt bằng cử
                chỉ / Không phản hồi</field>
        </record>

        <record id="activity_manding_3" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_manding_basic" />
            <field name="sequence">30</field>
            <field name="name">NET - Yêu cầu trong hoạt động tự nhiên</field>
            <field name="activity_type">net</field>
            <field name="duration_mins">10</field>
            <field name="prompt_level_suggested">verbal</field>
            <field name="reinforcement_type">Cho trẻ tiếp cận hoạt động đã yêu cầu</field>
            <field name="description">Trong giờ chơi tự do, tạo tình huống tự nhiên cần trẻ yêu cầu
                (đặt đồ chơi ngoài tầm với, giữ mảnh ghép, v.v.).</field>
        </record>

        <!-- T-COMM-02: Gọi tên đồ vật (Tacting) -->
        <record id="template_tacting_objects" model="educare.lesson.template">
            <field name="name">Gọi tên đồ vật quen thuộc (Tacting)</field>
            <field name="code">T-COMM-02</field>
            <field name="domain_id" ref="domain_communication" />
            <field name="difficulty_level">beginner</field>
            <field name="target_age_min">30</field>
            <field name="target_age_max">72</field>
            <field name="session_duration_mins">30</field>
            <field name="source">ablls_r</field>
            <field name="objectives_text">Trẻ sẽ gọi tên ít nhất 20 đồ vật quen thuộc khi xem tranh
                hoặc vật thật trong 4/5 lần thử.</field>
            <field name="materials_needed">Thẻ tranh đồ vật hàng ngày, vật thật (ly, bút, giấy),
                phiếu ghi dữ liệu.</field>
            <field name="sequence">20</field>
        </record>

        <record id="activity_tacting_1" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_tacting_objects" />
            <field name="sequence">10</field>
            <field name="name">Ôn tập - Từ vựng đã học</field>
            <field name="activity_type">dtt</field>
            <field name="duration_mins">8</field>
            <field name="prompt_level_suggested">independent</field>
            <field name="reinforcement_type">Hệ thống token</field>
            <field name="description">Ôn 10 thẻ đã học. Mỗi lần gọi đúng được 1 token. Đổi 5 token
                lấy cường cố yêu thích.</field>
        </record>

        <record id="activity_tacting_2" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_tacting_objects" />
            <field name="sequence">20</field>
            <field name="name">Học mới - 3 đồ vật mới</field>
            <field name="activity_type">dtt</field>
            <field name="duration_mins">12</field>
            <field name="prompt_level_suggested">full_physical</field>
            <field name="reinforcement_type">Khen + token ngay sau phản hồi đúng</field>
            <field name="description">Giới thiệu 3 thẻ mới. Dùng phương pháp học không lỗi: đưa thẻ
                và làm mẫu ngay cách gọi tên. Sau 3 lần lặp lại, tạo độ trẻ 1-2 giây trước khi
                prompt.</field>
        </record>

        <!-- ============================================================
             SOCIAL DOMAIN TEMPLATES
             ============================================================ -->

        <!-- T-SOCIAL-01: Luân phiên trong trò chơi -->
        <record id="template_turn_taking" model="educare.lesson.template">
            <field name="name">Luân phiên trong trò chơi</field>
            <field name="code">T-SOCIAL-01</field>
            <field name="domain_id" ref="domain_social" />
            <field name="difficulty_level">beginner</field>
            <field name="target_age_min">36</field>
            <field name="target_age_max">84</field>
            <field name="session_duration_mins">45</field>
            <field name="source">original</field>
            <field name="objectives_text">Trẻ sẽ chơi luân phiên với người khác trong trò chơi có
                cấu trúc mà không có hành vi thách thức, đạt 8/10 lần thử.</field>
            <field name="materials_needed">Trò chơi bàn đơn giản (Bingo, xúc xắc), đồng hồ cát, thẻ
                “Đến lượt con / Đến lượt cô”.</field>
            <field name="sequence">10</field>
        </record>

        <record id="activity_turn_1" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_turn_taking" />
            <field name="sequence">10</field>
            <field name="name">Giới thiệu khái niệm luân phiên</field>
            <field name="activity_type">social</field>
            <field name="duration_mins">10</field>
            <field name="prompt_level_suggested">verbal</field>
            <field name="reinforcement_type">Đập tay + khen bằng lời</field>
            <field name="description">Dùng thẻ hình ảnh để giải thích “Đến lượt con” và “Đến lượt
                cô”. Luyện với giáo viên trước khi bắt đầu trò chơi.</field>
        </record>

        <record id="activity_turn_2" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_turn_taking" />
            <field name="sequence">20</field>
            <field name="name">Trò chơi luân phiên có cấu trúc</field>
            <field name="activity_type">play</field>
            <field name="duration_mins">20</field>
            <field name="prompt_level_suggested">gestural</field>
            <field name="reinforcement_type">Token cho mỗi lần luân phiên thành công</field>
            <field name="description">Chơi trò chơi bàn đơn giản. Dùng đồng hồ cát để đánh dấu rõ
                từng lượt. Khi trẻ chờ đúng cách, khen ngay lập tức.</field>
            <field name="data_collection_note">Đếm số lượt thành công / tổng cơ hội. Ghi chú nếu có
                hành vi thách thức.</field>
        </record>

        <record id="activity_turn_3" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_turn_taking" />
            <field name="sequence">30</field>
            <field name="name">Hạ nhiệt và tổng kết</field>
            <field name="activity_type">transition</field>
            <field name="duration_mins">5</field>
            <field name="prompt_level_suggested">verbal</field>
            <field name="reinforcement_type">Hoạt động yêu thích trong 5 phút</field>
            <field name="description">Đếm số token đã đạt. Đổi token lấy cường cố. Tổng kết điểm trẻ
                làm tốt.</field>
        </record>

        <!-- ============================================================
             COGNITIVE DOMAIN TEMPLATES
             ============================================================ -->

        <!-- T-COG-01: Phân loại màu sắc và hình dạng -->
        <record id="template_sorting_colors" model="educare.lesson.template">
            <field name="name">Phân loại màu sắc và hình dạng cơ bản</field>
            <field name="code">T-COG-01</field>
            <field name="domain_id" ref="domain_cognitive" />
            <field name="difficulty_level">beginner</field>
            <field name="target_age_min">24</field>
            <field name="target_age_max">60</field>
            <field name="session_duration_mins">30</field>
            <field name="source">twinkl</field>
            <field name="objectives_text">Trẻ sẽ phân loại đúng đồ vật theo màu (đỏ, xanh dương,
                vàng) và hình dạng (tròn, vuông, tam giác) trong 9/10 lần thử.</field>
            <field name="materials_needed">Khối hình học có màu, hộp phân loại 3 ngăn, thẻ màu, đồ
                vật màu thực tế.</field>
            <field name="sequence">10</field>
        </record>

        <record id="activity_sorting_1" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_sorting_colors" />
            <field name="sequence">10</field>
            <field name="name">DTT - Phân loại màu (ghép tương ứng)</field>
            <field name="activity_type">dtt</field>
            <field name="duration_mins">12</field>
            <field name="prompt_level_suggested">partial_physical</field>
            <field name="reinforcement_type">Token cho mỗi 3 lần phân loại đúng</field>
            <field name="description">Dạt 3 hộp màu (đỏ/xanh dương/vàng) và đồ vật trộn lẫn. Hướng
                dẫn trẻ bỏ mỗi đồ vật vào hộp đúng màu. Bắt đầu từ 1 màu rồi tăng dần.</field>
            <field name="data_collection_note">Tỷ lệ đúng: không prompt / prompt hỗ trợ một phần /
                prompt hỗ trợ toàn phần</field>
        </record>

        <record id="activity_sorting_2" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_sorting_colors" />
            <field name="sequence">20</field>
            <field name="name">NET - Phân loại trong hoạt động tự nhiên</field>
            <field name="activity_type">net</field>
            <field name="duration_mins">10</field>
            <field name="prompt_level_suggested">gestural</field>
            <field name="reinforcement_type">Khen bằng lời + được tham gia hoạt động</field>
            <field name="description">Trong lúc dọn đồ chơi, khuyến khích trẻ bỏ đồ chơi theo màu
                vào hộp đúng. Tận dụng cơ hội tự nhiên, không quá cứng nhắc theo cấu trúc trial.</field>
        </record>

        <!-- ============================================================
             BEHAVIOR DOMAIN TEMPLATES
             ============================================================ -->

        <!-- T-BEH-01: Làm theo hướng dẫn một bước -->
        <record id="template_following_instructions" model="educare.lesson.template">
            <field name="name">Làm theo hướng dẫn một bước đơn giản</field>
            <field name="code">T-BEH-01</field>
            <field name="domain_id" ref="domain_behavior" />
            <field name="difficulty_level">beginner</field>
            <field name="target_age_min">18</field>
            <field name="target_age_max">48</field>
            <field name="session_duration_mins">30</field>
            <field name="source">ablls_r</field>
            <field name="objectives_text">Trẻ sẽ thực hiện lệnh một bước (ngồi xuống, đứng lên, đưa
                tay, v.v.) trong vòng 5 giây sau lệnh, đạt 9/10 lần thử.</field>
            <field name="materials_needed">Bảng token, danh sách 10 lệnh cơ bản, cường cố yêu thích.</field>
            <field name="sequence">10</field>
        </record>

        <record id="activity_instructions_1" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_following_instructions" />
            <field name="sequence">10</field>
            <field name="name">Ôn tập - Lệnh đã học trước đó</field>
            <field name="activity_type">dtt</field>
            <field name="duration_mins">10</field>
            <field name="prompt_level_suggested">independent</field>
            <field name="reinforcement_type">Hệ thống token (5 token đổi cường cố)</field>
            <field name="description">Dùng 5 lệnh đã thành thạo. Xen kẽ lệnh mới theo tỉ lệ 3:1
                (cũ:mới). Giữ tốc độ nhanh để duy trì chú ý.</field>
            <field name="data_collection_note">Ghi tỷ lệ phản hồi đúng trong 3 giây cho từng lệnh.</field>
        </record>

        <record id="activity_instructions_2" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_following_instructions" />
            <field name="sequence">20</field>
            <field name="name">Lệnh mới - Dạy học không lỗi</field>
            <field name="activity_type">dtt</field>
            <field name="duration_mins">15</field>
            <field name="prompt_level_suggested">full_physical</field>
            <field name="reinforcement_type">Cường cố ngay sau mỗi phản hồi đúng</field>
            <field name="description">Giới thiệu 1-2 lệnh mới. Đưa lệnh, cho 0 giây, sau đó hỗ trợ
                toàn phần. Giảm dần prompt theo Most-to-Least. Đạt mastery khi có 3 phản hồi đúng
                liên tiếp và độc lập.</field>
        </record>

        <!-- ============================================================
             SELF-CARE DOMAIN TEMPLATES
             ============================================================ -->

        <!-- T-SELF-01: Chuỗi rửa tay đúng quy trình -->
        <record id="template_handwashing" model="educare.lesson.template">
            <field name="name">Rửa tay: Đúng chuỗi 6 bước</field>
            <field name="code">T-SELF-01</field>
            <field name="domain_id" ref="domain_self_care" />
            <field name="difficulty_level">intermediate</field>
            <field name="target_age_min">36</field>
            <field name="target_age_max">96</field>
            <field name="session_duration_mins">20</field>
            <field name="source">original</field>
            <field name="objectives_text">Trẻ sẽ hoàn thành độc lập chuỗi rửa tay 6 bước (không
                prompt) trong 3 cơ hội liên tiếp.</field>
            <field name="materials_needed">Thẻ phân tích nhiệm vụ 6 bước bằng hình ảnh, xà phòng,
                khăn, bảng sticker.</field>
            <field name="sequence">10</field>
        </record>

        <record id="activity_handwashing_1" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_handwashing" />
            <field name="sequence">10</field>
            <field name="name">Giới thiệu phân tích nhiệm vụ rửa tay</field>
            <field name="activity_type">academic</field>
            <field name="duration_mins">5</field>
            <field name="prompt_level_suggested">verbal</field>
            <field name="reinforcement_type">Khen bằng lời cho mỗi bước đúng</field>
            <field name="description">Ôn thẻ 6 bước với trẻ: (1) Mở nước, (2) Làm ướt tay, (3) Xóa
                xà phòng, (4) Chà 20 giây, (5) Xả sạch, (6) Lau khô tay. Trẻ chỉ vào từng bước.</field>
        </record>

        <record id="activity_handwashing_2" model="educare.lesson.template.activity">
            <field name="template_id" ref="template_handwashing" />
            <field name="sequence">20</field>
            <field name="name">Thực hành rửa tay - Backward chaining</field>
            <field name="activity_type">motor</field>
            <field name="duration_mins">10</field>
            <field name="prompt_level_suggested">partial_physical</field>
            <field name="reinforcement_type">Sticker sau khi hoàn thành chuỗi</field>
            <field name="description">Dùng backward chaining: giáo viên làm bước 1-5, trẻ làm bước 6
                (lau khô tay). Sau khi thành thạo bước 6 thì thêm bước 5, tiếp tục như vậy.</field>
            <field name="data_collection_note">Ghi bước nào cần prompt và mức prompt (I/V/G/PP/FP).</field>
        </record>

    </data>
</odoo>