<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_center_form" model="ir.ui.view">
            <field name="name">educare.center.form</field>
            <field name="model">educare.center</field>
            <field name="arch" type="xml">
                <form string="Center">
                    <sheet>
                        <field name="active" invisible="1" />
                        <widget name="web_ribbon" text="Archived"
                            bg_color="text-bg-danger"
                            invisible="active" />
                        <div class="oe_button_box" name="button_box" />
                        <div class="d-flex align-items-center mb-3">
                            <field name="logo" widget="image" class="oe_avatar me-3"
                                options="{'preview_image': 'logo', 'size': [90, 90]}" />
                            <div class="flex-grow-1">
                                <h1>
                                    <field name="name" placeholder="Center Name" />
                                </h1>
                            </div>
                        </div>
                        <group>
                            <group string="Basic Information">
                                <field name="code" />
                            </group>
                            <group string="Contact Information">
                                <field name="phone" widget="phone" />
                                <field name="email" widget="email" />
                                <field name="manager_id" />
                            </group>
                        </group>
                        <group>
                            <field name="address" placeholder="Street Address" />
                        </group>
                        <notebook>
                            <page string="Description" name="description">
                                <field name="description" widget="html"
                                    placeholder="Add a description about the center..." nolabel="1" />
                            </page>
                        </notebook>
                    </sheet>

                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <field name="activity_ids" widget="mail_activity" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </field>
        </record>

        <record id="educare_center_tree_view" model="ir.ui.view">
            <field name="name">educare.center.tree</field>
            <field name="model">educare.center</field>
            <field name="arch" type="xml">
                <tree string="List of Centers" decoration-muted="active == False">
                    <field name="active" column_invisible="1" />
                    <field name="code" />
                    <field name="name" />
                    <field name="phone" />
                    <field name="email" />
                    <field name="manager_id" />
                </tree>
            </field>
        </record>

        <record id="educare_center_search_view" model="ir.ui.view">
            <field name="name">educare.center.search</field>
            <field name="model">educare.center</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="code" />
                    <field name="phone" />
                    <field name="email" />

                    <separator />
                    <filter string="Active" name="filter_active" domain="[('active', '=', True)]" />
                    <filter string="Inactive" name="filter_inactive"
                        domain="[('active', '=', False)]" />

                    <group string="Manager">
                        <filter string="Manager" name="group_by_manager"
                            context="{'group_by': 'manager_id'}" />
                    </group>
                </search>
            </field>
        </record>

        <record id="action_educare_center" model="ir.actions.act_window">
            <field name="name">Centers</field>
            <field name="res_model">educare.center</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="educare_center_search_view" />
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No centers found. Click to create your first center.
                </p>
            </field>
        </record>
    </data>
</odoo>