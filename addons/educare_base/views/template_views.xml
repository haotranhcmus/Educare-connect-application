<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="educare_lesson_template_form_view" model="ir.ui.view">
            <field name="name">Educare Lesson Template Form</field>
            <field name="model">educare.lesson.template</field>
            <field name="arch" type="xml">
                <form string="Lesson Template">
                    <sheet>
                        <field name="active" invisible="1" />
                        <widget name="web_ribbon" text="Archived"
                            bg_color="text-bg-danger"
                            invisible="active" />
                        <div class="oe_button_box" name="button_box" />
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Template Name" />
                            </h1>
                            <h2>
                                <field name="code" placeholder="Code" />
                            </h2>
                        </div>
                        <group>
                            <group string="Basic Information">
                                <field name="domain_id" />
                                <field name="difficulty_level" />
                                <field name="session_duration_mins" />
                            </group>
                            <group string="Source Information">
                                <field name="source" />
                                <field name="source_url" widget="url" />
                            </group>
                        </group>

                        <group>
                            <group string="Target Age (months)">
                                <field name="target_age_min" string="From (months)" />
                                <field name="target_age_max" string="To (months)" />
                            </group>
                            <!-- Keep right column empty or add fields if needed -->
                            <group />
                        </group>

                        <notebook>
                            <page string="Activities" name="activities_tab">
                                <field name="activity_line_ids">

                                    <!-- INLINE TREE: show key columns -->
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle" />
                                        <field name="name" />
                                        <field name="activity_type" />
                                        <field name="duration_mins" />
                                        <field name="prompt_level_suggested" />
                                        <field name="reinforcement_type" />
                                    </tree>

                                    <!-- FORM POPUP: opens on row click for detailed edits -->
                                    <form string="Activity Details">
                                        <sheet>
                                            <group>
                                                <group string="Activity Details">
                                                    <field name="sequence" />
                                                    <field name="name" />
                                                    <field name="activity_type" />
                                                    <field name="duration_mins" />
                                                </group>

                                                <group string="Suggested Prompts and Reinforcement">
                                                    <field name="prompt_level_suggested" />
                                                    <field name="reinforcement_type" />
                                                    <field name="data_collection_note" />
                                                </group>
                                            </group>

                                            <group>
                                                <field name="description" string="Description"
                                                    widget="html" />
                                            </group>
                                            <group>
                                                <field name="materials" string="Materials Needed" />
                                            </group>
                                        </sheet>
                                    </form>
                                </field>

                            </page>

                            <page string="Materials" name="materials_tab">
                                <group>
                                    <field name="objectives_text" colspan="2" string="Objectives" />
                                </group>
                                <group>
                                    <field name="materials_needed" colspan="2" string="Materials" />
                                </group>
                            </page>

                            <page string="Notes" name="notes_tab">
                                <group>
                                    <field name="notes" colspan="2" nolabel="1" />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </field>
        </record>

        <record id="educare_lesson_template_tree_view" model="ir.ui.view">
            <field name="name">Educare Lesson Template Tree</field>
            <field name="model">educare.lesson.template</field>
            <field name="arch" type="xml">
                <tree string="Lesson Templates" decoration-muted="active == False">
                    <field name="active" column_invisible="1" />
                    <field name="sequence" widget="handle" />
                    <field name="name" />
                    <field name="code" />
                    <field name="domain_id" />
                    <field name="difficulty_level" />
                    <field name="session_duration_mins" />
                    <field name="source" />
                    <field name="activity_count" string="Activities" optional="show" />
                </tree>
            </field>
        </record>

        <record id="educare_lesson_template_search_view" model="ir.ui.view">
            <field name="name">Educare Lesson Template Search</field>
            <field name="model">educare.lesson.template</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="code" />
                    <field name="domain_id" operator="ilike" />
                    <field name="difficulty_level" />
                    <field name="source" />
                    <separator />

                    <!-- Filter by Difficulty Level -->
                    <filter string="Beginner"
                        name="filter_beginner"
                        domain="[('difficulty_level', '=', 'beginner')]" />
                    <filter string="Intermediate"
                        name="filter_intermediate"
                        domain="[('difficulty_level', '=', 'intermediate')]" />
                    <filter string="Advanced"
                        name="filter_advanced"
                        domain="[('difficulty_level', '=', 'advanced')]" />

                    <!-- Filter by Source -->
                    <filter string="Original" name="filter_original"
                        domain="[('source', '=', 'original')]" />
                    <filter string="Twinkl" name="filter_twinkl"
                        domain="[('source', '=', 'twinkl')]" />
                    <filter string="VB-MAPP" name="filter_vbmapp"
                        domain="[('source', '=', 'vbmapp')]" />
                    <filter string="ABLLS-R" name="filter_ablls_r"
                        domain="[('source', '=', 'ablls_r')]" />
                    <filter string="Autism Helper" name="filter_autism_helper"
                        domain="[('source', '=', 'autism_helper')]" />
                    <filter string="Attainment Company" name="filter_attainment"
                        domain="[('source', '=', 'attainment')]" />
                    <filter string="Other" name="filter_other_source"
                        domain="[('source', '=', 'other')]" />

                    <!-- Group By -->
                    <group string="Group By">
                        <filter string="Domain"
                            name="group_by_domain"
                            context="{'group_by': 'domain_id'}" />
                        <filter string="Difficulty Level"
                            name="group_by_difficulty"
                            context="{'group_by': 'difficulty_level'}" />
                        <filter string="Source"
                            name="group_by_source"
                            context="{'group_by': 'source'}" />
                    </group>
                </search>
            </field>
        </record>

        <!-- ==================== ACTION ==================== -->
        <record id="action_educare_lesson_template" model="ir.actions.act_window">
            <field name="name">Lesson Templates</field>
            <field name="res_model">educare.lesson.template</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="educare_lesson_template_search_view" />
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No lesson templates found. Click to create your first template.
                </p>
            </field>
        </record>
    </data>
</odoo>