#. module: educare_reporting
#: model:mail.template,body_html:educare_reporting.mail_template_daily_report
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>Dear Parent/Guardian of <strong>\n"
"                        <t t-out=\"object.student_id.name\"></t>\n"
"                    </strong>,</p>\n"
"                <p>Here is the session report for <strong>\n"
"                        <t t-out=\"object.report_date\"></t>\n"
"                    </strong>:</p>\n"
"\n"
"                <t t-if=\"object.activity_summary\">\n"
"                    <h3>What did we do today?</h3>\n"
"                    <p>\n"
"                        <t t-out=\"object.activity_summary\"></t>\n"
"                    </p>\n"
"                </t>\n"
"                <t t-if=\"object.achievements\">\n"
"                    <h3>Achievements</h3>\n"
"                    <p>\n"
"                        <t t-out=\"object.achievements\"></t>\n"
"                    </p>\n"
"                </t>\n"
"                <t t-if=\"object.challenges_noted\">\n"
"                    <h3>Areas to keep working on</h3>\n"
"                    <p>\n"
"                        <t t-out=\"object.challenges_noted\"></t>\n"
"                    </p>\n"
"                </t>\n"
"                <t t-if=\"object.highlight_moment\">\n"
"                    <h3>Special moment</h3>\n"
"                    <p>\n"
"                        <t t-out=\"object.highlight_moment\"></t>\n"
"                    </p>\n"
"                </t>\n"
"                <t t-if=\"object.parent_action_guide\">\n"
"                    <h3>What can parents do at home?</h3>\n"
"                    <p>\n"
"                        <t t-out=\"object.parent_action_guide\"></t>\n"
"                    </p>\n"
"                </t>\n"
"                <t t-if=\"object.next_session_preview\">\n"
"                    <h3>Next session preview</h3>\n"
"                    <p>\n"
"                        <t t-out=\"object.next_session_preview\"></t>\n"
"                    </p>\n"
"                </t>\n"
"                <t t-if=\"object.teacher_note\">\n"
"                    <h3>A note from your teacher</h3>\n"
"                    <p>\n"
"                        <t t-out=\"object.teacher_note\"></t>\n"
"                    </p>\n"
"                </t>\n"
"\n"
"                <p>Best regards,<br><t t-out=\"object.teacher_id.name\"></t></p>\n"
"            </div>\n"
"        "
msgstr ""

