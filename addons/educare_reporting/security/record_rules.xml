<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Admin: full access -->
        <record id="rule_daily_report_admin" model="ir.rule">
            <field name="name">Daily Report: Admin Full Access</field>
            <field name="model_id" ref="model_educare_daily_report" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('educare_security.group_admin'))]" />
        </record>

        <!-- Supervisor: reports for students in their center(s) -->
        <record id="rule_daily_report_supervisor" model="ir.rule">
            <field name="name">Daily Report: Supervisor Center Access</field>
            <field name="model_id" ref="model_educare_daily_report" />
            <field name="domain_force">[('center_id', 'in', user.educare_profile_ids.center_id.ids)]</field>
            <field name="groups" eval="[(4, ref('educare_security.group_supervisor'))]" />
        </record>

        <!-- Teacher: own reports only -->
        <record id="rule_daily_report_teacher" model="ir.rule">
            <field name="name">Daily Report: Teacher Own Reports</field>
            <field name="model_id" ref="model_educare_daily_report" />
            <field name="domain_force">[('teacher_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('educare_security.group_teacher'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="False" />
        </record>

        <!-- Parent: read own child's sent/read reports only -->
        <record id="rule_daily_report_parent" model="ir.rule">
            <field name="name">Daily Report: Parent Own Child</field>
            <field name="model_id" ref="model_educare_daily_report" />
            <field name="domain_force">[('student_id.parent_user_id', '=', user.id), ('status',
                'in', ['sent', 'read'])]</field>
            <field name="groups" eval="[(4, ref('educare_security.group_parent'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

    </data>
</odoo>