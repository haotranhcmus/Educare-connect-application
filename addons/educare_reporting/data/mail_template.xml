<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="0">
    <record id="mail_template_daily_report" model="mail.template">
        <field name="name">Bao cao hang ngay gui phu huynh</field>
        <field name="model_id" ref="model_educare_daily_report" />
        <field name="subject">Bao cao buoi hoc: {{ object.student_id.name or '' }} -
            {{ object.report_date or '' }}</field>
        <field name="email_from">{{ (object.teacher_id.email or '') }}</field>
        <field name="email_to">{{ (object.student_id.parent_user_id.email or '') }}</field>
        <field name="body_html" type="html">
            <div
                style="margin:0; padding:24px 0; background-color:#f4f6fb; font-family:Arial, Helvetica, sans-serif; color:#1f2937;">
                <div
                    style="max-width:680px; margin:0 auto; background:#ffffff; border:1px solid #e5e7eb; border-radius:12px; overflow:hidden;">
                    <div style="background:#4f46e5; padding:20px 24px; color:black;">
                        <div style="font-size:18px; font-weight:700; line-height:1.4;">Bao cao buoi
                            hoc hang ngay</div>
                        <div style="font-size:13px; opacity:0.95; margin-top:4px;"> Hoc sinh: <strong>
                                <t t-out="object.student_id.name" />
                            </strong>
                            | Ngay bao cao: <strong>
                                <t t-out="object.report_date" />
                            </strong>
                        </div>
                    </div>

                    <div style="padding:24px; line-height:1.65; font-size:15px;">
                        <p style="margin:0 0 14px 0;">Kinh gui Phu huynh/Nguoi giam ho cua <strong>
                                <t t-out="object.student_id.name" />
                            </strong>
                            ,</p>
                        <p style="margin:0 0 18px 0; color:#374151;">Duoi day la tom tat buoi hoc
                            ngay <strong>
                                <t t-out="object.report_date" />
                            </strong>
                            .</p>

                        <t t-if="object.activity_summary">
                            <div
                                style="margin:0 0 12px 0; padding:14px 16px; background:#f9fafb; border-left:4px solid #4f46e5; border-radius:8px;">
                                <div
                                    style="font-size:15px; font-weight:700; margin:0 0 6px 0; color:#111827;">Hom
                                    nay be da hoc gi?</div>
                                <div style="margin:0; color:#374151;">
                                    <t t-out="object.activity_summary" />
                                </div>
                            </div>
                        </t>

                        <t t-if="object.achievements">
                            <div
                                style="margin:0 0 12px 0; padding:14px 16px; background:#f0fdf4; border-left:4px solid #16a34a; border-radius:8px;">
                                <div
                                    style="font-size:15px; font-weight:700; margin:0 0 6px 0; color:#14532d;">Thanh
                                    tuu dat duoc</div>
                                <div style="margin:0; color:#166534;">
                                    <t t-out="object.achievements" />
                                </div>
                            </div>
                        </t>

                        <t t-if="object.challenges_noted">
                            <div
                                style="margin:0 0 12px 0; padding:14px 16px; background:#fff7ed; border-left:4px solid #ea580c; border-radius:8px;">
                                <div
                                    style="font-size:15px; font-weight:700; margin:0 0 6px 0; color:#9a3412;">Noi
                                    dung can tiep tuc ren luyen</div>
                                <div style="margin:0; color:#9a3412;">
                                    <t t-out="object.challenges_noted" />
                                </div>
                            </div>
                        </t>

                        <t t-if="object.highlight_moment">
                            <div
                                style="margin:0 0 12px 0; padding:14px 16px; background:#eff6ff; border-left:4px solid #2563eb; border-radius:8px;">
                                <div
                                    style="font-size:15px; font-weight:700; margin:0 0 6px 0; color:#1e3a8a;">Khoanh
                                    khac dang nho</div>
                                <div style="margin:0; color:#1e40af;">
                                    <t t-out="object.highlight_moment" />
                                </div>
                            </div>
                        </t>

                        <t t-if="object.parent_action_guide">
                            <div
                                style="margin:0 0 12px 0; padding:14px 16px; background:#f5f3ff; border-left:4px solid #7c3aed; border-radius:8px;">
                                <div
                                    style="font-size:15px; font-weight:700; margin:0 0 6px 0; color:#4c1d95;">Phu
                                    huynh co the ho tro tai nha nhu the nao?</div>
                                <div style="margin:0; color:#5b21b6;">
                                    <t t-out="object.parent_action_guide" />
                                </div>
                            </div>
                        </t>

                        <t t-if="object.next_session_preview">
                            <div
                                style="margin:0 0 12px 0; padding:14px 16px; background:#ecfeff; border-left:4px solid #0891b2; border-radius:8px;">
                                <div
                                    style="font-size:15px; font-weight:700; margin:0 0 6px 0; color:#0e7490;">Du
                                    kien buoi hoc tiep theo</div>
                                <div style="margin:0; color:#155e75;">
                                    <t t-out="object.next_session_preview" />
                                </div>
                            </div>
                        </t>

                        <t t-if="object.teacher_note">
                            <div
                                style="margin:0 0 18px 0; padding:14px 16px; background:#f8fafc; border-left:4px solid #64748b; border-radius:8px;">
                                <div
                                    style="font-size:15px; font-weight:700; margin:0 0 6px 0; color:#334155;">Loi
                                    nhan tu giao vien</div>
                                <div style="margin:0; color:#475569;">
                                    <t t-out="object.teacher_note" />
                                </div>
                            </div>
                        </t>

                        <p style="margin:18px 0 0 0;">Tran trong,</p>
                        <p style="margin:2px 0 0 0; font-weight:700;">
                            <t t-out="object.teacher_id.name" />
                        </p>
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>