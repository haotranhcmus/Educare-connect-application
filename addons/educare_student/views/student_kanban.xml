<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_educare_student_kanban" model="ir.ui.view">
        <field name="name">educare.student.kanban</field>
        <field name="model">educare.student</field>
        <field name="arch" type="xml">
            <kanban default_group_by="primary_diagnosis"
                class="o_kanban_small_column"
                quick_create="0">
                <field name="name" />
                <field name="student_code" />
                <field name="avatar" />
                <field name="primary_diagnosis" />
                <field name="assigned_teacher_id" />
                <field name="status" />
                <field name="medical_alert" />
                <field name="age" />
                <templates>
                    <t t-name="kanban-box">
                        <div
                            t-attf-class="oe_kanban_card oe_kanban_global_click
                                           #{record.medical_alert.raw_value ? 'text-danger border-danger' : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name" />
                                        </strong>
                                        <span class="o_kanban_record_subtitle text-muted">
                                            <field name="student_code" />
                                        </span>
                                    </div>
                                    <div class="o_kanban_image">
                                        <img
                                            t-att-src="kanban_image('educare.student', 'avatar', record.id.raw_value)"
                                            class="o_image_64_cover"
                                            alt="Avatar" />
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <strong>Diagnosis:</strong>
                                        <field name="primary_diagnosis" />
                                    </div>
                                    <div>
                                        <strong>Teacher:</strong>
                                        <field name="assigned_teacher_id" />
                                    </div>
                                    <div>
                                        <strong>Age:</strong>
                                        <field name="age" /> years </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span t-if="record.medical_alert.raw_value"
                                            class="badge text-bg-danger">
                                            Medical
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>