<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ══ ASSESSMENT: Form View ══ -->
        <record id="view_educare_assessment_form" model="ir.ui.view">
            <field name="name">educare.assessment.form</field>
            <field name="model">educare.assessment</field>
            <field name="arch" type="xml">
                <form string="Assessment Record">
                    <sheet>
                        <group>
                            <group string="Assessment Information">
                                <field name="student_id" />
                                <field name="assessment_date" />
                                <field name="assessment_type" />
                                <field name="assessor_id" />
                            </group>
                            <group string="Results">
                                <field name="vbmapp_score" />
                                <field name="ablls_score" />
                                <field name="overall_progress"
                                    invisible="assessment_type == 'initial'"
                                    required="assessment_type != 'initial'" />
                                <field name="classification" />
                            </group>
                        </group>
                        <field name="notes" placeholder="General notes..." />
                        <notebook>
                            <page string="Strengths / Limitations Assessment" name="detail_lines">
                                <field name="line_ids">
                                    <tree string="Assessment Details" editable="bottom">
                                        <field name="domain_color" column_invisible="1" />
                                        <field name="domain_id" string="Domain"
                                            widget="domain_color_badge"
                                            options='{"color_field": "domain_color"}'
                                            optional="show" />
                                        <field name="item_id" string="Criterion" />
                                        <field name="strength_text" string="Strength"
                                            placeholder="Describe strengths..." />
                                        <field name="limitation_text" string="Limitation / Challenge"
                                            placeholder="Describe limitations..." />
                                        <field name="notes" string="Notes"
                                            placeholder="Additional notes..." optional="hide" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </field>
        </record>

        <!-- ══ ASSESSMENT: Tree View ══ -->
        <record id="view_educare_assessment_tree" model="ir.ui.view">
            <field name="name">educare.assessment.tree</field>
            <field name="model">educare.assessment</field>
            <field name="arch" type="xml">
                <tree string="Assessment Records"
                    default_order="assessment_date desc">
                    <field name="student_id" />
                    <field name="assessment_date" />
                    <field name="assessment_type" />
                    <field name="assessor_id" />
                    <field name="vbmapp_score" />
                    <field name="ablls_score" />
                    <field name="overall_progress" />
                    <field name="classification" />
                </tree>
            </field>
        </record>

    </data>
</odoo>