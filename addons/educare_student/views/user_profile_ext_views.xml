<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!--
            Inherits educare.user.profile form view (from educare_security).
            At this stage student_ids has been overridden to educare.student
            in user_profile_ext.py, so center_id is valid here.
        -->
        <record id="educare_user_profile_form_student_ext" model="ir.ui.view">
            <field name="name">Educare User Profile Form (student ext)</field>
            <field name="model">educare.user.profile</field>
            <field name="inherit_id" ref="educare_security.educare_user_profile_form_view" />
            <field name="arch" type="xml">
                <!-- Add center_id column to the student list in the Parent tab -->
                <xpath expr="//field[@name='student_ids']//tree//field[@name='name']"
                    position="after">
                    <field name="center_id" string="Center" />
                </xpath>
            </field>
        </record>

    </data>
</odoo>