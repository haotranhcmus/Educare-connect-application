<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- ══ COMMUNICATION (COMM) ══ -->
        <record id="assess_item_comm_receptive" model="educare.assessment.item">
            <field name="name">Ngon ngu tiep nhan</field>
            <field name="domain_id" ref="educare_base.domain_communication" />
            <field name="sequence">10</field>
            <field name="description">Kha nang hieu ngon ngu noi, lam theo huong dan va nhan biet tu vung.</field>
        </record>
        <record id="assess_item_comm_expressive" model="educare.assessment.item">
            <field name="name">Ngon ngu dien dat</field>
            <field name="domain_id" ref="educare_base.domain_communication" />
            <field name="sequence">20</field>
            <field name="description">Kha nang su dung ngon ngu de yeu cau, mo ta va ke lai.</field>
        </record>
        <record id="assess_item_comm_nonverbal" model="educare.assessment.item">
            <field name="name">Giao tiep phi ngon ngu</field>
            <field name="domain_id" ref="educare_base.domain_communication" />
            <field name="sequence">30</field>
            <field name="description">Su dung giao tiep mat, cu chi va bieu cam khuon mat trong giao tiep.</field>
        </record>

        <!-- ══ SOCIAL ══ -->
        <record id="assess_item_social_peer" model="educare.assessment.item">
            <field name="name">Tuong tac ban be</field>
            <field name="domain_id" ref="educare_base.domain_social" />
            <field name="sequence">10</field>
            <field name="description">Kha nang chu dong va duy tri tuong tac voi ban dong trang lua.</field>
        </record>
        <record id="assess_item_social_emotion" model="educare.assessment.item">
            <field name="name">Nhan biet cam xuc</field>
            <field name="domain_id" ref="educare_base.domain_social" />
            <field name="sequence">20</field>
            <field name="description">Nhan biet va phan hoi phu hop voi cam xuc cua ban than va nguoi khac.</field>
        </record>
        <record id="assess_item_social_play" model="educare.assessment.item">
            <field name="name">Ky nang choi</field>
            <field name="domain_id" ref="educare_base.domain_social" />
            <field name="sequence">30</field>
            <field name="description">Choi tuong tuong, choi theo luat va choi hop tac voi ban be.</field>
        </record>

        <!-- ══ COGNITIVE ══ -->
        <record id="assess_item_cognitive_attention" model="educare.assessment.item">
            <field name="name">Chu y</field>
            <field name="domain_id" ref="educare_base.domain_cognitive" />
            <field name="sequence">10</field>
            <field name="description">Kha nang tap trung va duy tri chu y vao nhiem vu.</field>
        </record>
        <record id="assess_item_cognitive_memory" model="educare.assessment.item">
            <field name="name">Tri nho</field>
            <field name="domain_id" ref="educare_base.domain_cognitive" />
            <field name="sequence">20</field>
            <field name="description">Tri nho ngan han va dai han, kha nang nho trinh tu va thong tin.</field>
        </record>
        <record id="assess_item_cognitive_problem_solving" model="educare.assessment.item">
            <field name="name">Giai quyet van de</field>
            <field name="domain_id" ref="educare_base.domain_cognitive" />
            <field name="sequence">30</field>
            <field name="description">Kha nang phan tich tinh huong, tim giai phap va thu-sai de hoc.</field>
        </record>
        <record id="assess_item_cognitive_categorize" model="educare.assessment.item">
            <field name="name">Phan loai</field>
            <field name="domain_id" ref="educare_base.domain_cognitive" />
            <field name="sequence">40</field>
            <field name="description">Nhom do vat, so sanh dac diem va nhan ra quy luat.</field>
        </record>

        <!-- ══ GROSS MOTOR ══ -->
        <record id="assess_item_motor_gross_locomotion" model="educare.assessment.item">
            <field name="name">Van dong tho</field>
            <field name="domain_id" ref="educare_base.domain_motor_gross" />
            <field name="sequence">10</field>
            <field name="description">Di, chay, nhay, leo treo va van dong toan than.</field>
        </record>
        <record id="assess_item_motor_gross_balance" model="educare.assessment.item">
            <field name="name">Thang bang</field>
            <field name="domain_id" ref="educare_base.domain_motor_gross" />
            <field name="sequence">20</field>
            <field name="description">Kha nang giu thang bang khi dung, di tren duong hep va dung mot chan.</field>
        </record>
        <record id="assess_item_motor_gross_coordination" model="educare.assessment.item">
            <field name="name">Phoi hop co the</field>
            <field name="domain_id" ref="educare_base.domain_motor_gross" />
            <field name="sequence">30</field>
            <field name="description">Phoi hop tay-chan, bat va da bong, van dong theo nhip.</field>
        </record>

        <!-- ══ FINE MOTOR ══ -->
        <record id="assess_item_motor_fine_grasp" model="educare.assessment.item">
            <field name="name">Cam nam va viet</field>
            <field name="domain_id" ref="educare_base.domain_motor_fine" />
            <field name="sequence">10</field>
            <field name="description">Cam but, viet, ve hinh va ky nang tien viet.</field>
        </record>
        <record id="assess_item_motor_fine_cutting" model="educare.assessment.item">
            <field name="name">Cat va ghep hinh</field>
            <field name="domain_id" ref="educare_base.domain_motor_fine" />
            <field name="sequence">20</field>
            <field name="description">Su dung keo, ghep hinh, xau hat va thao tac do vat nho.</field>
        </record>
        <record id="assess_item_motor_fine_hand_eye" model="educare.assessment.item">
            <field name="name">Phoi hop tay-mat</field>
            <field name="domain_id" ref="educare_base.domain_motor_fine" />
            <field name="sequence">30</field>
            <field name="description">To mau trong vien, noi diem va thao tac do vat nho.</field>
        </record>

        <!-- ══ SELF-CARE ══ -->
        <record id="assess_item_self_care_eating" model="educare.assessment.item">
            <field name="name">An uong</field>
            <field name="domain_id" ref="educare_base.domain_self_care" />
            <field name="sequence">10</field>
            <field name="description">Tu an, su dung dung cu an, uong nuoc va thoi quen an uong.</field>
        </record>
        <record id="assess_item_self_care_hygiene" model="educare.assessment.item">
            <field name="name">Ve sinh ca nhan</field>
            <field name="domain_id" ref="educare_base.domain_self_care" />
            <field name="sequence">20</field>
            <field name="description">Rua tay, danh rang, di ve sinh va rua mat.</field>
        </record>
        <record id="assess_item_self_care_dressing" model="educare.assessment.item">
            <field name="name">Mac do</field>
            <field name="domain_id" ref="educare_base.domain_self_care" />
            <field name="sequence">30</field>
            <field name="description">Tu mac va thay do, cai nut, keo khoa va mang giay.</field>
        </record>

        <!-- ══ BEHAVIOR ══ -->
        <record id="assess_item_behavior_emotion_control" model="educare.assessment.item">
            <field name="name">Dieu chinh cam xuc</field>
            <field name="domain_id" ref="educare_base.domain_behavior" />
            <field name="sequence">10</field>
            <field name="description">Quan ly cam xuc, giu binh tinh khi uc che va tu dieu chinh.</field>
        </record>
        <record id="assess_item_behavior_compliance" model="educare.assessment.item">
            <field name="name">Tuan thu quy tac</field>
            <field name="domain_id" ref="educare_base.domain_behavior" />
            <field name="sequence">20</field>
            <field name="description">Lam theo huong dan, cho den luot va chap nhan chuyen doi hoat dong.</field>
        </record>
        <record id="assess_item_behavior_challenging" model="educare.assessment.item">
            <field name="name">Giam hanh vi thach thuc</field>
            <field name="domain_id" ref="educare_base.domain_behavior" />
            <field name="sequence">30</field>
            <field name="description">Giam tu gay thuong tich, hanh vi tan cong, la het va hanh vi lap lai.</field>
        </record>

    </data>
</odoo>