<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- ══ COMMUNICATION (COMM) ══ -->
        <record id="assess_item_comm_receptive" model="educare.assessment.item">
            <field name="name">Ngôn ngữ tiếp nhận</field>
            <field name="domain_id" ref="educare_base.domain_communication" />
            <field name="sequence">10</field>
            <field name="description">Khả năng hiểu ngôn ngữ nói, làm theo hướng dẫn và nhận biết từ
                vựng.</field>
        </record>
        <record id="assess_item_comm_expressive" model="educare.assessment.item">
            <field name="name">Ngôn ngữ diễn đạt</field>
            <field name="domain_id" ref="educare_base.domain_communication" />
            <field name="sequence">20</field>
            <field name="description">Khả năng sử dụng ngôn ngữ để yêu cầu, mô tả và kể lại.</field>
        </record>
        <record id="assess_item_comm_nonverbal" model="educare.assessment.item">
            <field name="name">Giao tiếp phi ngôn ngữ</field>
            <field name="domain_id" ref="educare_base.domain_communication" />
            <field name="sequence">30</field>
            <field name="description">Sử dụng giao tiếp mắt, cử chỉ và biểu cảm khuôn mặt trong giao
                tiếp.</field>
        </record>

        <!-- ══ SOCIAL ══ -->
        <record id="assess_item_social_peer" model="educare.assessment.item">
            <field name="name">Tương tác bạn bè</field>
            <field name="domain_id" ref="educare_base.domain_social" />
            <field name="sequence">10</field>
            <field name="description">Khả năng chủ động và duy trì tương tác với bạn đồng trang lứa.</field>
        </record>
        <record id="assess_item_social_emotion" model="educare.assessment.item">
            <field name="name">Nhận biết cảm xúc</field>
            <field name="domain_id" ref="educare_base.domain_social" />
            <field name="sequence">20</field>
            <field name="description">Nhận biết và phản hồi phù hợp với cảm xúc của bản thân và
                người khác.</field>
        </record>
        <record id="assess_item_social_play" model="educare.assessment.item">
            <field name="name">Kỹ năng chơi</field>
            <field name="domain_id" ref="educare_base.domain_social" />
            <field name="sequence">30</field>
            <field name="description">Chơi tướng tượng, chơi theo luật và chơi hợp tác với bạn bè.</field>
        </record>

        <!-- ══ COGNITIVE ══ -->
        <record id="assess_item_cognitive_attention" model="educare.assessment.item">
            <field name="name">Chú ý</field>
            <field name="domain_id" ref="educare_base.domain_cognitive" />
            <field name="sequence">10</field>
            <field name="description">Khả năng tập trung và duy trì chú ý vào nhiệm vụ.</field>
        </record>
        <record id="assess_item_cognitive_memory" model="educare.assessment.item">
            <field name="name">Trí nhớ</field>
            <field name="domain_id" ref="educare_base.domain_cognitive" />
            <field name="sequence">20</field>
            <field name="description">Trí nhớ ngắn hạn và dài hạn, khả năng nhớ trình tự và thông
                tin.</field>
        </record>
        <record id="assess_item_cognitive_problem_solving" model="educare.assessment.item">
            <field name="name">Giải quyết vấn đề</field>
            <field name="domain_id" ref="educare_base.domain_cognitive" />
            <field name="sequence">30</field>
            <field name="description">Khả năng phân tích tình huống, tìm giải pháp và thử-sai để
                học.</field>
        </record>
        <record id="assess_item_cognitive_categorize" model="educare.assessment.item">
            <field name="name">Phân loại</field>
            <field name="domain_id" ref="educare_base.domain_cognitive" />
            <field name="sequence">40</field>
            <field name="description">Nhóm đồ vật, so sánh đặc điểm và nhận ra quy luật.</field>
        </record>

        <!-- ══ GROSS MOTOR ══ -->
        <record id="assess_item_motor_gross_locomotion" model="educare.assessment.item">
            <field name="name">Vận động thô</field>
            <field name="domain_id" ref="educare_base.domain_motor_gross" />
            <field name="sequence">10</field>
            <field name="description">Đi, chạy, nhảy, leo trèo và vận động toàn thân.</field>
        </record>
        <record id="assess_item_motor_gross_balance" model="educare.assessment.item">
            <field name="name">Thăng bằng</field>
            <field name="domain_id" ref="educare_base.domain_motor_gross" />
            <field name="sequence">20</field>
            <field name="description">Khả năng giữ thăng bằng khi đứng, đi trên đường hẹp và đứng
                một chân.</field>
        </record>
        <record id="assess_item_motor_gross_coordination" model="educare.assessment.item">
            <field name="name">Phối hợp cơ thể</field>
            <field name="domain_id" ref="educare_base.domain_motor_gross" />
            <field name="sequence">30</field>
            <field name="description">Phối hợp tay-chân, bắt và đá bóng, vận động theo nhịp.</field>
        </record>

        <!-- ══ FINE MOTOR ══ -->
        <record id="assess_item_motor_fine_grasp" model="educare.assessment.item">
            <field name="name">Cầm nắm và viết</field>
            <field name="domain_id" ref="educare_base.domain_motor_fine" />
            <field name="sequence">10</field>
            <field name="description">Cầm bút, viết, vẽ hình và kỹ năng tiền viết.</field>
        </record>
        <record id="assess_item_motor_fine_cutting" model="educare.assessment.item">
            <field name="name">Cắt và ghép hình</field>
            <field name="domain_id" ref="educare_base.domain_motor_fine" />
            <field name="sequence">20</field>
            <field name="description">Sử dụng kéo, ghép hình, xâu hạt và thao tác đồ vật nhỏ.</field>
        </record>
        <record id="assess_item_motor_fine_hand_eye" model="educare.assessment.item">
            <field name="name">Phối hợp tay-mắt</field>
            <field name="domain_id" ref="educare_base.domain_motor_fine" />
            <field name="sequence">30</field>
            <field name="description">Tô màu trong viền, nối điểm và thao tác đồ vật nhỏ.</field>
        </record>

        <!-- ══ SELF-CARE ══ -->
        <record id="assess_item_self_care_eating" model="educare.assessment.item">
            <field name="name">Ăn uống</field>
            <field name="domain_id" ref="educare_base.domain_self_care" />
            <field name="sequence">10</field>
            <field name="description">Tự ăn, sử dụng dụng cụ ăn, uống nước và thói quen ăn uống.</field>
        </record>
        <record id="assess_item_self_care_hygiene" model="educare.assessment.item">
            <field name="name">Vệ sinh cá nhân</field>
            <field name="domain_id" ref="educare_base.domain_self_care" />
            <field name="sequence">20</field>
            <field name="description">Rửa tay, đánh răng, đi vệ sinh và rửa mặt.</field>
        </record>
        <record id="assess_item_self_care_dressing" model="educare.assessment.item">
            <field name="name">Mặc đồ</field>
            <field name="domain_id" ref="educare_base.domain_self_care" />
            <field name="sequence">30</field>
            <field name="description">Tự mặc và thay đồ, cài nút, kéo khóa và mang giày.</field>
        </record>

        <!-- ══ BEHAVIOR ══ -->
        <record id="assess_item_behavior_emotion_control" model="educare.assessment.item">
            <field name="name">Điều chỉnh cảm xúc</field>
            <field name="domain_id" ref="educare_base.domain_behavior" />
            <field name="sequence">10</field>
            <field name="description">Quản lý cảm xúc, giữ bình tĩnh khi ức chế và tự điều chỉnh.</field>
        </record>
        <record id="assess_item_behavior_compliance" model="educare.assessment.item">
            <field name="name">Tuân thủ quy tắc</field>
            <field name="domain_id" ref="educare_base.domain_behavior" />
            <field name="sequence">20</field>
            <field name="description">Làm theo hướng dẫn, chờ đến lượt và chấp nhận chuyển đổi hoạt
                động.</field>
        </record>
        <record id="assess_item_behavior_challenging" model="educare.assessment.item">
            <field name="name">Giảm hành vi thách thức</field>
            <field name="domain_id" ref="educare_base.domain_behavior" />
            <field name="sequence">30</field>
            <field name="description">Giảm tự gây thương tích, hành vi tấn công, la hét và hành vi
                lặp lại.</field>
        </record>

    </data>
</odoo>