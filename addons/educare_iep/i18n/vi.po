"                        <span class=\"badge text-bg-secondary\" invisible=\"supervisor_approved\">\n"
"                            <i class=\"fa fa-hourglass-half me-1\"/>Giám sát viên đã duyệt </span>\n"
"                        <span class=\"badge text-bg-success\" invisible=\"status == 'draft' or not parent_consent\">\n"
