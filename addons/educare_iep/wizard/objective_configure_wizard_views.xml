<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form view for each wizard line (opens as nested dialog when clicked) -->
    <record id="view_educare_iep_objective_configure_wizard_line_form" model="ir.ui.view">
        <field name="name">educare.iep.objective.configure.wizard.line.form</field>
        <field name="model">educare.iep.objective.configure.wizard.line</field>
        <field name="arch" type="xml">
            <form string="Configure Objective">
                <sheet>
                    <div class="alert alert-secondary d-flex align-items-center gap-2 mb-3 py-2"
                        role="alert">
                        <i class="fa fa-list-alt fa-lg" />
                        <span>
                            <strong>Objective:</strong>
                            <field name="name" readonly="1" nolabel="1" class="ms-1 fw-semibold" />
                        </span>
                    </div>

                    <notebook>
                        <!-- Tab 1: Editable configuration -->
                        <page string="Configure" name="configure">
                            <group>
                                <field name="measurement_type" />
                            </group>
                            <group string="Accuracy Targets"
                                invisible="measurement_type not in ('accuracy','prompt_level')">
                                <field name="baseline_accuracy_pct" />
                                <field name="target_accuracy_pct" />
                            </group>
                            <group string="Duration Target"
                                invisible="measurement_type != 'duration'">
                                <field name="target_duration_seconds" />
                            </group>
                            <group string="Frequency Targets"
                                invisible="measurement_type not in ('frequency_increase','frequency_decrease')">
                                <field name="baseline_count" />
                                <field name="target_count" />
                            </group>
                            <group string="Mastery Criteria">
                                <field name="consecutive_sessions_required" />
                                <field name="difficulty_id" readonly="1" />
                                <field name="weight" readonly="1" />
                                <field name="measurement_template_id" />
                            </group>
                        </page>

                        <!-- Tab 2: SMART info read from template (readonly preview) -->
                        <page string="SMART (từ template)" name="smart_preview">
                            <group>
                                <field name="smart_specific" readonly="1"
                                    placeholder="(chưa có trong template)" />
                                <field name="smart_measurable" readonly="1"
                                    placeholder="(chưa có trong template)" />
                                <field name="smart_analysis" readonly="1"
                                    placeholder="(chưa có trong template)" />
                                <field name="smart_timebound" readonly="1"
                                    placeholder="(chưa có trong template)" />
                            </group>
                        </page>

                        <!-- Tab 3: Guidance info read from template (readonly preview) -->
                        <page string="Guidance (từ template)" name="guidance_preview">
                            <div class="text-muted small mb-3">
                                <i class="fa fa-info-circle me-1" /> Thông tin hướng dẫn được đọc từ objective template và sẽ được copy sang objective khi import. </div>
                            <group string="Độ khó &amp; Đối tượng">
                                <field name="difficulty_id" readonly="1" />
                                <field name="age_min_months" readonly="1" />
                                <field name="age_max_months" readonly="1" />
                                <field name="suggested_prompt_level" readonly="1" />
                            </group>
                            <group string="Vật liệu &amp; Hướng dẫn" col="1">
                                <field name="materials_needed" readonly="1"
                                    placeholder="(chưa có trong template)" />
                                <field name="implementation_steps" readonly="1"
                                    placeholder="(chưa có trong template)" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Main wizard form -->
    <record id="view_educare_iep_objective_configure_wizard_form" model="ir.ui.view">
        <field name="name">educare.iep.objective.configure.wizard.form</field>
        <field name="model">educare.iep.objective.configure.wizard</field>
        <field name="arch" type="xml">
            <form string="Configure Objectives (Step 3 of 3)">
                <sheet>
                    <!-- Goal banner -->
                    <div class="alert alert-info d-flex align-items-center gap-2 mb-3 py-2"
                        role="alert">
                        <i class="fa fa-bullseye fa-lg text-info" />
                        <span>
                            <strong>Goal:</strong>
                            <field name="goal_name" readonly="1" nolabel="1"
                                class="ms-1 fw-semibold" />
                        </span>
                    </div>

                    <!-- Objective configuration lines (inline editable) -->
                    <field name="line_ids" nolabel="1">
                        <tree create="false" delete="true" editable="bottom">
                            <field name="name" />
                            <field name="measurement_type" string="Cách thu thập" />
                            <field name="baseline_accuracy_pct" string="Mức ban đầu (%)"
                                readonly="measurement_type not in ('accuracy','prompt_level')" />
                            <field name="target_accuracy_pct" string="Mục tiêu (%)"
                                readonly="measurement_type not in ('accuracy','prompt_level')" />
                            <field name="target_duration_seconds" string="Mục tiêu (giây)"
                                readonly="measurement_type != 'duration'" />
                            <field name="baseline_count" string="Cơ sở (lần)"
                                readonly="measurement_type not in ('frequency_increase','frequency_decrease')" />
                            <field name="target_count" string="Mục tiêu (lần)"
                                readonly="measurement_type not in ('frequency_increase','frequency_decrease')" />
                            <field name="consecutive_sessions_required" string="Số buổi liên tiếp" />
                            <field name="template_id" column_invisible="1" />
                        </tree>
                    </field>
                </sheet>

                <footer>
                    <button name="action_confirm"
                        string="Import Objectives"
                        type="object"
                        class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>