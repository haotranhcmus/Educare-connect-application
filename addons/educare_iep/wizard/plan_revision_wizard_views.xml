<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_educare_iep_plan_revision_wizard_form" model="ir.ui.view">
        <field name="name">educare.iep.plan.revision.wizard.form</field>
        <field name="model">educare.iep.plan.revision.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Plan Revision" create="false" edit="false">
                <group>
                    <group>
                        <field name="plan_id" readonly="1" />
                    </group>
                </group>
                <group>
                    <group string="Revision Details">
                        <field name="revision_reason" required="1" />
                        <field name="revision_notes"
                            placeholder="Mô tả ngắn lý do tạo revision và điểm thay đổi chính..." />
                    </group>
                </group>
                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                    <button name="action_confirm_create_revision"
                        string="Create Revision"
                        type="object"
                        class="btn-primary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_educare_iep_plan_revision_wizard" model="ir.actions.act_window">
        <field name="name">Create Plan Revision</field>
        <field name="res_model">educare.iep.plan.revision.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_educare_iep_plan_revision_wizard_form" />
        <field name="target">new</field>
    </record>
</odoo>