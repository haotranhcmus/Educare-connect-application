<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_educare_iep_objective_discontinue_wizard_form" model="ir.ui.view">
        <field name="name">educare.iep.objective.discontinue.wizard.form</field>
        <field name="model">educare.iep.objective.discontinue.wizard</field>
        <field name="arch" type="xml">
            <form string="Discontinue Objective" create="false" edit="false">
                <field name="is_last_active_objective" invisible="1" />
                <div class="alert alert-warning" role="alert"
                    invisible="not is_last_active_objective">
                    <strong>Warning:</strong> This is the last active objective in this goal.
                    Discontinuing it will leave the parent goal with no active objectives. </div>
                <group>
                    <group>
                        <field name="objective_id" readonly="1" />
                    </group>
                </group>
                <group>
                    <group string="Discontinue Details">
                        <field name="reason" />
                        <field name="notes"
                            placeholder="Additional notes about the discontinue reason (optional)..." />
                    </group>
                </group>
                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                    <button name="action_confirm_discontinue"
                        string="Confirm"
                        type="object"
                        class="btn-primary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_educare_iep_objective_discontinue_wizard" model="ir.actions.act_window">
        <field name="name">Discontinue Objective</field>
        <field name="res_model">educare.iep.objective.discontinue.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_educare_iep_objective_discontinue_wizard_form" />
        <field name="target">new</field>
    </record>
</odoo>