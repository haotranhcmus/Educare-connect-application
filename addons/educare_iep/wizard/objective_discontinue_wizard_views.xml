<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_educare_iep_objective_discontinue_wizard_form" model="ir.ui.view">
        <field name="name">educare.iep.objective.discontinue.wizard.form</field>
        <field name="model">educare.iep.objective.discontinue.wizard</field>
        <field name="arch" type="xml">
            <form string="Discontinue Objective" create="false" edit="false">
                <group>
                    <group>
                        <field name="objective_id" readonly="1" />
                    </group>
                </group>
                <group>
                    <group string="Discontinue Details">
                        <field name="reason" />
                        <field name="notes"
                               placeholder="Ghi chú thêm về lý do discontinue (tùy chọn)..." />
                    </group>
                </group>
                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                    <button name="action_confirm_discontinue"
                            string="Confirm"
                            type="object"
                            class="btn-primary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_educare_iep_objective_discontinue_wizard" model="ir.actions.act_window">
        <field name="name">Discontinue Objective</field>
        <field name="res_model">educare.iep.objective.discontinue.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_educare_iep_objective_discontinue_wizard_form" />
        <field name="target">new</field>
    </record>
</odoo>

