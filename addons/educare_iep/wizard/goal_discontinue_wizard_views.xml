<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_educare_iep_goal_discontinue_wizard_form" model="ir.ui.view">
        <field name="name">educare.iep.goal.discontinue.wizard.form</field>
        <field name="model">educare.iep.goal.discontinue.wizard</field>
        <field name="arch" type="xml">
            <form string="Discontinue Goal" create="false" edit="false">
                <field name="is_last_active_goal" invisible="1" />
                <field name="active_objective_count" invisible="1" />
                <div class="alert alert-warning" role="alert"
                    invisible="not is_last_active_goal">
                    <strong>Warning:</strong> This is the last active goal in this plan.
                    Discontinuing it will leave the plan with no active goals. </div>
                <div class="alert alert-info" role="alert"
                    invisible="active_objective_count == 0">
                    <strong>Note:</strong>
                    <field name="active_objective_count" class="oe_inline"
                        readonly="1" /> active objective(s) will also be discontinued. </div>
                <group>
                    <group>
                        <field name="goal_id" readonly="1" />
                    </group>
                </group>
                <group>
                    <group string="Discontinue Details">
                        <field name="reason" />
                        <field name="notes"
                            placeholder="Additional notes about the discontinue reason (optional)..." />
                    </group>
                </group>
                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                    <button name="action_confirm_discontinue"
                        string="Confirm"
                        type="object"
                        class="btn-primary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_educare_iep_goal_discontinue_wizard" model="ir.actions.act_window">
        <field name="name">Discontinue Goal</field>
        <field name="res_model">educare.iep.goal.discontinue.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_educare_iep_goal_discontinue_wizard_form" />
        <field name="target">new</field>
    </record>
</odoo>