<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_educare_iep_objective_quick_wizard_form" model="ir.ui.view">
        <field name="name">educare.iep.objective.quick.wizard.form</field>
        <field name="model">educare.iep.objective.quick.wizard</field>
        <field name="arch" type="xml">
            <form string="Thêm Mục tiêu Ngắn hạn">
                <sheet>
                    <group col="4" class="mb-0">
                        <field name="goal_id" readonly="1" />
                        <field name="student_id" readonly="1" />
                    </group>

                    <separator />

                    <group col="2" string="Thông tin cơ bản">
                        <field name="name"
                            placeholder="VD: Nhận dạng 10 từ vựng cơ bản" />
                        <field name="description"
                            placeholder="Mô tả chi tiết kỹ năng ngắn hạn cần đạt..." />
                    </group>

                    <group col="2">
                        <group string="Accuracy">
                            <field name="baseline_accuracy_pct" />
                            <field name="target_accuracy_pct" />
                        </group>
                        <group string="Timeline">
                            <field name="start_date" />
                            <field name="target_date" />
                        </group>
                    </group>

                    <group col="2">
                        <group string="Mastery Criteria">
                            <field name="consecutive_sessions_required" />
                        </group>
                    </group>

                    <div class="text-muted small mt-2">
                        <i class="fa fa-info-circle me-1" />
                        Các trường nâng cao (prompt level, probe method, measurement chi tiết) có thể điền sau trong form Objective đầy đủ.
                        Consecutive Sessions Required mặc định = 3 theo chuẩn ABA.
                    </div>
                </sheet>
                <footer>
                    <button name="action_create_objective" string="Tạo Objective" type="object"
                        class="btn-primary" />
                    <button string="Hủy" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>