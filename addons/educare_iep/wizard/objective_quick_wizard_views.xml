<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_educare_iep_objective_quick_wizard_form" model="ir.ui.view">
        <field name="name">educare.iep.objective.quick.wizard.form</field>
        <field name="model">educare.iep.objective.quick.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Short-term Objective">
                <sheet>
                    <group col="4" class="mb-0">
                        <field name="goal_id" readonly="1" />
                        <field name="student_id" readonly="1" />
                    </group>

                    <notebook>
                        <!-- Tab 1: Required basic info -->
                        <page string="Thông tin cơ bản" name="basic">
                            <group string="Objective">
                                <field name="name"
                                    placeholder="E.g.: Identify 10 basic vocabulary words" />
                                <field name="description"
                                    placeholder="Detailed description of the short-term skill to achieve..." />
                            </group>
                            <group>
                                <field name="measurement_type" />
                            </group>
                            <group col="2">
                                <group string="Accuracy"
                                    invisible="measurement_type not in ('accuracy','prompt_level')">
                                    <field name="baseline_accuracy_pct" />
                                    <field name="target_accuracy_pct" />
                                </group>
                                <group string="Thời gian"
                                    invisible="measurement_type != 'duration'">
                                    <field name="target_duration_seconds" />
                                </group>
                                <group string="Tần suất"
                                    invisible="measurement_type not in ('frequency_increase','frequency_decrease')">
                                    <field name="baseline_count" />
                                    <field name="target_count" />
                                </group>
                            </group>
                            <group string="Mastery Criteria">
                                <field name="consecutive_sessions_required" />
                            </group>
                        </page>

                        <!-- Tab 2: Baseline, measurement context -->
                        <page string="Baseline &amp; Tiêu chí" name="baseline_criteria">
                            <group string="Measurement">
                                <field name="measurement_template_id" />
                                <field name="suggested_prompt_level_id" />
                            </group>
                            <group string="Baseline Notes" col="1">
                                <field name="baseline_description"
                                    placeholder="Describe the student's current baseline performance..."
                                    nolabel="1" />
                            </group>
                        </page>

                        <!-- Tab 3: SMART framework -->
                        <page string="SMART" name="smart">
                            <div class="text-muted small mb-3">
                                <i class="fa fa-info-circle me-1" /> Điền thông tin SMART để đảm bảo mục tiêu rõ ràng, đo lường được và có thời hạn cụ thể. </div>
                            <group>
                                <field name="smart_specific"
                                    placeholder="Mô tả cụ thể mục tiêu là gì..." />
                                <field name="smart_measurable"
                                    placeholder="Đo lường bằng cách nào..." />
                                <field name="smart_analysis"
                                    placeholder="Tính khả thi và phù hợp với học sinh..." />
                                <field name="smart_timebound"
                                    placeholder="Thời hạn đạt mục tiêu..." />
                            </group>
                        </page>

                        <!-- Tab 4: Guidance and difficulty -->
                        <page string="Hướng dẫn" name="guidance">
                            <group string="Đối tượng &amp; Độ khó">
                                <field name="difficulty_id" />
                                <field name="age_min_months" />
                                <field name="age_max_months" />
                                <field name="relevant_diagnosis_ids" widget="many2many_tags" />
                            </group>
                            <group string="Thực hiện" col="1">
                                <field name="materials_needed"
                                    placeholder="Liệt kê vật liệu, đồ dùng cần thiết..."
                                    nolabel="1" />
                                <separator string="Implementation Steps" />
                                <field name="implementation_steps"
                                    placeholder="Mô tả từng bước thực hiện trong buổi trị liệu..."
                                    nolabel="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_create_objective" string="Create Objective" type="object"
                        class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>