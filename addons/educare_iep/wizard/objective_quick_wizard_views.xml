<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_educare_iep_objective_quick_wizard_form" model="ir.ui.view">
        <field name="name">educare.iep.objective.quick.wizard.form</field>
        <field name="model">educare.iep.objective.quick.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Short-term Objective">
                <sheet>
                    <group col="4" class="mb-0">
                        <field name="goal_id" readonly="1" />
                        <field name="student_id" readonly="1" />
                    </group>

                    <separator />

                    <group col="2" string="Basic Information">
                        <field name="name"
                            placeholder="E.g.: Identify 10 basic vocabulary words" />
                        <field name="description"
                            placeholder="Detailed description of the short-term skill to achieve..." />
                    </group>

                    <group col="2">
                        <group string="Accuracy">
                            <field name="baseline_accuracy_pct" />
                            <field name="target_accuracy_pct" />
                        </group>
                        <group string="Timeline">
                            <field name="start_date" />
                            <field name="target_date" />
                        </group>
                    </group>

                    <group col="2">
                        <group string="Mastery Criteria">
                            <field name="consecutive_sessions_required" />
                        </group>
                    </group>

                    <div class="text-muted small mt-2">
                        <i class="fa fa-info-circle me-1" /> Advanced fields (prompt level, probe
                        method, detailed measurement) can be filled later in the full Objective
                        form. Consecutive Sessions Required defaults to 3 per ABA standard. </div>
                </sheet>
                <footer>
                    <button name="action_create_objective" string="Create Objective" type="object"
                        class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>