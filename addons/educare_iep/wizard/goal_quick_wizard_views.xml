<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_educare_iep_goal_quick_wizard_form" model="ir.ui.view">
        <field name="name">educare.iep.goal.quick.wizard.form</field>
        <field name="model">educare.iep.goal.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Long-term Goal">
                <sheet>
                    <group col="2">
                        <!-- ─── Left Group: Goal Information (editable) ─── -->
                        <group string="Goal Information">
                            <field name="name"
                                placeholder="E.g.: Improve social communication skills" />
                            <field name="goal_domain_id"
                                options="{'no_create': True}" />
                            <field name="target_date" />
                            <field name="priority" />
                            <field name="goal_description"
                                placeholder="Overall long-term goal description..."
                                colspan="2" />
                        </group>

                        <!-- ─── Right Group: Plan Context (readonly) ─── -->
                        <group string="Plan Context">
                            <field name="plan_id" readonly="1" />
                            <field name="student_id" readonly="1" />
                            <field name="assigned_teacher_id" readonly="1" />
                            <field name="supervisor_id" readonly="1" />
                        </group>
                    </group>

                </sheet>

                <footer>
                    <button name="action_create_goal"
                        string="Create Goal"
                        type="object"
                        class="btn-primary" />
                    <button string="Cancel"
                        special="cancel"
                        class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>