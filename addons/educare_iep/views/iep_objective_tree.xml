<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_educare_iep_objective_tree" model="ir.ui.view">
        <field name="name">educare.iep.objective.tree</field>
        <field name="model">educare.iep.objective</field>
        <field name="arch" type="xml">
            <tree string="Short-term Objectives"
                default_order="student_id, goal_id, sequence"
                decoration-success="status == 'mastered'"
                decoration-warning="is_overdue == True"
                decoration-danger="alert_triggered == True"
                decoration-muted="status == 'discontinued'">
                <field name="objective_code" />
                <field name="student_id" />
                <field name="goal_id" />
                <field name="name" />
                <field name="target_accuracy_pct" />
                <field name="current_accuracy_pct" widget="progressbar" />
                <field name="trend" widget="badge"
                    decoration-success="trend == 'improving'"
                    decoration-warning="trend == 'stable'"
                    decoration-danger="trend in ('declining','stagnant')" />
                <field name="status" widget="badge"
                    decoration-success="status == 'mastered'"
                    decoration-info="status == 'in_progress'"
                    decoration-warning="status == 'not_started'"
                    decoration-primary="status == 'on_hold'"
                    decoration-danger="status == 'discontinued'" />
                <field name="is_overdue" widget="boolean" />
                <field name="alert_triggered" widget="boolean" />
            </tree>
        </field>
    </record>
</odoo>