<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_educare_iep_goal_form" model="ir.ui.view">
        <field name="name">educare.iep.goal.form</field>
        <field name="model">educare.iep.goal</field>
        <field name="arch" type="xml">
            <form string="Long-term IEP Goal">
                <header>
                    <field name="can_delete" invisible="1" />
                    <button name="action_delete_goal"
                        string="Xóa Goal"
                        type="object"
                        class="btn-danger"
                        confirm="Bạn chắc chắn muốn xóa mục tiêu dài hạn này? Hành động này không thể hoàn tác."
                        invisible="not can_delete"
                        groups="educare_security.group_teacher,educare_security.group_supervisor,educare_security.group_admin" />
                    <field name="status" widget="statusbar"
                        statusbar_visible="draft,active,achieved" />
                </header>

                <!-- Alert banner when objective alerts are active -->
                <field name="slow_progress_alert" invisible="1" />
                <div class="alert alert-warning" role="alert"
                    invisible="not slow_progress_alert">
                    <strong>Slow Progress</strong> Objective(s) are not progressing as expected.
                    Please review the objectives and update the intervention strategies. </div>

                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_objective_wizard"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-plus"
                            string="Add Objective"
                            invisible="status in ['achieved', 'discontinued']">
                        </button>
                        <button name="action_open_objectives"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list-ol"
                            string="Objectives">
                            <field name="objective_count" widget="statinfo" />
                        </button>
                    </div>

                    <!-- Title Section -->
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="VD: Tăng khả năng giao tiếp xã hội..." />
                        </h1>
                        <h3>
                            <field name="goal_code" />
                        </h3>
                    </div>

                    <!-- Quick Info -->
                    <group>
                        <group string="Information">
                            <field name="plan_id" />
                            <field name="student_id" readonly="1" />
                            <field name="goal_domain_id" />
                            <field name="priority" />
                            <field name="assigned_teacher_id" readonly="1" />
                            <field name="supervisor_id" readonly="1" />
                        </group>
                        <group string="Time Frame">
                            <field name="start_date" invisible="1" />
                            <field name="target_date" />
                            <field name="achieved_date"
                                invisible="status != 'achieved'" />
                            <field name="discontinue_reason"
                                invisible="status != 'discontinued'" />
                        </group>
                    </group>

                    <!-- Progress Bar -->
                    <group>
                        <field name="progress_pct" widget="progressbar"
                            colspan="2" />
                    </group>

                    <!-- Notebook Tabs -->
                    <notebook>


                        <!-- Tab 1: Objectives (Inline) -->
                        <page string="Short-term Objectives" name="objectives">
                            <field name="objective_ids"
                                create="false"
                                context="{'default_goal_id': id}">
                                <tree open="full"
                                    create="false"
                                    decoration-success="status == 'mastered'"
                                    decoration-warning="is_overdue == True"
                                    decoration-danger="alert_triggered == True"
                                    decoration-muted="status == 'discontinued'">
                                    <header>
                                        <button name="action_delete_objective"
                                            type="object"
                                            string="Xóa Objective"
                                            class="btn-link text-danger"
                                            confirm="Bạn chắc chắn muốn xóa mục tiêu ngắn hạn đã chọn? Hành động này không thể hoàn tác." />
                                    </header>
                                    <field name="objective_code" readonly="1"
                                        column_invisible="1" />
                                    <field name="name" />
                                    <field name="start_date" />
                                    <field name="target_date" />
                                    <field name="target_accuracy_pct" string="Target (%)" />
                                    <field name="current_accuracy_pct"
                                        widget="progressbar" string="Accuracy" />
                                    <field name="status" widget="badge"
                                        decoration-success="status == 'mastered'"
                                        decoration-info="status == 'in_progress'"
                                        decoration-warning="status == 'not_started'"
                                        decoration-primary="status == 'on_hold'"
                                        decoration-danger="status == 'discontinued'" />
                                    <field name="alert_triggered" widget="boolean" />
                                    <field name="is_overdue" column_invisible="1" />
                                    <field name="trend" column_invisible="1" />
                                    <field name="baseline_accuracy_pct" column_invisible="1" />
                                    <field name="weight" column_invisible="1" />
                                </tree>
                            </field>
                        </page>
                        <!-- Tab 2: SMART Goal -->
                        <page string="SMART Goal" name="smart">
                            <group>
                                <field name="goal_description"
                                    placeholder="Mô tả tổng quan mục tiêu dài hạn..."
                                    colspan="2" />
                            </group>
                            <group col="2">
                                <group string="S.M.A.R.T.">
                                    <field name="smart_specific"
                                        placeholder="Hành vi cụ thể cần đạt được..." />
                                    <field name="smart_measurable"
                                        placeholder="VD: Đạt 80% chính xác qua 3 buổi liên tiếp" />
                                    <field name="smart_timebound"
                                        placeholder="VD: Trong vòng 6 tháng" />
                                    <field name="smart_analysis"
                                        placeholder="VD: Trẻ có khả năng tự điều chỉnh trong thời gian ngắn với hỗ trợ. Giảm hành vi giúp trẻ tham gia học tập hiệu quả hơn." />
                                </group>

                                <group string="Measurement Setup">
                                    <field name="baseline_description"
                                        placeholder="Mô tả mức độ ban đầu trước can thiệp..." />
                                    <field name="baseline_accuracy_pct" />
                                    <field name="target_accuracy_pct" />
                                    <field name="measurement_template_id"
                                        string="Quick Template"
                                        options="{'no_create': True}"
                                        placeholder="Select template to auto-fill criteria and condition" />
                                    <field name="measurement_criteria"
                                        placeholder="Tiêu chí đo lường cụ thể..." />
                                    <field name="measurement_condition"
                                        placeholder="VD: Trong DTT và structured play" />
                                </group>
                            </group>
                        </page>

                        <!-- Tab 3: Progress -->
                        <page string="Progress" name="progress">
                            <group>
                                <group string="Summary (Auto-calculated)">
                                    <field name="progress_pct" widget="progressbar" />
                                    <field name="current_accuracy_pct" />
                                    <field name="total_sessions" />
                                </group>
                            </group>
                            <group>
                                <field name="modification_history"
                                    placeholder="VD: 15/03/2026 - Điều chỉnh target từ 80% xuống 70% do trẻ gặp khó khăn" />
                            </group>
                        </page>
                        <!-- Tab 4: Framework -->
                        <page string="Framework" name="framework">
                            <group>
                                <group string="Reference Framework">
                                    <field name="framework_id" />
                                    <field name="framework_code" />
                                    <field name="framework_domain"
                                        placeholder="e.g. VB-MAPP Milestone 3 - Tact" />
                                </group>
                                <group string="References">
                                    <field name="literature_ref"
                                        placeholder="VD: Cooper, Heron &amp; Heward (2020). Applied Behavior Analysis, 3rd Ed." />
                                    <field name="notes"
                                        placeholder="VD: Trẻ thực hiện tốt hơn vào buổi sáng, cần theo dõi thêm" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
</odoo>