<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_educare_iep_goal_form" model="ir.ui.view">
        <field name="name">educare.iep.goal.form</field>
        <field name="model">educare.iep.goal</field>
        <field name="arch" type="xml">
            <form string="Long-term IEP Goal">
                <header>
                    <field name="can_delete" invisible="1" />
                    <field name="plan_status" invisible="1" />
                    <button name="action_open_discontinue_goal_wizard" string="Discontinue"
                        type="object"
                        class="btn-danger"
                        invisible="status in ('achieved', 'discontinued') or plan_status != 'active'"
                        groups="educare_security.group_supervisor,educare_security.group_admin" />
                    <field name="status" widget="statusbar"
                        statusbar_visible="draft,active,achieved,discontinued" />
                </header>

                <!-- Alert banner when objective alerts are active -->
                <field name="slow_progress_alert" invisible="1" />
                <div class="alert alert-warning" role="alert"
                    invisible="not slow_progress_alert">
                    <strong>Slow Progress</strong> Objective(s) are not progressing as expected. Please review the objectives and update the intervention strategies. </div>

                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_objective_wizard"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-plus"
                            string="Add Objective"
                            invisible="plan_status != 'draft' or status in ['achieved', 'discontinued']"
                            groups="educare_security.group_supervisor,educare_security.group_admin">
                        </button>
                        <button name="action_open_template_import_wizard"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-download"
                            string="Import Template"
                            invisible="plan_status != 'draft' or status in ['achieved', 'discontinued']">
                        </button>
                        <button name="action_open_objectives"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list-ol"
                            string="Objectives">
                            <field name="objective_count" widget="statinfo" />
                        </button>
                    </div>

                    <!-- Title Section -->
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name"
                                placeholder="E.g.: Improve social communication skills..."
                                readonly="plan_status != 'draft'" />
                        </h1>
                        <h3 invisible="not goal_code or goal_code == '/'">
                            <field name="goal_code" readonly="1" />
                        </h3>
                    </div>

                    <!-- Quick Info -->
                    <group>
                        <group>
                            <field name="plan_id" readonly="1" />
                            <field name="student_id" readonly="1" />
                            <field name="goal_domain_id" readonly="plan_status != 'draft'" />
                            <field name="priority" readonly="plan_status != 'draft'" />

                        </group>
                        <group>
                            <field name="assigned_teacher_id" readonly="1" />
                            <field name="supervisor_id" readonly="1" />
                            <field name="achieved_date"
                                invisible="status != 'achieved'" />
                            <field name="discontinue_reason"
                                invisible="status != 'discontinued'" />
                        </group>
                    </group>

                    <!-- Progress Bar -->
                    <group>
                        <field name="progress_pct" widget="progressbar"
                            colspan="2" />
                        <field name="goal_description"
                            placeholder="Overall long-term goal description..."
                            readonly="plan_status != 'draft'"
                            colspan="2" />
                    </group>

                    <!-- Notebook Tabs -->
                    <notebook>


                        <!-- Tab 1: Objectives (Inline) -->
                        <page string="Short-term Objectives" name="objectives">
                            <field name="objective_ids"
                                create="false"
                                context="{'default_goal_id': id}">
                                <tree open="full"
                                    create="false"
                                    decoration-success="status == 'mastered'"
                                    decoration-danger="alert_triggered == True"
                                    decoration-muted="status == 'discontinued'">
                                    <header>
                                        <button name="action_delete_objective"
                                            type="object"
                                            string="Delete Objective"
                                            class="btn-link text-danger"
                                            invisible="not can_delete"
                                            confirm="Are you sure you want to delete the selected short-term objective? This action cannot be undone." />
                                    </header>
                                    <field name="objective_code" readonly="1"
                                        column_invisible="1" />
                                    <field name="name" />
                                    <field name="target_accuracy_pct" string="Target (%)" />
                                    <field name="current_accuracy_pct"
                                        widget="progressbar" string="Accuracy" />
                                    <field name="status" widget="badge"
                                        decoration-success="status == 'mastered'"
                                        decoration-info="status == 'in_progress'"
                                        decoration-warning="status == 'not_started'"
                                        decoration-primary="status == 'on_hold'"
                                        decoration-danger="status == 'discontinued'" />
                                    <field name="alert_triggered" widget="boolean" />
                                    <field name="trend" column_invisible="1" />
                                    <field name="baseline_accuracy_pct" column_invisible="1" />
                                    <field name="weight" column_invisible="1" />
                                    <field name="can_delete" column_invisible="1" />
                                </tree>
                            </field>
                            <div class="align-items-center text-center">
                                <button name="action_open_template_import_wizard"
                                    string="Add Objectives"
                                    type="object"
                                    class="link-primary"
                                    invisible="plan_status != 'draft' or status in ['achieved', 'discontinued']" />
                            </div>
                        </page>
                        <!-- Tab 2: Progress -->
                        <page string="Progress" name="progress">
                            <group>
                                <group string="Summary (Auto-calculated)">
                                    <field name="progress_pct" widget="progressbar" />
                                    <field name="current_accuracy_pct" />
                                    <field name="total_sessions" />
                                </group>
                            </group>
                            <group>
                                <field name="modification_history"
                                    placeholder="E.g.: 03/15/2026 - Adjusted target from 80% to 70% due to student difficulty" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
</odoo>