<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Goal Template: Tree                                     -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <record id="view_educare_iep_goal_template_tree" model="ir.ui.view">
        <field name="name">educare.iep.goal.template.tree</field>
        <field name="model">educare.iep.goal.template</field>
        <field name="arch" type="xml">
            <tree string="Goal Templates"
                default_order="sequence, name">
                <field name="sequence" widget="handle" />
                <field name="code" />
                <field name="name" />
                <field name="template_domain_id" />
                <field name="priority" widget="badge"
                    decoration-danger="priority == 'critical'"
                    decoration-warning="priority == 'high'"
                    decoration-info="priority == 'medium'"
                    decoration-muted="priority == 'low'" />
                <field name="objective_template_count" string="Objectives" />
                <field name="active" widget="boolean_toggle" optional="hide" />
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Goal Template: Form                                     -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <record id="view_educare_iep_goal_template_form" model="ir.ui.view">
        <field name="name">educare.iep.goal.template.form</field>
        <field name="model">educare.iep.goal.template</field>
        <field name="arch" type="xml">
            <form string="Goal Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name"
                                placeholder="E.g.: Functional communication: Verbal requests" />
                        </h1>
                    </div>
                    <group>
                        <group string="Template Info">
                            <field name="code" />
                            <field name="template_domain_id" />
                            <field name="priority" />
                            <field name="sequence" />
                            <field name="active" />
                        </group>
                    </group>
                    <group>
                        <field name="goal_summary"
                            placeholder="Summary of the long-term goal content..." />
                        <field name="note"
                            placeholder="Internal notes for specialists..." />
                    </group>
                    <notebook>
                        <page string="Objective Templates" name="objectives">
                            <field name="objective_template_ids">
                                <tree>
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="template_domain_id" />
                                    <field name="baseline_accuracy_pct" string="Baseline (%)" />
                                    <field name="target_accuracy_pct" string="Target (%)" />
                                    <field name="weight" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Goal Template: Search                                   -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <record id="view_educare_iep_goal_template_search" model="ir.ui.view">
        <field name="name">educare.iep.goal.template.search</field>
        <field name="model">educare.iep.goal.template</field>
        <field name="arch" type="xml">
            <search string="Search Goal Templates">
                <field name="name" />
                <field name="code" />
                <field name="template_domain_id" />
                <separator />
                <filter name="filter_active" string="Active"
                    domain="[('active', '=', True)]" />
                <separator />
                <group expand="0" string="Group By">
                    <filter name="group_domain" string="Domain"
                        context="{'group_by': 'template_domain_id'}" />
                    <filter name="group_priority" string="Priority"
                        context="{'group_by': 'priority'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Goal Template: Action                                   -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <record id="action_iep_goal_template" model="ir.actions.act_window">
        <field name="name">Goal Templates</field>
        <field name="res_model">educare.iep.goal.template</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_educare_iep_goal_template_search" />
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Goal Template
            </p>
            <p>Goal templates are reusable LTG blueprints with linked objective templates.</p>
        </field>
    </record>
</odoo>