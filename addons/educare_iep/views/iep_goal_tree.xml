<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_educare_iep_goal_tree" model="ir.ui.view">
        <field name="name">educare.iep.goal.tree</field>
        <field name="model">educare.iep.goal</field>
        <field name="arch" type="xml">
            <tree string="IEP Goals"
                default_order="student_id, start_date desc"
                decoration-success="status == 'achieved'"
                decoration-danger="status == 'active' and progress_pct &lt; 30"
                decoration-muted="status == 'discontinued'">
                <field name="goal_code" />
                <field name="student_id" />
                <field name="goal_domain_id" widget="badge" />
                <field name="name" string="Description" />
                <field name="assigned_teacher_id" />
                <field name="start_date" optional="hide" />
                <field name="target_date" />
                <field name="progress_pct" widget="progressbar" />
                <field name="status" widget="badge"
                    decoration-success="status == 'achieved'"
                    decoration-info="status == 'active'"
                    decoration-warning="status == 'draft'"
                    decoration-danger="status == 'discontinued'" />
                <field name="supervisor_approved" widget="boolean"
                    optional="show" />
                <field name="priority_id" widget="many2one"
                    optional="show" />
            </tree>
        </field>
    </record>
</odoo>