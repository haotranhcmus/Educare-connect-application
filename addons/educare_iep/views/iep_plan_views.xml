<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_educare_iep_plan_tree" model="ir.ui.view">
        <field name="name">educare.iep.plan.tree</field>
        <field name="model">educare.iep.plan</field>
        <field name="arch" type="xml">
            <tree string="IEP Plans"
                default_order="start_date desc"
                decoration-success="status == 'active'"
                decoration-muted="status == 'closed'"
                decoration-warning="status == 'draft'"
                decoration-info="status == 'ready_review'"
                decoration-primary="status == 'supervisor_approved'">
                <field name="iep_period" />
                <field name="version_number" optional="show" />
                <field name="is_latest_version" widget="boolean" optional="show" />
                <field name="student_id" />
                <field name="assigned_teacher_id" optional="show" />
                <field name="supervisor_id" optional="show" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="goal_count" optional="show" />
                <field name="supervisor_approved" widget="boolean" optional="show" />
                <field name="status" widget="badge"
                    decoration-warning="status == 'draft'"
                    decoration-info="status == 'ready_review'"
                    decoration-primary="status == 'supervisor_approved'"
                    decoration-success="status == 'active'"
                    decoration-muted="status == 'closed'" />
            </tree>
        </field>
    </record>

    <record id="view_educare_iep_plan_search" model="ir.ui.view">
        <field name="name">educare.iep.plan.search</field>
        <field name="model">educare.iep.plan</field>
        <field name="arch" type="xml">
            <search string="Search IEP Plans">
                <field name="iep_period" />
                <field name="version_number" />
                <field name="is_latest_version" />
                <field name="root_plan_id" />
                <field name="student_id" />
                <field name="assigned_teacher_id" />
                <field name="supervisor_id" />
                <separator />
                <filter name="filter_draft" string="Draft" domain="[('status', '=', 'draft')]" />
                <filter name="filter_ready_review" string="Ready for Review"
                    domain="[('status', '=', 'ready_review')]" />
                <filter name="filter_supervisor_approved" string="Supervisor Approved"
                    domain="[('status', '=', 'supervisor_approved')]" />
                <filter name="filter_active" string="Active" domain="[('status', '=', 'active')]" />
                <filter name="filter_closed" string="Closed" domain="[('status', '=', 'closed')]" />
                <filter name="filter_latest_version" string="Latest Version"
                    domain="[('is_latest_version', '=', True)]" />
                <filter name="filter_pending_approval" string="Pending Approval"
                    domain="['|', ('status', '=', 'ready_review'), ('status', '=', 'supervisor_approved')]" />
                <separator />
                <group expand="0" string="Group By">
                    <filter name="group_student" string="Student"
                        context="{'group_by': 'student_id'}" />
                    <filter name="group_teacher" string="Teacher"
                        context="{'group_by': 'assigned_teacher_id'}" />
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}" />
                    <filter name="group_version_chain" string="Version Chain"
                        context="{'group_by': 'root_plan_id'}" />
                    <filter name="group_period" string="Period" context="{'group_by': 'iep_period'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_educare_iep_plan_form" model="ir.ui.view">
        <field name="name">educare.iep.plan.form</field>
        <field name="model">educare.iep.plan</field>
        <field name="arch" type="xml">
            <form string="IEP Plan">
                <header>
                    <button name="action_submit_for_review"
                        string="Submit for Review"
                        type="object"
                        class="btn-primary"
                        invisible="status != 'draft' or not id"
                        groups="educare_security.group_teacher,educare_security.group_supervisor,educare_security.group_admin" />
                    <button name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        class="btn-secondary"
                        confirm="Are you sure you want to reset this plan back to Draft status?"
                        invisible="status != 'ready_review'"
                        groups="educare_security.group_teacher,educare_security.group_supervisor,educare_security.group_admin" />
                    <button name="action_open_revision_wizard"
                        string="Revise"
                        type="object"
                        class="btn-warning"
                        invisible="status not in ['active', 'closed']"
                        groups="educare_security.group_teacher,educare_security.group_supervisor,educare_security.group_admin" />
                    <button name="action_open_cancel_revision_wizard"
                        string="Cancel Revision"
                        type="object"
                        class="btn-danger"
                        invisible="not revision_of_id or status not in ['draft', 'ready_review']"
                        groups="educare_security.group_teacher,educare_security.group_supervisor,educare_security.group_admin" />
                    <button name="action_supervisor_approve"
                        string="Supervisor Approve Plan"
                        type="object"
                        class="btn-primary"
                        invisible="status != 'ready_review' or supervisor_approved"
                        groups="educare_security.group_supervisor,educare_security.group_admin" />
                    <button name="action_open_reject_wizard"
                        string="Reject"
                        type="object"
                        class="btn-secondary"
                        invisible="status != 'ready_review'"
                        groups="educare_security.group_supervisor,educare_security.group_admin" />
                    <button name="action_open_close_wizard"
                        string="Close"
                        type="object"
                        class="btn-danger"
                        invisible="status != 'active'"
                        groups="educare_security.group_supervisor,educare_security.group_admin" />
                    <field name="status" widget="statusbar"
                        statusbar_visible="draft,ready_review,active,closed" />
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box" invisible="not id">
                        <button name="action_open_goal_wizard"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-plus"
                            string="Add Goal"
                            invisible="status != 'draft'"
                            groups="educare_security.group_teacher,educare_security.group_supervisor,educare_security.group_admin" />
                        <button name="action_open_goals"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-bullseye"
                            string="Goals">
                            <field name="goal_count" widget="statinfo" />
                        </button>
                        <button name="action_view_versions"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-code-fork"
                            string="Versions" />
                        <button name="%(educare_iep.action_report_iep_plan)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-print"
                            string="Print PDF"
                            invisible="not id" />
                    </div>

                    <div class="oe_title">
                        <label for="iep_period" />
                        <h1>
                            <field name="iep_period"
                                readonly="1"
                                placeholder="E.g.: 2026-H1 or 2026 Semester 1" />
                        </h1>
                    </div>

                    <group>
                        <group string="Plan Information">
                            <field name="student_id" readonly="status != 'draft'"
                                domain="[('active_iep_plan_id', '=', False)]" />
                            <field name="assigned_teacher_id" invisible="1" />
                            <field name="supervisor_id" invisible="1" />
                            <field name="start_date" readonly="status != 'draft'" />
                            <field name="end_date" readonly="status != 'draft'" />
                            <field name="review_frequency" readonly="status != 'draft'" />
                            <field name="next_review_date" readonly="1" />
                        </group>

                        <group string="Version Information" invisible="status == 'draft'">
                            <field name="student_center_id" invisible="1" />
                            <field name="version_number" readonly="1" invisible="not id" />
                            <field name="is_latest_version" readonly="1" invisible="not id" />
                            <field name="revision_of_id" readonly="1"
                                invisible="not id"
                                options="{'no_open': True}" />
                            <field name="revision_reason"
                                readonly="1"
                                invisible="not revision_of_id" />
                            <field name="revision_notes"
                                readonly="1"
                                invisible="not revision_of_id" />
                            <field name="root_plan_id" readonly="1"
                                invisible="not id"
                                options="{'no_open': True}" />
                        </group>

                    </group>

                    <group invisible="status != 'closed'">
                        <group string="Closing Information">
                            <field name="closing_reason" readonly="1" />
                            <field name="closing_notes"
                                placeholder="Reason for closing IEP plan, notes for audit trail..."
                                readonly="1" />
                        </group>

                        <group string="Approval" invisible="status == 'draft'">
                            <field name="supervisor_approved" readonly="1" />
                            <field name="approved_date" readonly="1"
                                invisible="not supervisor_approved" />
                            <field name="approval_notes" invisible="not supervisor_approved" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Goals" name="goals" invisible="not id">
                            <field name="goal_ids"
                                create="false"
                                context="{'default_plan_id': id}">
                                <tree open="full"
                                    create="false"
                                    edit="false"
                                    delete="false"
                                    decoration-success="status == 'achieved'"
                                    decoration-info="status == 'active'"
                                    decoration-warning="status == 'draft'"
                                    decoration-muted="status == 'discontinued'">
                                    <field name="can_delete" column_invisible="1" />
                                    <field name="goal_code" readonly="1" optional="show" />
                                    <field name="name" />
                                    <field name="goal_domain_id" />
                                    <field name="objective_count" string="Objectives"
                                        optional="show" />
                                    <field name="start_date" />
                                    <field name="target_date" />
                                    <field name="progress_pct" widget="progressbar" />
                                    <field name="status" widget="badge"
                                        decoration-info="status == 'active'"
                                        decoration-success="status == 'achieved'"
                                        decoration-warning="status == 'draft'"
                                        decoration-muted="status == 'discontinued'" />
                                    <button name="action_delete_goal"
                                        icon="fa-trash"
                                        type="object"
                                        string=""
                                        title="Delete Goal"
                                        class="btn-link text-danger"
                                        confirm="Are you sure you want to delete this long-term goal? This action cannot be undone."
                                        invisible="not can_delete" />
                                </tree>
                            </field>
                        </page>
                        <page string="Revisions" name="revisions"
                            invisible="not revision_ids">
                            <field name="revision_ids" readonly="1">
                                <tree decoration-success="status == 'active'"
                                    decoration-muted="status == 'closed'">
                                    <field name="iep_period" />
                                    <field name="version_number" />
                                    <field name="is_latest_version" widget="boolean" />
                                    <field name="start_date" />
                                    <field name="end_date" />
                                    <field name="status" widget="badge"
                                        decoration-success="status == 'active'"
                                        decoration-muted="status == 'closed'" />
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
</odoo>