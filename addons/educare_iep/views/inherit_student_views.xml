<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_educare_student_form_iep_plans" model="ir.ui.view">
            <field name="name">educare.student.form.iep.plans</field>
            <field name="model">educare.student</field>
            <field name="inherit_id" ref="educare_student.view_educare_student_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_create_iep_plan"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-plus"
                        string="Create IEP"
                        invisible="not id" />
                    <button name="action_open_iep_plans"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-list-alt"
                        string="IEP Plans"
                        invisible="not id">
                        <field name="iep_plan_count" widget="statinfo" />
                    </button>
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page string="IEP Plans" name="iep_plans">
                        <field name="iep_plan_ids" context="{'default_student_id': id}">
                            <tree string="IEP Plans" default_order="start_date desc">
                                <field name="iep_period" readonly="1" />
                                <field name="assigned_teacher_id" />
                                <field name="supervisor_id" />
                                <field name="start_date" />
                                <field name="end_date" />
                                <field name="status" widget="badge"
                                    decoration-warning="status == 'draft'"
                                    decoration-success="status == 'active'"
                                    decoration-muted="status == 'closed'" />
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>