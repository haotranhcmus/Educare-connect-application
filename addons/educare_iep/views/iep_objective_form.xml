<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_educare_iep_objective_form" model="ir.ui.view">
        <field name="name">educare.iep.objective.form</field>
        <field name="model">educare.iep.objective</field>
        <field name="arch" type="xml">
            <form string="Short-term Objective">
                <header>
                    <field name="can_delete" invisible="1" />
                    <field name="plan_status" invisible="1" />
                    <button name="action_delete_objective" string="Delete Objective" type="object"
                        class="btn-danger"
                        confirm="Are you sure you want to delete this short-term objective? This action cannot be undone."
                        invisible="not can_delete"
                        groups="educare_security.group_teacher,educare_security.group_supervisor,educare_security.group_admin" />
                    <button name="action_start" string="Start" type="object"
                        class="btn-primary"
                        confirm="Confirm transitioning objective status to In Progress?"
                        invisible="status != 'not_started' or plan_status != 'active'" />
                    <button name="action_put_on_hold" string="Pause" type="object"
                        class="btn-warning"
                        confirm="Confirm transitioning objective status to Paused?"
                        invisible="status != 'in_progress' or plan_status != 'active'" />
                    <button name="action_resume" string="Resume" type="object"
                        class="btn-secondary"
                        confirm="Confirm transitioning objective status to In Progress?"
                        invisible="status != 'on_hold' or plan_status != 'active'" />
                    <button name="action_mark_mastered" string="Mastered" type="object"
                        class="btn-success"
                        confirm="Confirm marking objective as Mastered?"
                        invisible="status not in ('in_progress', 'on_hold') or plan_status != 'active'" />
                    <button name="action_open_discontinue_wizard" string="Discontinue" type="object"
                        class="btn-danger"
                        invisible="status in ('mastered', 'discontinued') or plan_status != 'active'" />
                    <field name="status" widget="statusbar"
                        statusbar_visible="not_started,in_progress,on_hold,mastered,discontinued"
                        clickable="0" />
                </header>

                <!-- Alert Banner -->
                <div class="alert alert-danger" role="alert"
                    invisible="not alert_triggered">
                    <strong>Alert:</strong>
                    <field name="alert_message" nolabel="1" />
                </div>

                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" readonly="plan_status != 'draft'" />
                        </h1>
                        <h3 invisible="not objective_code or objective_code == '/'">
                            <field name="objective_code" />
                        </h3>
                    </div>

                    <notebook>
                        <!-- Tab 1: Objective -->
                        <page string="Objective" name="objective_info">
                            <group>
                                <group string="Core Information">
                                    <field name="goal_id" readonly="1" />
                                    <field name="student_id" readonly="1" />
                                    <field name="sequence" readonly="plan_status != 'draft'" />
                                    <field name="start_date" readonly="1" />
                                    <field name="target_date" readonly="1" />
                                    <field name="mastery_date"
                                        invisible="status != 'mastered'" />
                                </group>
                                <group string="Method &amp; Workflow">
                                    <field name="prompt_level_id"
                                        readonly="plan_status != 'draft'"
                                        options="{'no_create': True}"
                                        placeholder="E.g.: Verbal Prompt, Physical Prompt..."
                                        help="Maximum prompt level used during ABA intervention session. Select from low (Gesture) to high (Full Physical)." />
                                    <field name="probe_method_id"
                                        readonly="plan_status != 'draft'"
                                        options="{'no_create': True}"
                                        placeholder="E.g.: DTT, Natural Environment..."
                                        help="Method for measuring child responses: DTT (discrete trial training) or NE (natural environment)." />
                                    <field name="weight" readonly="plan_status != 'draft'" />
                                    <field name="status" readonly="1" />
                                    <field name="is_overdue" readonly="1" />
                                    <field name="trend" widget="badge"
                                        decoration-success="trend == 'improving'"
                                        decoration-warning="trend == 'stable'"
                                        decoration-danger="trend in ('declining','stagnant')" />
                                </group>
                            </group>
                            <group>
                                <field name="description"
                                    placeholder="Detailed description of the short-term objective to achieve..."
                                    readonly="plan_status != 'draft'"
                                    colspan="2" />
                            </group>
                            <group>
                                <field name="measurement_method"
                                    placeholder="E.g.: Number of correct responses / total trials"
                                    readonly="plan_status != 'draft'"
                                    colspan="2" />
                            </group>
                            <group>
                                <field name="discontinued_reason"
                                    placeholder="Reason for permanently discontinuing objective..."
                                    required="status == 'discontinued'"
                                    colspan="2" />
                            </group>
                        </page>

                        <!-- Tab 2: Success Criteria -->
                        <page string="Criteria" name="criteria">
                            <group>
                                <group string="Accuracy Targets">
                                    <field name="baseline_accuracy_pct"
                                        readonly="plan_status != 'draft'" />
                                    <field name="target_accuracy_pct"
                                        readonly="plan_status != 'draft'" />
                                </group>
                                <group string="Session Rules">
                                    <field name="target_trials" readonly="plan_status != 'draft'" />
                                    <field name="consecutive_sessions_required"
                                        readonly="plan_status != 'draft'" />
                                    <field name="consecutive_sessions_achieved"
                                        readonly="1" />
                                </group>
                            </group>
                        </page>

                        <!-- Tab 3: Actual Progress -->
                        <page string="Progress" name="progress">
                            <group>
                                <group string="Results">
                                    <field name="current_accuracy_pct"
                                        widget="progressbar" />
                                    <field name="progress_pct"
                                        widget="progressbar" />
                                    <field name="last_session_date" />
                                    <field name="last_session_accuracy" />
                                </group>
                                <group string="Statistics">
                                    <field name="total_sessions_worked" />
                                    <field name="trend" widget="badge" />
                                    <field name="is_overdue" />
                                    <field name="alert_triggered" />
                                    <field name="alert_message"
                                        invisible="not alert_triggered" />
                                </group>
                            </group>
                            <group>
                                <field name="notes"
                                    placeholder="E.g.: Student performs better in the morning, needs further monitoring"
                                    colspan="2" />
                            </group>
                            <!-- Placeholder: add session_result_ids inline tree when session
                            module is ready -->
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
</odoo>