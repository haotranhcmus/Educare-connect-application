<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_educare_iep_objective_form" model="ir.ui.view">
        <field name="name">educare.iep.objective.form</field>
        <field name="model">educare.iep.objective</field>
        <field name="arch" type="xml">
            <form string="Short-term Objective">
                <header>
                    <button name="action_put_on_hold" string="Tạm Dừng" type="object"
                        class="btn-warning"
                        invisible="status != 'in_progress'" />
                    <button name="action_resume" string="Tiếp Tục" type="object"
                        class="btn-primary"
                        invisible="status != 'on_hold'" />
                    <button name="action_discontinue" string="Ngừng Hẳn" type="object"
                        class="btn-danger"
                        invisible="status in ('mastered', 'discontinued')" />
                    <field name="status" widget="statusbar"
                        statusbar_visible="not_started,in_progress,mastered"
                        clickable="0" />
                </header>

                <!-- Alert Banner -->
                <div class="alert alert-danger" role="alert"
                    invisible="not alert_triggered">
                    <strong>Alert:</strong>
                    <field name="alert_message" nolabel="1" />
                </div>

                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                        <h3>
                            <field name="objective_code" />
                        </h3>
                    </div>

                    <notebook>
                        <!-- Tab 1: Objective -->
                        <page string="Objective" name="objective_info">
                            <group>
                                <group string="Core Information">
                                    <field name="goal_id" />
                                    <field name="student_id" readonly="1" />
                                    <field name="sequence" />
                                    <field name="start_date" />
                                    <field name="target_date" />
                                    <field name="mastery_date"
                                        invisible="status != 'mastered'" />
                                </group>
                                <group string="Method &amp; Workflow">
                                    <field name="prompt_level_id" />
                                    <field name="probe_method_id" />
                                    <field name="weight" />
                                    <field name="status" />
                                    <field name="is_overdue" readonly="1" />
                                    <field name="trend" widget="badge"
                                        decoration-success="trend == 'improving'"
                                        decoration-warning="trend == 'stable'"
                                        decoration-danger="trend in ('declining','stagnant')" />
                                </group>
                            </group>
                            <group>
                                <field name="description"
                                    placeholder="Detailed short-term objective description..."
                                    colspan="2" />
                            </group>
                            <group>
                                <field name="measurement_method"
                                    placeholder="e.g. Number of correct responses / total trials"
                                    colspan="2" />
                            </group>
                        </page>

                        <!-- Tab 2: Success Criteria -->
                        <page string="Criteria" name="criteria">
                            <group>
                                <group string="Accuracy Targets">
                                    <field name="baseline_accuracy_pct" />
                                    <field name="target_accuracy_pct" />
                                </group>
                                <group string="Session Rules">
                                    <field name="target_trials" />
                                    <field name="consecutive_sessions_required" />
                                    <field name="consecutive_sessions_achieved"
                                        readonly="1" />
                                </group>
                            </group>
                        </page>

                        <!-- Tab 3: Actual Progress -->
                        <page string="Progress" name="progress">
                            <group>
                                <group string="Results">
                                    <field name="current_accuracy_pct"
                                        widget="progressbar" />
                                    <field name="progress_pct"
                                        widget="progressbar" />
                                    <field name="last_session_date" />
                                    <field name="last_session_accuracy" />
                                </group>
                                <group string="Statistics">
                                    <field name="total_sessions_worked" />
                                    <field name="trend" widget="badge" />
                                    <field name="is_overdue" />
                                    <field name="alert_triggered" />
                                    <field name="alert_message"
                                        invisible="not alert_triggered" />
                                </group>
                            </group>
                            <group>
                                <field name="notes"
                                    placeholder="Observation notes..."
                                    colspan="2" />
                            </group>
                            <!-- Placeholder: add session_result_ids inline tree when session
                            module is ready -->
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
</odoo>