<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- IEP Plan Action -->
    <record id="action_educare_iep_plan" model="ir.actions.act_window">
        <field name="name">IEP Plans</field>
        <field name="res_model">educare.iep.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_educare_iep_plan_search" />
        <field name="context">{
            'search_default_filter_active': 1,
            }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first IEP plan
            </p>
            <p>An IEP plan contains approval workflow and groups long-term goals by period.</p>
        </field>
    </record>

    <!-- Goal Action: Tree, Form, Kanban, Graph -->
    <record id="action_educare_iep_goal" model="ir.actions.act_window">
        <field name="name">Long-term Goals</field>
        <field name="res_model">educare.iep.goal</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="search_view_id" ref="view_educare_iep_goal_search" />
        <field name="context">{
            'search_default_filter_active': 1,
            'search_default_filter_active_plan': 1,
            }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first long-term IEP goal
            </p>
            <p>Build SMART goals for students by development domain.</p>
        </field>
    </record>

    <record id="action_educare_iep_goal_form" model="ir.actions.act_window">
        <field name="name">Long-term Goal</field>
        <field name="res_model">educare.iep.goal</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_educare_iep_goal_form" />
    </record>

    <!-- Goal Kanban Action (dedicated for IEP Kanban menu) -->
    <record id="action_educare_iep_goal_kanban" model="ir.actions.act_window">
        <field name="name">Kanban IEP</field>
        <field name="res_model">educare.iep.goal</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_educare_iep_goal_search" />
        <field name="context">{
            'search_default_filter_active': 1,
            'group_by': 'goal_domain_id'
            }</field>
    </record>

    <!-- Objective Action: Tree and Form -->
    <record id="action_educare_iep_objective" model="ir.actions.act_window">
        <field name="name">Short-term Objectives</field>
        <field name="res_model">educare.iep.objective</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_educare_iep_objective_search" />
        <field name="context">{
            'search_default_filter_active': 1,
            }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first short-term objective
            </p>
            <p>Objectives are linked to goals and used for detailed progress tracking.</p>
        </field>
    </record>

    <record id="action_educare_iep_objective_form" model="ir.actions.act_window">
        <field name="name">Short-term Objective</field>
        <field name="res_model">educare.iep.objective</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_educare_iep_objective_form" />
    </record>

    <record id="action_educare_goal_quick_wizard" model="ir.actions.act_window">
        <field name="name">Add Goal</field>
        <field name="res_model">educare.iep.goal.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_educare_iep_goal_quick_wizard_form" />
        <field name="target">new</field>
    </record>

    <record id="action_educare_objective_quick_wizard" model="ir.actions.act_window">
        <field name="name">Add Objective</field>
        <field name="res_model">educare.iep.objective.quick.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_educare_iep_objective_quick_wizard_form" />
        <field name="target">new</field>
    </record>
</odoo>