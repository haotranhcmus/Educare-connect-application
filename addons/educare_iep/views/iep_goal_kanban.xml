<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_educare_iep_goal_kanban" model="ir.ui.view">
        <field name="name">educare.iep.goal.kanban</field>
        <field name="model">educare.iep.goal</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" quick_create="0">
                <field name="name" />
                <field name="goal_code" />
                <field name="goal_domain_id" />
                <field name="plan_id" />
                <field name="student_id" />
                <field name="assigned_teacher_id" />
                <field name="progress_pct" />
                <field name="status" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="goal_domain_id" widget="badge" />
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="mb-1">
                                        <field name="name" />
                                    </div>
                                    <div>
                                        <field name="student_id" />
                                    </div>
                                    <div>
                                        <field name="plan_id" />
                                    </div>
                                    <div>
                                        <field name="assigned_teacher_id" />
                                    </div>
                                    <div class="mt-2">
                                        <field name="progress_pct"
                                            widget="progressbar" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>