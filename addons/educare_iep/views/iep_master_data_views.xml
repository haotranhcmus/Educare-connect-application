    <record id="action_iep_prompt_level" model="ir.actions.act_window">
        <field name="name">Prompt Levels</field>
        <field name="res_model">educare.iep.prompt.level</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define prompt/support levels (Independent, Verbal, Gestural, etc.)
            </p>
        </field>
    </record>

