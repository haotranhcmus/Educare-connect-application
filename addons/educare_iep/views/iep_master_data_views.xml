<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================= -->
    <!-- ASSESSMENT FRAMEWORK                              -->
    <!-- ================================================= -->
    <record id="view_iep_framework_form" model="ir.ui.view">
        <field name="name">educare.iep.framework.form</field>
        <field name="model">educare.iep.framework</field>
        <field name="arch" type="xml">
            <form string="Assessment Framework">
                <sheet>
                    <group>
                        <group string="Identity">
                            <field name="name" />
                            <field name="code" />
                            <field name="sequence" />
                            <field name="active" />
                        </group>
                    </group>
                    <group>
                        <field name="description" colspan="2" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_iep_framework_tree" model="ir.ui.view">
        <field name="name">educare.iep.framework.tree</field>
        <field name="model">educare.iep.framework</field>
        <field name="arch" type="xml">
            <tree string="Assessment Frameworks" decoration-muted="active == False">
                <field name="active" column_invisible="1" />
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="description" optional="show" />
            </tree>
        </field>
    </record>

    <record id="action_iep_framework" model="ir.actions.act_window">
        <field name="name">Assessment Frameworks</field>
        <field name="res_model">educare.iep.framework</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add an assessment framework (VB-MAPP, ABLLS-R, ICF...)
            </p>
        </field>
    </record>

    <!-- ================================================= -->
    <!-- PROMPT LEVELS                                     -->
    <!-- ================================================= -->
    <record id="view_iep_prompt_level_form" model="ir.ui.view">
        <field name="name">educare.iep.prompt.level.form</field>
        <field name="model">educare.iep.prompt.level</field>
        <field name="arch" type="xml">
            <form string="Prompt Level">
                <sheet>
                    <group>
                        <group string="Identity">
                            <field name="name" />
                            <field name="code" />
                            <field name="sequence" />
                            <field name="active" />
                        </group>
                    </group>
                    <group>
                        <field name="description" colspan="2" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_iep_prompt_level_tree" model="ir.ui.view">
        <field name="name">educare.iep.prompt.level.tree</field>
        <field name="model">educare.iep.prompt.level</field>
        <field name="arch" type="xml">
            <tree string="Prompt Levels"
                decoration-muted="active == False">
                <field name="active" column_invisible="1" />
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="description" optional="show" />
            </tree>
        </field>
    </record>

    <record id="action_iep_prompt_level" model="ir.actions.act_window">
        <field name="name">Prompt Levels</field>
        <field name="res_model">educare.iep.prompt.level</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add prompt support levels (Independent, Verbal, Gestural...)
            </p>
        </field>
    </record>

    <!-- ================================================= -->
    <!-- PROBE METHODS                                     -->
    <!-- ================================================= -->
    <record id="view_iep_probe_method_form" model="ir.ui.view">
        <field name="name">educare.iep.probe.method.form</field>
        <field name="model">educare.iep.probe.method</field>
        <field name="arch" type="xml">
            <form string="Probe Method">
                <sheet>
                    <group>
                        <group string="Identity">
                            <field name="name" />
                            <field name="code" />
                            <field name="sequence" />
                            <field name="active" />
                        </group>
                    </group>
                    <group>
                        <field name="description" colspan="2" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_iep_probe_method_tree" model="ir.ui.view">
        <field name="name">educare.iep.probe.method.tree</field>
        <field name="model">educare.iep.probe.method</field>
        <field name="arch" type="xml">
            <tree string="Probe Methods"
                decoration-muted="active == False">
                <field name="active" column_invisible="1" />
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="description" optional="show" />
            </tree>
        </field>
    </record>

    <record id="action_iep_probe_method" model="ir.actions.act_window">
        <field name="name">Probe Methods</field>
        <field name="res_model">educare.iep.probe.method</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add data collection probe methods
            </p>
        </field>
    </record>

    <!-- ================================================= -->
    <!-- PRIORITY LEVELS                                   -->
    <!-- ================================================= -->
    <record id="view_iep_priority_form" model="ir.ui.view">
        <field name="name">educare.iep.priority.form</field>
        <field name="model">educare.iep.priority</field>
        <field name="arch" type="xml">
            <form string="Priority Level">
                <sheet>
                    <group>
                        <group string="Identity">
                            <field name="name" />
                            <field name="code" />
                            <field name="sequence" />
                            <field name="color" widget="color_picker" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_iep_priority_tree" model="ir.ui.view">
        <field name="name">educare.iep.priority.tree</field>
        <field name="model">educare.iep.priority</field>
        <field name="arch" type="xml">
            <tree string="Priority Levels"
                decoration-muted="active == False">
                <field name="active" column_invisible="1" />
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="color" widget="color" />
            </tree>
        </field>
    </record>

    <record id="action_iep_priority" model="ir.actions.act_window">
        <field name="name">Priority Levels</field>
        <field name="res_model">educare.iep.priority</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define goal priority levels (Low, Medium, High...)
            </p>
        </field>
    </record>

    <!-- ================================================= -->
    <!-- MEASUREMENT TEMPLATES                            -->
    <!-- ================================================= -->
    <record id="view_iep_measurement_template_form" model="ir.ui.view">
        <field name="name">educare.iep.measurement.template.form</field>
        <field name="model">educare.iep.measurement.template</field>
        <field name="arch" type="xml">
            <form string="Measurement Template">
                <sheet>
                    <group>
                        <group string="Identity">
                            <field name="name" />
                            <field name="code" />
                            <field name="sequence" />
                            <field name="active" />
                        </group>
                    </group>
                    <group>
                        <field name="criteria_template" />
                        <field name="condition_template" />
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_iep_measurement_template_tree" model="ir.ui.view">
        <field name="name">educare.iep.measurement.template.tree</field>
        <field name="model">educare.iep.measurement.template</field>
        <field name="arch" type="xml">
            <tree string="Measurement Templates" decoration-muted="active == False">
                <field name="active" column_invisible="1" />
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="criteria_template" optional="show" />
                <field name="condition_template" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="action_iep_measurement_template" model="ir.actions.act_window">
        <field name="name">Measurement Templates</field>
        <field name="res_model">educare.iep.measurement.template</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add reusable templates for measurement criteria and conditions.
            </p>
        </field>
    </record>

</odoo>