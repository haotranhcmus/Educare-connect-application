        <field name="name">Muc tieu ngan han IEP: Tu dong dong bo trang thai</field>
        <field name="model_id" ref="model_educare_iep_objective" />
        <field name="state">code</field>
        <field name="code">model.cron_auto_sync_objective_status()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
