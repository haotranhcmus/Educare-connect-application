<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_educare_iep_goal" model="ir.sequence">
            <field name="name">Educare IEP Goal Sequence</field>
            <field name="code">educare.iep.goal</field>
            <field name="prefix">LTG-%(year)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_educare_iep_objective" model="ir.sequence">
            <field name="name">Educare IEP Objective Sequence</field>
            <field name="code">educare.iep.objective</field>
            <field name="prefix">STO-%(year)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>