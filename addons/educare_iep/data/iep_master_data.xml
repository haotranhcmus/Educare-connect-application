<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <!-- ============================= -->
    <!-- Assessment Framework Records  -->
    <!-- ============================= -->
    <record id="framework_vbmapp" model="educare.iep.framework">
        <field name="name">VB-MAPP</field>
        <field name="code">vbmapp</field>
        <field name="description">Verbal Behavior Milestones Assessment and Placement Program</field>
        <field name="sequence">10</field>
    </record>

    <record id="framework_ablls_r" model="educare.iep.framework">
        <field name="name">ABLLS-R</field>
        <field name="code">ablls_r</field>
        <field name="description">Assessment of Basic Language and Learning Skills - Revised</field>
        <field name="sequence">20</field>
    </record>

    <record id="framework_icf" model="educare.iep.framework">
        <field name="name">ICF (WHO)</field>
        <field name="code">icf</field>
        <field name="description">International Classification of Functioning, Disability and Health
            (World Health Organization)</field>
        <field name="sequence">30</field>
    </record>

    <record id="framework_custom" model="educare.iep.framework">
        <field name="name">Custom</field>
        <field name="code">custom</field>
        <field name="description">Center-defined custom framework</field>
        <field name="sequence">99</field>
    </record>

    <!-- ============================= -->
    <!-- Prompt Support Levels         -->
    <!-- ============================= -->
    <record id="prompt_independent" model="educare.iep.prompt.level">
        <field name="name">Independent</field>
        <field name="code">independent</field>
        <field name="description">Student performs the skill without any prompting</field>
        <field name="sequence">10</field>
    </record>

    <record id="prompt_verbal" model="educare.iep.prompt.level">
        <field name="name">Verbal Prompt</field>
        <field name="code">verbal_prompt</field>
        <field name="description">Teacher provides verbal cues or spoken instructions</field>
        <field name="sequence">20</field>
    </record>

    <record id="prompt_gestural" model="educare.iep.prompt.level">
        <field name="name">Gestural Prompt</field>
        <field name="code">gestural_prompt</field>
        <field name="description">Teacher uses gestures, pointing, or visual cues</field>
        <field name="sequence">30</field>
    </record>

    <record id="prompt_partial_physical" model="educare.iep.prompt.level">
        <field name="name">Partial Physical Assist</field>
        <field name="code">partial_physical</field>
        <field name="description">Light physical guidance to initiate the behavior</field>
        <field name="sequence">40</field>
    </record>

    <record id="prompt_full_physical" model="educare.iep.prompt.level">
        <field name="name">Full Physical Assist</field>
        <field name="code">full_physical</field>
        <field name="description">Hand-over-hand full physical guidance</field>
        <field name="sequence">50</field>
    </record>

    <!-- ============================= -->
    <!-- Data Collection Probe Methods -->
    <!-- ============================= -->
    <record id="probe_daily" model="educare.iep.probe.method">
        <field name="name">Daily Probe</field>
        <field name="code">daily_probe</field>
        <field name="description">Data collected at every session</field>
        <field name="sequence">10</field>
    </record>

    <record id="probe_weekly" model="educare.iep.probe.method">
        <field name="name">Weekly Probe</field>
        <field name="code">weekly_probe</field>
        <field name="description">Data collected once per week (probe session)</field>
        <field name="sequence">20</field>
    </record>

    <record id="probe_mixed" model="educare.iep.probe.method">
        <field name="name">Mixed</field>
        <field name="code">mixed</field>
        <field name="description">Combination of daily teaching trials and weekly probes</field>
        <field name="sequence">30</field>
    </record>

    <!-- ============================= -->
    <!-- Measurement Templates         -->
    <!-- ============================= -->
    <record id="measurement_template_accuracy_trials" model="educare.iep.measurement.template">
        <field name="name">Accuracy by Trials</field>
        <field name="code">accuracy_trials</field>
        <field name="criteria_template">Accuracy rate = correct responses / total opportunities
            (trials) per session.</field>
        <field name="condition_template">During DTT session, with maximum prompting per intervention
            plan.</field>
        <field name="description">Suitable for new skill acquisition goals requiring standardized
            trial-based measurement.</field>
        <field name="sequence">10</field>
    </record>

    <record id="measurement_template_frequency_count" model="educare.iep.measurement.template">
        <field name="name">Frequency Count</field>
        <field name="code">frequency_count</field>
        <field name="criteria_template">Count frequency of target behavior within defined session
            duration.</field>
        <field name="condition_template">During structured learning activities and guided play
            activities.</field>
        <field name="description">Suitable for behavior reduction/increase goals requiring frequency
            occurrence tracking.</field>
        <field name="sequence">20</field>
    </record>

    <record id="measurement_template_duration_recording" model="educare.iep.measurement.template">
        <field name="name">Duration Recording</field>
        <field name="code">duration_recording</field>
        <field name="criteria_template">Measure total duration of target behavior maintained per
            session.</field>
        <field name="condition_template">During NET sessions or small group activities, recorded
            with a stopwatch.</field>
        <field name="description">Suitable for goals extending attention duration, seated learning,
            or activity participation.</field>
        <field name="sequence">30</field>
    </record>

</odoo>