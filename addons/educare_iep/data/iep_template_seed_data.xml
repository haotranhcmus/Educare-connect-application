<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Mẫu STO: Giao tiếp - yêu cầu 1 từ -->
        <record id="tpl_obj_comm_request_1w" model="educare.iep.objective.template">
            <field name="template_domain_ids"
                eval="[(6, 0, [ref('educare_base.domain_communication')])]" />
            <field name="sequence">10</field>
            <field name="name">Yêu cầu đồ vật yêu thích bằng 1 từ</field>
            <field name="description">Trẻ nói 1 từ để yêu cầu đồ vật/hoạt động mong muốn trong tình huống có động lực.</field>
            <field name="smart_specific">Sử dụng 1 từ chức năng để yêu cầu.</field>
            <field name="smart_measurable">Đạt >= 80% trong 3 buổi liên tiếp.</field>
            <field name="smart_analysis">Phù hợp mức hiện tại, là nền tảng cho giao tiếp xã hội.</field>
            <field name="smart_timebound">8 tuần</field>
            <field name="default_baseline_accuracy_pct">15</field>
            <field name="default_target_accuracy_pct">80</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">18</field>
            <field name="age_max_months">48</field>
            <field name="difficulty_id" ref="difficulty_weight_1" />
        </record>

        <!-- Mẫu STO: Giao tiếp - yêu cầu 2 từ (prompt_level, target=gestural_visual=75) -->
        <record id="tpl_obj_comm_request_2w" model="educare.iep.objective.template">
            <field name="template_domain_ids"
                eval="[(6, 0, [ref('educare_base.domain_communication')])]" />
            <field name="sequence">20</field>
            <field name="name">Kết hợp 2 từ để yêu cầu</field>
            <field name="default_measurement_type">prompt_level</field>
            <field name="default_target_prompt_level">gestural_visual</field>
            <field name="description">Trẻ sử dụng cụm từ chức năng 2 từ (ví dụ: “muốn bánh”, “mở hộp”).</field>
            <field name="smart_specific">Dùng cụm 2 từ trong bối cảnh NET và DTT.</field>
            <field name="smart_measurable">Đạt >= 70% trong 3 buổi liên tiếp.</field>
            <field name="smart_analysis">Tăng dần độ dài câu sau khi ổn định mức 1 từ.</field>
            <field name="smart_timebound">12 tuần</field>
            <field name="default_baseline_accuracy_pct">0</field>
            <field name="default_target_accuracy_pct">75</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">24</field>
            <field name="age_max_months">60</field>
            <field name="difficulty_id" ref="difficulty_weight_2" />
        </record>

        <!-- Mẫu STO: Hành vi - ngồi học -->
        <record id="tpl_obj_behavior_sit" model="educare.iep.objective.template">
            <field name="template_domain_ids" eval="[(6, 0, [ref('educare_base.domain_behavior')])]" />
            <field name="sequence">10</field>
            <field name="name">Ngồi yên 5 phút liên tục</field>
            <field name="default_measurement_type">duration</field>
            <field name="default_target_duration_seconds">300</field>
            <field name="description">Trẻ duy trì tư thế ngồi, không rời khỏi ghế trong buổi học có cấu trúc.</field>
            <field name="smart_specific">Duy trì vị trí ngồi tối thiểu 5 phút.</field>
            <field name="smart_measurable">Đạt 4/5 buổi mỗi tuần, duy trì trong 2 tuần.</field>
            <field name="smart_analysis">Tăng khả năng tham gia nhiệm vụ và giảm hành vi trốn tránh.</field>
            <field name="smart_timebound">6 tuần</field>
            <field name="default_baseline_accuracy_pct">20</field>
            <field name="default_target_accuracy_pct">80</field>
            <field name="default_consecutive_sessions">4</field>
            <field name="age_min_months">24</field>
            <field name="age_max_months">72</field>
            <field name="difficulty_id" ref="difficulty_weight_2" />
        </record>

        <!-- Mẫu STO: Nhận thức - phân loại -->
        <record id="tpl_obj_cognitive_sort_3groups" model="educare.iep.objective.template">
            <field name="template_domain_ids"
                eval="[(6, 0, [ref('educare_base.domain_cognitive')])]" />
            <field name="sequence">10</field>
            <field name="name">Phân loại đồ vật vào 3 nhóm</field>
            <field name="description">Trẻ phân loại thẻ vào các nhóm: thực ăn, đồ chơi, quần áo.</field>
            <field name="smart_specific">Phân loại đúng vào 3 nhóm với bộ 10 vật phẩm ngẫu nhiên.</field>
            <field name="smart_measurable">Đạt >= 80% trong 3 buổi liên tiếp.</field>
            <field name="smart_analysis">Nền tảng cho kỹ năng khái niệm và ngôn ngữ học tập.</field>
            <field name="smart_timebound">10 tuần</field>
            <field name="default_baseline_accuracy_pct">30</field>
            <field name="default_target_accuracy_pct">80</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">30</field>
            <field name="age_max_months">72</field>
            <field name="difficulty_id" ref="difficulty_weight_3" />
        </record>

        <!-- ═══ DOMAIN: XÃ HỐI ═══ -->

        <!-- Mẫu STO: Xã hội - bắt chước hành động đơn giản -->
        <record id="tpl_obj_social_imitate_action" model="educare.iep.objective.template">
            <field name="template_domain_ids" eval="[(6, 0, [ref('educare_base.domain_social')])]" />
            <field name="sequence">10</field>
            <field name="name">Bắt chước hành động đơn giản của người lớn</field>
            <field name="default_measurement_type">prompt_level</field>
            <field name="default_target_prompt_level">independent</field>
            <field name="description">Trẻ quan sát và bắt chước lại hành động đơn giản (ví dụ: vỗ tay, vẫy tay, gõ bàn) trong tình huống chơi tương tác.</field>
            <field name="smart_specific">Bắt chước 1 hành động đơn giản ngay sau khi được chứng minh.</field>
            <field name="smart_measurable">Đạt >= 80% trong 3 buổi liên tiếp.</field>
            <field name="smart_analysis">Bắt chước là nền tảng của học hỏi xã hội và ngôn ngữ.</field>
            <field name="smart_timebound">8 tuần</field>
            <field name="default_baseline_accuracy_pct">25</field>
            <field name="default_target_accuracy_pct">100</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">18</field>
            <field name="age_max_months">48</field>
            <field name="difficulty_id" ref="difficulty_weight_1" />
        </record>

        <!-- Mẫu STO: Xã hội - luân phiên chơi -->
        <record id="tpl_obj_social_turn_taking" model="educare.iep.objective.template">
            <field name="template_domain_ids" eval="[(6, 0, [ref('educare_base.domain_social')])]" />
            <field name="sequence">20</field>
            <field name="name">Luân phiên chơi 2 lượt với bạn cùng tuổi</field>
            <field name="default_measurement_type">prompt_level</field>
            <field name="default_target_prompt_level">gestural_visual</field>
            <field name="description">Trẻ có thể chờ đợi lượt của mình và chuyển đồ chơi cho bạn trong trò chơi có cấu trúc.</field>
            <field name="smart_specific">Chờ đợi và chuyển đồ chơi đúng lượt trong 2 lượt liên tiếp.</field>
            <field name="smart_measurable">Đạt 4/5 buổi, không cần nhắc nhở sau 2 tuần.</field>
            <field name="smart_analysis">Luân phiên là kỹ năng xã hội cơ bản cho giao tiếp nhóm.</field>
            <field name="smart_timebound">10 tuần</field>
            <field name="default_baseline_accuracy_pct">25</field>
            <field name="default_target_accuracy_pct">75</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">30</field>
            <field name="age_max_months">72</field>
            <field name="difficulty_id" ref="difficulty_weight_2" />
        </record>

        <!-- Mẫu STO: Xã hội - chủ động đến gần bạn -->
        <record id="tpl_obj_social_initiate_peer" model="educare.iep.objective.template">
            <field name="template_domain_ids" eval="[(6, 0, [ref('educare_base.domain_social')])]" />
            <field name="sequence">30</field>
            <field name="name">Tự chủ động đến gần bạn để chơi chung</field>
            <field name="default_measurement_type">frequency_increase</field>
            <field name="default_baseline_count">0</field>
            <field name="default_target_count">3</field>
            <field name="description">Trẻ tự mình tiếp cận bạn cùng tuổi, đưa đồ chơi hoặc gọi tên bạn để bắt đầu chơi.</field>
            <field name="smart_specific">Chủ động tiếp cận bạn ít nhất 1 lần trong giờ chơi tự do.</field>
            <field name="smart_measurable">Xảy ra trong 4/5 buổi trong 2 tuần liên tiếp.</field>
            <field name="smart_analysis">Tăng khả năng khởi xướng tương tác là mục tiêu xã hội quan trọng.</field>
            <field name="smart_timebound">12 tuần</field>
            <field name="default_baseline_accuracy_pct">0</field>
            <field name="default_target_accuracy_pct">70</field>
            <field name="default_consecutive_sessions">4</field>
            <field name="age_min_months">36</field>
            <field name="age_max_months">84</field>
            <field name="difficulty_id" ref="difficulty_weight_3" />
        </record>

        <!-- ═══ DOMAIN: VẬN ĐỘNG THÔ ═══ -->

        <!-- Mẫu STO: Vận động thô - nhảy 2 chân -->
        <record id="tpl_obj_motor_gross_jump" model="educare.iep.objective.template">
            <field name="template_domain_ids"
                eval="[(6, 0, [ref('educare_base.domain_motor_gross')])]" />
            <field name="sequence">10</field>
            <field name="name">Nhảy 2 chân tại chỗ không có tay vịt</field>
            <field name="description">Trẻ nhảy lên và hạ xuống bằng cả 2 chân đồng thời, giữ thăng bằng trong 3 giây sau khi hạ.</field>
            <field name="smart_specific">Nhảy 2 chân liên tiếp 5 cái mà không nghỉ.</field>
            <field name="smart_measurable">Đạt 4/5 thử từ 3 buổi liên tiếp.</field>
            <field name="smart_analysis">Nhảy 2 chân là mốc vận động thô quan trọng, hỗ trợ kỹ năng thể chất và tự tin.</field>
            <field name="smart_timebound">8 tuần</field>
            <field name="default_baseline_accuracy_pct">20</field>
            <field name="default_target_accuracy_pct">80</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">24</field>
            <field name="age_max_months">60</field>
            <field name="difficulty_id" ref="difficulty_weight_2" />
        </record>

        <!-- Mẫu STO: Vận động thô - leo cầu thang -->
        <record id="tpl_obj_motor_gross_stairs" model="educare.iep.objective.template">
            <field name="template_domain_ids"
                eval="[(6, 0, [ref('educare_base.domain_motor_gross')])]" />
            <field name="sequence">20</field>
            <field name="name">Leo xuống cầu thang xen kế chân</field>
            <field name="default_measurement_type">prompt_level</field>
            <field name="default_target_prompt_level">independent</field>
            <field name="description">Trẻ lên và xuống cầu thang bằng cách xen kế chân trái - phải (không đếm hai chân cùng một bậc), có tay vịt.</field>
            <field name="smart_specific">Leo xuống 5 bậc cầu thang xen kế chân không cần hỗ trợ thể chất.</field>
            <field name="smart_measurable">Đạt 4/5 thử từ 2 buổi liên tiếp.</field>
            <field name="smart_analysis">Xen kế chân leo cầu thang thể hiện sự phát triển phối hợp vận động thô.</field>
            <field name="smart_timebound">10 tuần</field>
            <field name="default_baseline_accuracy_pct">25</field>
            <field name="default_target_accuracy_pct">100</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">36</field>
            <field name="age_max_months">72</field>
            <field name="difficulty_id" ref="difficulty_weight_3" />
        </record>

        <!-- Mẫu STO: Vận động thô - ném bắt bóng -->
        <record id="tpl_obj_motor_gross_ball" model="educare.iep.objective.template">
            <field name="template_domain_ids"
                eval="[(6, 0, [ref('educare_base.domain_motor_gross')])]" />
            <field name="sequence">30</field>
            <field name="name">Ném và bắt bóng với người khác từ khoảng cách 1.5m</field>
            <field name="description">Trẻ ném bóng 2 tay về phía đối phương và đưa 2 tay để bắt bóng đến.</field>
            <field name="smart_specific">Ném đúng hướng và bắt bóng không để rơi trong 3/5 lần thử.</field>
            <field name="smart_measurable">Đạt 3/5 lần trong 3 buổi liên tiếp.</field>
            <field name="smart_analysis">Ném bắt bóng phát triển phối hợp mắt-tay và tương tác xã hội.</field>
            <field name="smart_timebound">8 tuần</field>
            <field name="default_baseline_accuracy_pct">20</field>
            <field name="default_target_accuracy_pct">60</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">36</field>
            <field name="age_max_months">72</field>
            <field name="difficulty_id" ref="difficulty_weight_2" />
        </record>

        <!-- ═══ DOMAIN: VẬN ĐỘNG TINH ═══ -->

        <!-- Mẫu STO: Vận động tinh - xử lý đồ vật -->
        <record id="tpl_obj_motor_fine_pinch" model="educare.iep.objective.template">
            <field name="template_domain_ids"
                eval="[(6, 0, [ref('educare_base.domain_motor_fine')])]" />
            <field name="sequence">10</field>
            <field name="name">Kẹp vật nhỏ bằng 2 ngón (nip cầm)</field>
            <field name="description">Trẻ sử dụng ngón trỏ và ngón cái để kẹp và đặt vật thể nhỏ (hạt bắp, khối nhựa nhỏ) vào hộp.</field>
            <field name="smart_specific">Kẹp và đặt thành công vật thể nhỏ vào hộp trong 8/10 lần thử.</field>
            <field name="smart_measurable">Đạt 8/10 lần thử trong 3 buổi liên tiếp.</field>
            <field name="smart_analysis">Nip cầm là cơ sở của viết, tô màu và các kỹ năng tinh tế.</field>
            <field name="smart_timebound">8 tuần</field>
            <field name="default_baseline_accuracy_pct">20</field>
            <field name="default_target_accuracy_pct">80</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">18</field>
            <field name="age_max_months">48</field>
            <field name="difficulty_id" ref="difficulty_weight_1" />
        </record>

        <!-- Mẫu STO: Vận động tinh - vẽ đường thẳng -->
        <record id="tpl_obj_motor_fine_draw_line" model="educare.iep.objective.template">
            <field name="template_domain_ids"
                eval="[(6, 0, [ref('educare_base.domain_motor_fine')])]" />
            <field name="sequence">20</field>
            <field name="name">Vẽ đường thẳng ngang theo mẫu</field>
            <field name="description">Trẻ cầm bút đúng cách và vẽ đường thẳng ngang liên tục trong phạm vi 2cm so với mẫu.</field>
            <field name="smart_specific">Vẽ đường thẳng lệch không quá 2cm so với đường mẫu.</field>
            <field name="smart_measurable">Đạt 4/5 thử trong 3 buổi liên tiếp.</field>
            <field name="smart_analysis">Vẽ đường thẳng theo mẫu là bước tiến tới kỹ năng viết và tô màu.</field>
            <field name="smart_timebound">8 tuần</field>
            <field name="default_baseline_accuracy_pct">20</field>
            <field name="default_target_accuracy_pct">80</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">30</field>
            <field name="age_max_months">60</field>
            <field name="difficulty_id" ref="difficulty_weight_2" />
        </record>

        <!-- Mẫu STO: Vận động tinh - cắt bằng kéo -->
        <record id="tpl_obj_motor_fine_scissors" model="educare.iep.objective.template">
            <field name="template_domain_ids"
                eval="[(6, 0, [ref('educare_base.domain_motor_fine')])]" />
            <field name="sequence">30</field>
            <field name="name">Cắt theo đường kẻ bằng kéo con</field>
            <field name="default_measurement_type">prompt_level</field>
            <field name="default_target_prompt_level">gestural_visual</field>
            <field name="description">Trẻ cầm kéo bằng tay thuận, mở và nhíp kéo để cắt theo đường kẻ thẳng.</field>
            <field name="smart_specific">Cắt đường thẳng dài 10cm, lệch không quá 5mm so với đường kẻ.</field>
            <field name="smart_measurable">Đạt 3/5 thử trong 3 buổi liên tiếp.</field>
            <field name="smart_analysis">Cắt theo đường kẻ thể hiện sự phát triển của kỹ năng vận động tinh phối hợp.</field>
            <field name="smart_timebound">10 tuần</field>
            <field name="default_baseline_accuracy_pct">25</field>
            <field name="default_target_accuracy_pct">75</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">42</field>
            <field name="age_max_months">72</field>
            <field name="difficulty_id" ref="difficulty_weight_3" />
        </record>

        <!-- ═══ DOMAIN: TỰ PHỤC VỤ ═══ -->

        <!-- Mẫu STO: Tự phục vụ - tự mặc quần áo -->
        <record id="tpl_obj_self_care_dress" model="educare.iep.objective.template">
            <field name="template_domain_ids"
                eval="[(6, 0, [ref('educare_base.domain_self_care')])]" />
            <field name="sequence">10</field>
            <field name="name">Tự mặc quần và áo thun không cần hỗ trợ</field>
            <field name="default_measurement_type">prompt_level</field>
            <field name="default_target_prompt_level">independent</field>
            <field name="description">Trẻ tự kéo quần lên và mặc áo thun qua đầu rồi chỉnh lại cho phẳng, không cần trợ giúp thể chất.</field>
            <field name="smart_specific">Hoàn thành cả 2 bước (quần và áo) trong 10 phút mà không cần ký hiệu hoặc hỗ trợ thể chất.</field>
            <field name="smart_measurable">Đạt 4/5 buổi trong 2 tuần liên tiếp.</field>
            <field name="smart_analysis">Mặc đồ độc lập là kỹ năng tự phục vụ cơ bản ảnh hưởng đến tự tin và sinh hoạt hàng ngày.</field>
            <field name="smart_timebound">12 tuần</field>
            <field name="default_baseline_accuracy_pct">25</field>
            <field name="default_target_accuracy_pct">100</field>
            <field name="default_consecutive_sessions">4</field>
            <field name="age_min_months">36</field>
            <field name="age_max_months">72</field>
            <field name="difficulty_id" ref="difficulty_weight_2" />
        </record>

        <!-- Mẫu STO: Tự phục vụ - rửa tay đúng cách -->
        <record id="tpl_obj_self_care_handwash" model="educare.iep.objective.template">
            <field name="template_domain_ids"
                eval="[(6, 0, [ref('educare_base.domain_self_care')])]" />
            <field name="sequence">20</field>
            <field name="name">Rửa tay 5 bước đúng quy trình</field>
            <field name="description">Trẻ thực hiện đúng thứ tự: mở vòi, ướt tay, xà phòng, chày tay 20 giây, xả, lau khô.</field>
            <field name="smart_specific">Hoàn thành 5/6 bước đúng thứ tự mà không cần nhắc nhở.</field>
            <field name="smart_measurable">Đạt 4/5 buổi trong 2 tuần liên tiếp.</field>
            <field name="smart_analysis">Rửa tay đúng cách bảo vệ sức khỏe và là kỹ năng tự phục vụ thiết yếu.</field>
            <field name="smart_timebound">8 tuần</field>
            <field name="default_baseline_accuracy_pct">30</field>
            <field name="default_target_accuracy_pct">85</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">30</field>
            <field name="age_max_months">72</field>
            <field name="difficulty_id" ref="difficulty_weight_1" />
        </record>

        <!-- Mẫu STO: Tự phục vụ - ăn cơm bằng muỗng -->
        <record id="tpl_obj_self_care_spoon" model="educare.iep.objective.template">
            <field name="template_domain_ids"
                eval="[(6, 0, [ref('educare_base.domain_self_care')])]" />
            <field name="sequence">30</field>
            <field name="name">Tự xúc cơm bằng muỗng không làm đổ</field>
            <field name="default_measurement_type">prompt_level</field>
            <field name="default_target_prompt_level">independent</field>
            <field name="description">Trẻ cầm muỗng đúng cách, múc cơm và đưa lên miệng mà không làm đổ cơm ra ngoài quá nhiều.</field>
            <field name="smart_specific">Ăn hết 1 bát cơm, đổ cơm &lt;20% so với lượng ăn.</field>
            <field name="smart_measurable">Đạt 4/5 buổi ăn trong 2 tuần liên tiếp.</field>
            <field name="smart_analysis">Tự ăn là kỹ năng tự phục vụ cơ bản, tăng độc lập trong sinh hoạt gia đình.</field>
            <field name="smart_timebound">10 tuần</field>
            <field name="default_baseline_accuracy_pct">25</field>
            <field name="default_target_accuracy_pct">100</field>
            <field name="default_consecutive_sessions">4</field>
            <field name="age_min_months">24</field>
            <field name="age_max_months">60</field>
            <field name="difficulty_id" ref="difficulty_weight_1" />
        </record>

        <!-- ═══ DOMAIN: HỌC TẬP ═══ -->

        <!-- Mẫu STO: Học tập - nhận biết chữ số 1-5 -->
        <record id="tpl_obj_academic_numbers_1_5" model="educare.iep.objective.template">
            <field name="template_domain_ids" eval="[(6, 0, [ref('educare_base.domain_academic')])]" />
            <field name="sequence">10</field>
            <field name="name">Nhận biết và đọc đúng chữ số 1 đến 5</field>
            <field name="description">Trẻ chỉ đúng vào thẻ số được hỏi và đọc to số đó trong 5/5 thử.</field>
            <field name="smart_specific">Nhận biết từng số từ 1-5 khi được hỏi ngẫu nhiên.</field>
            <field name="smart_measurable">Đạt 5/5 thử trong 3 buổi liên tiếp.</field>
            <field name="smart_analysis">Nhận biết chữ số là nền tảng số học tiền học đường.</field>
            <field name="smart_timebound">10 tuần</field>
            <field name="default_baseline_accuracy_pct">30</field>
            <field name="default_target_accuracy_pct">100</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">42</field>
            <field name="age_max_months">84</field>
            <field name="difficulty_id" ref="difficulty_weight_2" />
        </record>

        <!-- Mẫu STO: Học tập - phân biệt màu sắc cơ bản -->
        <record id="tpl_obj_academic_colors" model="educare.iep.objective.template">
            <field name="template_domain_ids" eval="[(6, 0, [ref('educare_base.domain_academic')])]" />
            <field name="sequence">20</field>
            <field name="name">Phân biệt và đặt tên 4 màu cơ bản</field>
            <field name="description">Trẻ chỉ đúng vào màu được gọi tên (đỏ, xanh, vàng, xanh lá) trong bộ 8 thẻ màu ngẫu nhiên.</field>
            <field name="smart_specific">Chỉ đúng 4 màu cơ bản khi được gọi tên, đúng 8/8 thử.</field>
            <field name="smart_measurable">Đạt 8/8 thử trong 3 buổi liên tiếp.</field>
            <field name="smart_analysis">Phân biệt màu sắc là kỹ năng nhận thức nền tảng cho học tập.</field>
            <field name="smart_timebound">8 tuần</field>
            <field name="default_baseline_accuracy_pct">25</field>
            <field name="default_target_accuracy_pct">100</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">30</field>
            <field name="age_max_months">72</field>
            <field name="difficulty_id" ref="difficulty_weight_1" />
        </record>

        <!-- Mẫu STO: Học tập - viết tên -->
        <record id="tpl_obj_academic_write_name" model="educare.iep.objective.template">
            <field name="template_domain_ids" eval="[(6, 0, [ref('educare_base.domain_academic')])]" />
            <field name="sequence">30</field>
            <field name="name">Viết tên mình theo mẫu chữ</field>
            <field name="default_measurement_type">prompt_level</field>
            <field name="default_target_prompt_level">gestural_visual</field>
            <field name="description">Trẻ copy tên mình (3-5 chữ cái) theo đường kẻ mờ, các chữ rõ ràng và đúng chiều.</field>
            <field name="smart_specific">Viết đủ các chữ cái trong tên, mỗi chữ không lệch quá 2 đường kẻ.</field>
            <field name="smart_measurable">Đạt 4/5 thử trong 3 buổi liên tiếp.</field>
            <field name="smart_analysis">Viết tên là kỹ năng học tập cơ bản và ảnh hưởng trực tiếp đến học đường.</field>
            <field name="smart_timebound">12 tuần</field>
            <field name="default_baseline_accuracy_pct">25</field>
            <field name="default_target_accuracy_pct">75</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">54</field>
            <field name="age_max_months">96</field>
            <field name="difficulty_id" ref="difficulty_weight_3" />
        </record>

        <!-- ═══ DOMAIN: THÍCH ỨNG ═══ -->

        <!-- Mẫu STO: Thích ứng - chuyển đổi hoạt động -->
        <record id="tpl_obj_adaptive_transition" model="educare.iep.objective.template">
            <field name="template_domain_ids" eval="[(6, 0, [ref('educare_base.domain_adaptive')])]" />
            <field name="sequence">10</field>
            <field name="name">Chuyển đổi giữa 2 hoạt động khi được báo trước 1 phút</field>
            <field name="description">Trẻ dừng hoạt động hiện tại và chuyển sang hoạt động mới trong vòng 30 giây sau khi được cảnh báo “Con còn 1 phút nữa”.</field>
            <field name="smart_specific">Chuyển đổi thành công (không khóc/ném đồ) trong 30 giây sau cảnh báo.</field>
            <field name="smart_measurable">Đạt 4/5 lần thử trong 3 buổi liên tiếp.</field>
            <field name="smart_analysis">Giảm phản ứng quá mức khi chuyển đổi giúp tăng sự linh hoạt trong sinh hoạt hàng ngày.</field>
            <field name="smart_timebound">10 tuần</field>
            <field name="default_baseline_accuracy_pct">10</field>
            <field name="default_target_accuracy_pct">80</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">24</field>
            <field name="age_max_months">84</field>
            <field name="difficulty_id" ref="difficulty_weight_2" />
        </record>

        <!-- Mau STO: Thich ung - chap nhan thay doi lich -->
        <record id="tpl_obj_adaptive_schedule_change" model="educare.iep.objective.template">
            <field name="template_domain_ids" eval="[(6, 0, [ref('educare_base.domain_adaptive')])]" />
            <field name="sequence">20</field>
            <field name="name">Chấp nhận thay đổi bất ngờ trong lịch hoạt động</field>
            <field name="description">Khi có sự thay đổi đột xuất trong lịch (ví dụ: đổi giáo viên, hủy hoạt động ưa thích), trẻ phản ứng bình tĩnh và thích nghi trong vòng 5 phút.</field>
            <field name="smart_specific">Không có hành vi bùng phát (la hét, ném đồ, tiếp tục hơn 2 phút) khi lịch thay đổi.</field>
            <field name="smart_measurable">Đạt trong 4/5 tình huống thay đổi lịch trong 2 tuần.</field>
            <field name="smart_analysis">Tăng khả năng chịu đựng sự bất định là kỹ năng thích ứng quan trọng.</field>
            <field name="smart_timebound">12 tuần</field>
            <field name="default_baseline_accuracy_pct">10</field>
            <field name="default_target_accuracy_pct">80</field>
            <field name="default_consecutive_sessions">4</field>
            <field name="age_min_months">36</field>
            <field name="age_max_months">96</field>
            <field name="difficulty_id" ref="difficulty_weight_3" />
        </record>

        <!-- Mẫu STO: Thích ứng - theo quy trình bằng hình ảnh -->
        <record id="tpl_obj_adaptive_visual_schedule" model="educare.iep.objective.template">
            <field name="template_domain_ids" eval="[(6, 0, [ref('educare_base.domain_adaptive')])]" />
            <field name="sequence">30</field>
            <field name="name">Theo lịch trình bằng hình ảnh 4 bước độc lập</field>
            <field name="default_measurement_type">prompt_level</field>
            <field name="default_target_prompt_level">gestural_visual</field>
            <field name="description">Trẻ xem bảng hình ảnh lịch trình (4 thẻ hình), tự chuyển sang bước tiếp theo sau khi hoàn thành bước trước.</field>
            <field name="smart_specific">Hoàn thành 4 bước đúng thứ tự theo bảng hình mà không cần nhắc nhở miệng.</field>
            <field name="smart_measurable">Đạt 4/5 buổi trong 2 tuần liên tiếp.</field>
            <field name="smart_analysis">Sử dụng lịch trình bằng hình là chiến lược hỗ trợ thích ứng phổ biến và hiệu quả.</field>
            <field name="smart_timebound">8 tuần</field>
            <field name="default_baseline_accuracy_pct">25</field>
            <field name="default_target_accuracy_pct">75</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">30</field>
            <field name="age_max_months">84</field>
            <field name="difficulty_id" ref="difficulty_weight_2" />
        </record>

        <!-- ═══ DOMAIN: HÀNH VI (additional) ═══ -->

        <!-- Mẫu STO: Hành vi - giảm hành vi tý nạn -->
        <record id="tpl_obj_behavior_reduce_tantrum" model="educare.iep.objective.template">
            <field name="template_domain_ids" eval="[(6, 0, [ref('educare_base.domain_behavior')])]" />
            <field name="sequence">20</field>
            <field name="name">Giảm tần suất bùng phát khi bị từ chối xuống 1 lần/buổi</field>
            <field name="default_measurement_type">frequency_decrease</field>
            <field name="default_baseline_count">5</field>
            <field name="default_target_count">1</field>
            <field name="description">Khi bị từ chối đồ vật/hoạt động mong muốn, trẻ không có bùng phát (la hét, nằn sàn) vượt quá 1 lần trong buổi học.</field>
            <field name="smart_specific">Bùng phát &lt;= 1 lần trong một buổi học 30 phút.</field>
            <field name="smart_measurable">Đạt trong 4/5 buổi trong 2 tuần liên tiếp.</field>
            <field name="smart_analysis">Giảm bùng phát tăng khả năng học tập và tương tác xã hội.</field>
            <field name="smart_timebound">8 tuần</field>
            <field name="default_baseline_accuracy_pct">0</field>
            <field name="default_target_accuracy_pct">80</field>
            <field name="default_consecutive_sessions">4</field>
            <field name="age_min_months">24</field>
            <field name="age_max_months">84</field>
            <field name="difficulty_id" ref="difficulty_weight_3" />
        </record>

        <!-- Mẫu STO: Hành vi - tự yêu cầu nghỉ -->
        <record id="tpl_obj_behavior_request_break" model="educare.iep.objective.template">
            <field name="template_domain_ids" eval="[(6, 0, [ref('educare_base.domain_behavior')])]" />
            <field name="sequence">30</field>
            <field name="name">Tự yêu cầu nghỉ bằng thẻ “Nghỉ” hoặc chữ “Nghỉ”</field>
            <field name="default_measurement_type">frequency_increase</field>
            <field name="default_baseline_count">0</field>
            <field name="default_target_count">2</field>
            <field name="description">Khi cảm thấy mệt hoặc khó chịu, trẻ chủ động lấy thẻ hình/nói từ “Nghỉ” để yêu cầu nghỉ ngơi thay vì có hành vi thách thức.</field>
            <field name="smart_specific">Sử dụng thẻ/từ “Nghỉ” để yêu cầu nghỉ ít nhất 1 lần khi có dấu hiệu mệt.</field>
            <field name="smart_measurable">Xảy ra trong 4/5 buổi có tình huống trong 2 tuần.</field>
            <field name="smart_analysis">Dạy trẻ tự yêu cầu nghỉ là chiến lược thay thế hành vi hiệu quả.</field>
            <field name="smart_timebound">8 tuần</field>
            <field name="default_baseline_accuracy_pct">0</field>
            <field name="default_target_accuracy_pct">80</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">24</field>
            <field name="age_max_months">72</field>
            <field name="difficulty_id" ref="difficulty_weight_2" />
        </record>

        <!-- ═══ DOMAIN: NHẬN THỨC (additional) ═══ -->

        <!-- Mẫu STO: Nhận thức - nhận biết kích thước -->
        <record id="tpl_obj_cognitive_size" model="educare.iep.objective.template">
            <field name="template_domain_ids"
                eval="[(6, 0, [ref('educare_base.domain_cognitive')])]" />
            <field name="sequence">20</field>
            <field name="name">Phân biệt lớn - nhỏ qua trò chơi ghép đồ vật</field>
            <field name="description">Trẻ chỉ đúng vào đồ vật lớn hơn hoặc nhỏ hơn trong cặp đồ vật được gọi tên (“Đâu là cái lớn?”).</field>
            <field name="smart_specific">Chỉ đúng trong 5/5 cặp đồ vật lớn/nhỏ ngẫu nhiên.</field>
            <field name="smart_measurable">Đạt 5/5 trong 3 buổi liên tiếp.</field>
            <field name="smart_analysis">Khái niệm kích thước là bước cần thiết trên con đường toán học và phân loại.</field>
            <field name="smart_timebound">6 tuần</field>
            <field name="default_baseline_accuracy_pct">50</field>
            <field name="default_target_accuracy_pct">100</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">24</field>
            <field name="age_max_months">60</field>
            <field name="difficulty_id" ref="difficulty_weight_2" />
        </record>

        <!-- ═══ Bổ sung: phủ thêm các loại đo lường ═══ -->

        <!-- Mẫu STO: Học tập - tập trung nhiệm vụ (DURATION) -->
        <record id="tpl_obj_academic_focus_duration" model="educare.iep.objective.template">
            <field name="template_domain_ids" eval="[(6, 0, [ref('educare_base.domain_academic')])]" />
            <field name="sequence">40</field>
            <field name="name">Tập trung vào nhiệm vụ học liên tục 10 phút</field>
            <field name="description">Trẻ duy trì sự chú ý vào một nhiệm vụ học (xếp hình, tô màu, ghép chữ) liên tục mà không rời khỏi nhiệm vụ.</field>
            <field name="default_measurement_type">duration</field>
            <field name="default_target_duration_seconds">600</field>
            <field name="smart_specific">Duy trì chú ý vào nhiệm vụ tối thiểu 10 phút (600 giây).</field>
            <field name="smart_measurable">Đạt mốc thời gian trong 3 buổi liên tiếp.</field>
            <field name="smart_analysis">Khả năng tập trung kéo dài là nền tảng cho học tập có cấu trúc.</field>
            <field name="smart_timebound">10 tuần</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">42</field>
            <field name="age_max_months">84</field>
            <field name="difficulty_id" ref="difficulty_weight_3" />
        </record>

        <!-- Mẫu STO: Giao tiếp - chủ động giơ tay/đưa mắt (FREQUENCY INCREASE) -->
        <record id="tpl_obj_comm_initiate_freq" model="educare.iep.objective.template">
            <field name="template_domain_ids" eval="[(6, 0, [ref('educare_base.domain_communication')])]" />
            <field name="sequence">30</field>
            <field name="name">Chủ động giơ tay/đưa mắt để bắt đầu giao tiếp</field>
            <field name="description">Đếm số lần trẻ tự khởi xướng giao tiếp (giơ tay, đưa mắt giao tiếp, gọi tên) trong buổi học — càng nhiều càng tốt.</field>
            <field name="default_measurement_type">frequency_increase</field>
            <field name="default_baseline_count">1</field>
            <field name="default_target_count">5</field>
            <field name="smart_specific">Khởi xướng giao tiếp tự phát nhiều lần trong buổi.</field>
            <field name="smart_measurable">Đạt >= 5 lần/buổi trong 3 buổi liên tiếp.</field>
            <field name="smart_analysis">Tăng khởi xướng giao tiếp là chỉ báo tiến bộ ngôn ngữ - xã hội.</field>
            <field name="smart_timebound">8 tuần</field>
            <field name="default_consecutive_sessions">3</field>
            <field name="age_min_months">24</field>
            <field name="age_max_months">72</field>
            <field name="difficulty_id" ref="difficulty_weight_2" />
        </record>

        <!-- Mẫu STO: Hành vi - giảm hành vi tự kích thích (FREQUENCY DECREASE) -->
        <record id="tpl_obj_behavior_reduce_stim" model="educare.iep.objective.template">
            <field name="template_domain_ids" eval="[(6, 0, [ref('educare_base.domain_behavior')])]" />
            <field name="sequence">40</field>
            <field name="name">Giảm hành vi tự kích thích (vỗ tay/lắc người) trong buổi</field>
            <field name="description">Đếm tổng số lần trẻ vỗ tay liên tục hoặc lắc lư người trong buổi học — càng ít càng tốt.</field>
            <field name="default_measurement_type">frequency_decrease</field>
            <field name="default_baseline_count">10</field>
            <field name="default_target_count">2</field>
            <field name="smart_specific">Giảm số lần hành vi tự kích thích xuống tối đa 2 lần/buổi.</field>
            <field name="smart_measurable">Đạt &lt;= 2 lần/buổi trong 4 buổi liên tiếp.</field>
            <field name="smart_analysis">Giảm hành vi tự kích thích giúp trẻ tập trung và tham gia tốt hơn.</field>
            <field name="smart_timebound">10 tuần</field>
            <field name="default_consecutive_sessions">4</field>
            <field name="age_min_months">24</field>
            <field name="age_max_months">84</field>
            <field name="difficulty_id" ref="difficulty_weight_3" />
        </record>
    </data>
</odoo>