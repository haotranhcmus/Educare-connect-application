<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_educare_iep_plan_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="plan">
                <t t-call="web.external_layout">
                    <t t-set="lang" t-value="plan.env.context.get('lang', 'en_US')" />
                    <t t-set="is_vi" t-value="lang and lang.startswith('vi')" />

                    <div class="page">
                        <style>
                            /* ════════════════════════════════════════════
                            IEP REPORT — Professional Vietnamese Print
                            Base: 10pt / 0.95rem — clean, readable
                            ════════════════════════════════════════════ */

                            /* ── Root and Reset ── */
                            .iep {
                            font-family: "Times New Roman", Times, serif;
                            font-size: 11pt;
                            line-height: 1.55;
                            color: #000;
                            }

                            /* ── Headings ── */
                            .iep h2 {
                            font-size: 15pt;
                            font-weight: 700;
                            margin: 0;
                            letter-spacing: 0.3px;
                            }
                            .iep h3 {
                            font-size: 12pt;
                            font-weight: 700;
                            margin: 0 0 3px 0;
                            }

                            /* ── Section Header ── */
                            .iep-section-title {
                            font-size: 11pt;
                            font-weight: 700;
                            text-transform: uppercase;
                            letter-spacing: 1px;
                            border-bottom: 2px solid #000;
                            padding-bottom: 3px;
                            margin: 18px 0 10px 0;
                            page-break-after: avoid;
                            }

                            /* ── Sub-section header (domain) ── */
                            .iep-domain-title {
                            font-size: 10.5pt;
                            font-weight: 700;
                            margin: 12px 0 5px 0;
                            padding: 3px 0 3px 10px;
                            page-break-after: avoid;
                            underline: 1.5px solid #000;
                            }

                            /* ── Key-Value Rows (replaces nested tables) ── */
                            .iep-fields {
                            display: table;
                            width: 100%;
                            border-collapse: collapse;
                            }
                            .iep-fields-col {
                            display: table-cell;
                            width: 50%;
                            vertical-align: top;
                            padding-right: 16px;
                            }
                            .iep-fields-col:last-child {
                            padding-right: 0;
                            padding-left: 16px;
                            }
                            .iep-field {
                            display: flex;
                            border-bottom: 1px solid #ddd;
                            padding: 5px 0;
                            gap: 8px;
                            align-items: baseline;
                            }
                            .iep-field:last-child {
                            border-bottom: none;
                            }
                            .iep-field-label {
                            font-weight: 700;
                            font-size: 10pt;
                            min-width: 140px;
                            flex-shrink: 0;
                            color: #222;
                            }
                            .iep-field-value {
                            font-size: 11pt;
                            flex: 1;
                            }

                            /* Single-column field row (for approval, etc.) */
                            .iep-field-full {
                            display: flex;
                            border-bottom: 1px solid #ddd;
                            padding: 5px 0;
                            gap: 8px;
                            align-items: baseline;
                            }
                            .iep-field-full:last-child {
                            border-bottom: none;
                            }

                            /* ── Long-term goal block ── */
                            .iep-goal {
                            border: 1.5px solid #000;
                            padding: 10px 12px;
                            margin-bottom: 12px;
                            page-break-inside: avoid;
                            }
                            .iep-goal-header {
                            font-weight: 700;
                            font-size: 11pt;
                            padding-bottom: 5px;
                            margin-bottom: 6px;
                            border-bottom: 1px solid #aaa;
                            }
                            .iep-goal-meta {
                            font-size: 10.5pt;
                            margin-bottom: 8px;
                            line-height: 1.6;
                            }

                            /* ── Objective table ── */
                            .iep-obj {
                            width: 100%;
                            border-collapse: collapse;
                            font-size: 10pt;
                            margin-top: 5px;
                            }
                            .iep-obj th,
                            .iep-obj td {
                            border: 1px solid #000;
                            padding: 5px 8px;
                            vertical-align: top;
                            }
                            .iep-obj th {
                            font-weight: 700;
                            background: #f0f0f0;
                            }
                            .iep-obj td.center {
                            text-align: center;
                            vertical-align: middle;
                            }

                            /* ── Assessment table ── */
                            .iep-asmtbl {
                            width: 100%;
                            border-collapse: collapse;
                            font-size: 10pt;
                            margin-top: 4px;
                            }
                            .iep-asmtbl th,
                            .iep-asmtbl td {
                            border: 1px solid #000;
                            padding: 5px 8px;
                            vertical-align: top;
                            }
                            .iep-asmtbl th {
                            font-weight: 700;
                            background: #f0f0f0;
                            }

                            /* ── Utilities ── */
                            .iep-block { margin-bottom: 10px; page-break-inside: avoid; }
                            .iep-center { text-align: center; }
                            .iep-muted { color: #555; font-style: italic; font-size: 10pt; }
                            .iep-divider { border: none; border-top: 1px solid #ccc; margin: 14px 0; }
                        </style>

                        <div class="iep">

                            <!-- ═══════════════════════════════════
                                 A. HEADER
                            ═══════════════════════════════════ -->
                            <div class="iep-block iep-center" style="margin-bottom: 20px;">
                                <t t-if="plan.student_center_id">
                                    <h3>
                                        <t t-esc="plan.student_center_id.name" />
                                    </h3>
                                    <div class="iep-muted"
                                        t-if="plan.student_center_id.address or plan.student_center_id.phone or plan.student_center_id.email"
                                        style="font-size:10pt; margin-bottom:4px;">
                                        <t t-if="plan.student_center_id.address">
                                            <t t-esc="plan.student_center_id.address" />
                                        </t>
                                        <t t-if="plan.student_center_id.phone"> &#160;|&#160;ĐT: <t t-esc="plan.student_center_id.phone" />
                                        </t>
                                        <t t-if="plan.student_center_id.email"> &#160;|&#160;<t t-esc="plan.student_center_id.email" />
                                        </t>
                                    </div>
                                </t>
                                <div style="margin-top: 10px;">
                                    <h2>KẾ HOẠCH GIÁO DỤC CÁ NHÂN (IEP)</h2>
                                    <div style="font-size: 11pt; margin-top: 3px;" t-field="plan.iep_period" />
                                </div>
                            </div>

                            <hr class="iep-divider" />

                            <!-- ═══════════════════════════════════
                                 B. THÔNG TIN HỌC SINH
                            ═══════════════════════════════════ -->
                            <t t-set="student" t-value="plan.student_id" />
                            <div class="iep-section-title">Thông tin học sinh</div>
                            <div class="iep-block">
                                <div class="iep-fields">
                                    <div class="iep-fields-col">
                                        <div class="iep-field">
                                            <span class="iep-field-label">Mã học sinh</span>
                                            <span class="iep-field-value">
                                                <t t-esc="student.student_code or '—'" />
                                            </span>
                                        </div>
                                        <div class="iep-field">
                                            <span class="iep-field-label">Họ và tên</span>
                                            <span class="iep-field-value">
                                                <t t-esc="student.name" />
                                            </span>
                                        </div>
                                        <div class="iep-field">
                                            <span class="iep-field-label">Ngày sinh</span>
                                            <span class="iep-field-value">
                                                <t t-if="student.date_of_birth">
                                                    <t t-if="is_vi">
                                                        <t t-esc="student.date_of_birth.strftime('%d/%m/%Y')" />
                                                    </t>
                                                    <t t-else="">
                                                        <t t-esc="student.date_of_birth" />
                                                    </t>
                                                </t>
                                                <t t-else="">—</t>
                                            </span>
                                        </div>
                                        <div class="iep-field">
                                            <span class="iep-field-label">Tuổi</span>
                                            <span class="iep-field-value">
                                                <t t-if="student.age">
                                                    <t t-esc="student.age" /> tuổi <t t-if="student.age_months">(<t t-esc="student.age_months" /> tháng)</t>
                                                </t>
                                                <t t-else="">—</t>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="iep-fields-col">
                                        <div class="iep-field">
                                            <span class="iep-field-label">Giới tính</span>
                                            <span class="iep-field-value">
                                                <t t-esc="dict(student.fields_get(['gender'])['gender']['selection']).get(student.gender, '—')" />
                                            </span>
                                        </div>
                                        <div class="iep-field">
                                            <span class="iep-field-label">Chẩn đoán chính</span>
                                            <span class="iep-field-value">
                                                <t t-esc="dict(student.fields_get(['primary_diagnosis'])['primary_diagnosis']['selection']).get(student.primary_diagnosis, '—')" />
                                            </span>
                                        </div>
                                        <div class="iep-field">
                                            <span class="iep-field-label">Trung tâm</span>
                                            <span class="iep-field-value">
                                                <t t-esc="student.center_id.name or '—'" />
                                            </span>
                                        </div>
                                        <div class="iep-field">
                                            <span class="iep-field-label">Ngày nhập học</span>
                                            <span class="iep-field-value">
                                                <t t-if="student.enrollment_date">
                                                    <t t-if="is_vi">
                                                        <t t-esc="student.enrollment_date.strftime('%d/%m/%Y')" />
                                                    </t>
                                                    <t t-else="">
                                                        <t t-esc="student.enrollment_date" />
                                                    </t>
                                                </t>
                                                <t t-else="">—</t>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ═══════════════════════════════════
                                 C. CHI TIẾT KẾ HOẠCH
                            ═══════════════════════════════════ -->
                            <div class="iep-section-title">Chi tiết kế hoạch</div>
                            <div class="iep-block">
                                <div class="iep-fields">
                                    <div class="iep-fields-col">
                                        <div class="iep-field">
                                            <span class="iep-field-label">Giáo viên phụ trách</span>
                                            <span class="iep-field-value">
                                                <t t-esc="plan.assigned_teacher_id.name or '—'" />
                                            </span>
                                        </div>
                                        <div class="iep-field">
                                            <span class="iep-field-label">Giám sát viên</span>
                                            <span class="iep-field-value">
                                                <t t-esc="plan.supervisor_id.name or '—'" />
                                            </span>
                                        </div>
                                        <div class="iep-field">
                                            <span class="iep-field-label">Phiên bản</span>
                                            <span class="iep-field-value">
                                                <t t-esc="plan.version_number" />
                                            </span>
                                        </div>
                                    </div>
                                    <div class="iep-fields-col">
                                        <div class="iep-field">
                                            <span class="iep-field-label">Ngày bắt đầu</span>
                                            <span class="iep-field-value">
                                                <t t-if="plan.start_date">
                                                    <t t-if="is_vi">
                                                        <t t-esc="plan.start_date.strftime('%d/%m/%Y')" />
                                                    </t>
                                                    <t t-else="">
                                                        <t t-esc="plan.start_date" />
                                                    </t>
                                                </t>
                                                <t t-else="">—</t>
                                            </span>
                                        </div>
                                        <div class="iep-field">
                                            <span class="iep-field-label">Ngày kết thúc</span>
                                            <span class="iep-field-value">
                                                <t t-if="plan.end_date">
                                                    <t t-if="is_vi">
                                                        <t t-esc="plan.end_date.strftime('%d/%m/%Y')" />
                                                    </t>
                                                    <t t-else="">
                                                        <t t-esc="plan.end_date" />
                                                    </t>
                                                </t>
                                                <t t-else="">—</t>
                                            </span>
                                        </div>
                                        <div class="iep-field">
                                            <span class="iep-field-label">Tần suất đánh giá</span>
                                            <span class="iep-field-value">
                                                <t t-esc="dict(plan.fields_get(['review_frequency'])['review_frequency']['selection']).get(plan.review_frequency, '—')" />
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ═══════════════════════════════════
                                 D. PHÊ DUYỆT
                            ═══════════════════════════════════ -->
                            <t t-if="plan.status != 'draft'">
                                <div class="iep-block">

                                    <div class="iep-field">
                                        <span class="iep-field-label" style="min-width: 140px;">Ngày phê duyệt</span>
                                        <span class="iep-field-value">
                                            <t t-if="plan.approved_date">
                                                <t t-if="is_vi">
                                                    <t t-esc="plan.approved_date.strftime('%d/%m/%Y')" />
                                                </t>
                                                <t t-else="">
                                                    <t t-esc="plan.approved_date" />
                                                </t>
                                            </t>
                                            <t t-else="">—</t>
                                        </span>
                                    </div>
                                </div>
                            </t>

                            <!-- ═══════════════════════════════════
                                 E. ĐÁNH GIÁ GẦN NHẤT
                            ═══════════════════════════════════ -->
                            <t t-set="latest_assessment" t-value="student.assessment_ids[:1] if student.assessment_ids else False" />
                            <t t-if="latest_assessment">
                                <div class="iep-section-title">Đánh giá gần nhất</div>
                                <div class="iep-block">
                                    <div class="iep-fields">
                                        <div class="iep-fields-col">
                                            <div class="iep-field">
                                                <span class="iep-field-label">Ngày đánh giá</span>
                                                <span class="iep-field-value">
                                                    <t t-if="latest_assessment.assessment_date">
                                                        <t t-if="is_vi">
                                                            <t t-esc="latest_assessment.assessment_date.strftime('%d/%m/%Y')" />
                                                        </t>
                                                        <t t-else="">
                                                            <t t-esc="latest_assessment.assessment_date" />
                                                        </t>
                                                    </t>
                                                    <t t-else="">—</t>
                                                </span>
                                            </div>
                                            <div class="iep-field">
                                                <span class="iep-field-label">Loại đánh giá</span>
                                                <span class="iep-field-value">
                                                    <t t-esc="dict(latest_assessment.fields_get(['assessment_type'])['assessment_type']['selection']).get(latest_assessment.assessment_type, '—')" />
                                                </span>
                                            </div>
                                            <div class="iep-field">
                                                <span class="iep-field-label">Tiến độ tổng thể</span>
                                                <span class="iep-field-value">
                                                    <t t-esc="dict(latest_assessment.fields_get(['overall_progress'])['overall_progress']['selection']).get(latest_assessment.overall_progress, '—')" />
                                                </span>
                                            </div>
                                        </div>
                                        <div class="iep-fields-col">
                                            <div class="iep-field">
                                                <span class="iep-field-label">Điểm VB-MAPP</span>
                                                <span class="iep-field-value">
                                                    <t t-esc="latest_assessment.vbmapp_score or '—'" />
                                                </span>
                                            </div>
                                            <div class="iep-field">
                                                <span class="iep-field-label">Điểm ABLLS-R</span>
                                                <span class="iep-field-value">
                                                    <t t-esc="latest_assessment.ablls_score or '—'" />
                                                </span>
                                            </div>
                                            <div class="iep-field">
                                                <span class="iep-field-label">Phân loại</span>
                                                <span class="iep-field-value">
                                                    <t t-esc="dict(latest_assessment.fields_get(['classification'])['classification']['selection']).get(latest_assessment.classification, '—')" />
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Assessment lines by domain -->
                                <t t-if="latest_assessment.line_ids">
                                    <t t-set="all_lines" t-value="latest_assessment.line_ids" />
                                    <t t-foreach="all_lines.mapped('domain_id')" t-as="domain">
                                        <div class="iep-block">
                                            <div class="iep-domain-title">
                                                <t t-esc="domain_index + 1" />. Lĩnh vực <t t-esc="domain.name" />
                                            </div>
                                            <table class="iep-asmtbl">
                                                <thead>
                                                    <tr>
                                                        <th style="width:25%;">Tiêu chí</th>
                                                        <th style="width:37.5%;">Điểm mạnh</th>
                                                        <th style="width:37.5%;">Hạn chế / Thách thức</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="all_lines.filtered(lambda l: l.domain_id.id == domain.id)" t-as="dl">
                                                        <tr>
                                                            <td>
                                                                <t t-esc="dl.item_id.name" />
                                                            </td>
                                                            <td>
                                                                <t t-esc="dl.strength_text or '—'" />
                                                            </td>
                                                            <td>
                                                                <t t-esc="dl.limitation_text or '—'" />
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </t>
                                </t>
                            </t>

                            <!-- ═══════════════════════════════════
                                 F. MỤC TIÊU DÀI HẠN
                            ═══════════════════════════════════ -->
                            <div class="iep-section-title" style="margin-top: 20px;">Mục tiêu dài hạn</div>
                            <t t-if="not plan.goal_ids">
                                <p class="iep-muted">Chưa có mục tiêu nào được thêm vào kế hoạch.</p>
                            </t>
                            <t t-foreach="plan.goal_ids" t-as="goal">
                                <div class="iep-goal">
                                    <div class="iep-goal-header">
                                        <t t-esc="goal.goal_code" />&#160;—&#160;<t t-esc="goal.name" />
                                    </div>
                                    <div class="iep-goal-meta">
                                        <strong>Lĩnh vực:</strong>&#160;<t t-esc="goal.goal_domain_id.name or '—'" />
                                        <t t-if="goal.goal_description">
                                            <br /><strong>Mô tả:</strong>&#160;<t t-esc="goal.goal_description" />
                                        </t>
                                    </div>

                                    <t t-if="goal.objective_ids">
                                        <table class="iep-obj">
                                            <thead>
                                                <tr>
                                                    <th style="width:10%;">Mã</th>
                                                    <th>Mục tiêu ngắn hạn</th>

                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="goal.objective_ids" t-as="obj">
                                                    <tr>
                                                        <td>
                                                            <t t-esc="obj.objective_code" />
                                                        </td>
                                                        <td>
                                                            <t t-esc="obj.name" />
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </t>
                                    <t t-else="">
                                        <p class="iep-muted" style="margin: 4px 0 0 0;">Chưa có mục tiêu ngắn hạn.</p>
                                    </t>
                                </div>
                            </t>

                            <!-- ═══════════════════════════════════
                                 G. CHỮ KÝ
                            ═══════════════════════════════════ -->
                            <table style="width:100%; border-collapse:collapse; margin-top:52px; page-break-inside:avoid;">
                                <tbody>
                                    <tr>
                                        <td style="width:33%; text-align:center; padding-top:44px; border-top:1.5px solid #000;">
                                            <strong>Giáo viên phụ trách</strong>
                                        </td>
                                        <td style="width:33%; text-align:center; padding-top:44px; border-top:1.5px solid #000;">
                                            <strong>Giám sát viên</strong>
                                        </td>
                                        <td style="width:33%; text-align:center; padding-top:44px; border-top:1.5px solid #000;">
                                            <strong>Phụ huynh / Người giám hộ</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:center; padding-top:6px; font-size:10pt; color:#555;">
                                            <t t-esc="plan.assigned_teacher_id.name or ''" />
                                        </td>
                                        <td style="text-align:center; padding-top:6px; font-size:10pt; color:#555;">
                                            <t t-esc="plan.supervisor_id.name or ''" />
                                        </td>
                                        <td></td>
                                    </tr>
                                </tbody>
                            </table>

                        </div><!-- end .iep -->
                    </div><!-- end .page -->
                </t>
            </t>
        </t>
    </template>
</odoo>