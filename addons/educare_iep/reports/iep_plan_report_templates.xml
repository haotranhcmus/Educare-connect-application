<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_educare_iep_plan_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="plan">
                <t t-call="web.external_layout">
                    <t t-set="lang" t-value="plan.env.context.get('lang', 'en_US')" />
                    <t t-set="is_vi" t-value="lang and lang.startswith('vi')" />

                    <div class="page">
                        <style>
                            .iep-page { font-family: Arial, sans-serif; font-size: 0.85rem; color:
                            #212529; }
                            .iep-page h2 { font-size: 1.4rem; margin: 4px 0; }
                            .iep-page h3 { font-size: 1.15rem; margin: 0 0 2px 0; }
                            .iep-page h4 { font-size: 1rem; margin: 0 0 2px 0; }
                            .iep-page h5 { font-size: 0.95rem; margin: 0 0 6px 0; border-bottom: 1px
                            solid #dee2e6; padding-bottom: 3px; }
                            .iep-page h6 { font-size: 0.85rem; margin: 6px 0 4px 0; }
                            .iep-table { width: 100%; border-collapse: collapse; font-size: 0.85rem;
                            margin-bottom: 0; }
                            .iep-table td, .iep-table th { border: 1px solid #dee2e6; padding: 4px
                            8px; vertical-align: middle; }
                            .iep-table th { background-color: #f8f9fa; font-weight: bold; width:
                            40%; }
                            .iep-badge { display: inline-block; background-color: #6c757d; color:
                            #ffffff; padding: 0.35em 0.65em; font-size: 0.9rem; font-weight: 700;
                            border-radius: 4px; }
                            .iep-section { margin-bottom: 12px; page-break-inside: avoid; }
                            .iep-goal { border: 1px solid #dee2e6; border-radius: 4px; padding: 8px;
                            margin-bottom: 12px; page-break-inside: avoid; }
                            .iep-domain-header { background-color: #f0f0f0; padding: 3px 6px;
                            border-left: 3px solid #6f42c1; margin-bottom: 4px; font-weight: bold;
                            font-size: 0.8rem; text-transform: uppercase; }
                            .iep-obj-table { width: 100%; border-collapse: collapse; font-size:
                            0.82rem; margin-top: 6px; }
                            .iep-obj-table td, .iep-obj-table th { border: 1px solid #dee2e6;
                            padding: 3px 6px; vertical-align: middle; }
                            .iep-obj-table thead tr { background-color: #f8f9fa; }
                            .iep-two-col { width: 100%; border-collapse: collapse; }
                            .iep-two-col > tbody > tr > td { vertical-align: top; width: 50%; }
                            .iep-two-col > tbody > tr > td:first-child { padding-right: 6px; }
                            .iep-two-col > tbody > tr > td:last-child { padding-left: 6px; }
                            .iep-text-muted { color: #6c757d; font-style: italic; }
                            .iep-text-center { text-align: center; }
                            .iep-small { font-size: 0.82rem; }
                            .iep-goal-meta { font-size: 0.82rem; }
                            .iep-goal-meta-table { width: 100%; border-collapse: collapse; }
                            .iep-goal-meta-table td { padding: 1px 0; }
                        </style>

                        <div class="iep-page">

                            <!-- ═══════════════════════════════════════════
                                 HEADER
                            ═══════════════════════════════════════════ -->
                            <div class="iep-section iep-text-center" style="margin-bottom:14px;">
                                <t t-if="plan.student_center_id">
                                    <h3>
                                        <t t-esc="plan.student_center_id.name" />
                                    </h3>
                                    <div class="iep-small iep-text-muted"
                                        t-if="plan.student_center_id.address or plan.student_center_id.phone or plan.student_center_id.email">
                                        <t t-if="plan.student_center_id.address">
                                            <span>
                                                <t t-esc="plan.student_center_id.address" />
                                            </span>
                                        </t>
                                        <t t-if="plan.student_center_id.phone">
                                            &amp;nbsp;|&amp;nbsp;<span>ĐT: <t
                                                    t-esc="plan.student_center_id.phone" /></span>
                                        </t>
                                        <t t-if="plan.student_center_id.email">
                                            &amp;nbsp;|&amp;nbsp;<span>
                                                <t t-esc="plan.student_center_id.email" />
                                            </span>
                                        </t>
                                    </div>
                                </t>
                                <h2 style="margin-top:6px;">Kế hoạch Giáo dục Cá nhân (IEP)</h2>
                                <h4 t-field="plan.iep_period" style="margin-bottom:6px;" />
                                <span class="iep-badge">
                                    <t
                                        t-esc="dict(plan.fields_get(['status'])['status']['selection']).get(plan.status, plan.status)" />
                                </span>
                            </div>

                            <!-- ═══════════════════════════════════════════
                                 STUDENT INFORMATION
                            ═══════════════════════════════════════════ -->
                            <t t-set="student" t-value="plan.student_id" />
                            <h5>Thông tin học sinh</h5>
                            <div class="iep-section">
                                <table class="iep-two-col">
                                    <tbody>
                                        <tr>
                                            <td>
                                                <table class="iep-table">
                                                    <tbody>
                                                        <tr>
                                                            <th>Mã học sinh</th>
                                                            <td>
                                                                <t
                                                                    t-esc="student.student_code or '—'" />
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Họ tên</th>
                                                            <td>
                                                                <t t-esc="student.name" />
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Ngày sinh</th>
                                                            <td>
                                                                <t t-if="student.date_of_birth">
                                                                    <t t-if="is_vi">
                                                                        <t
                                                                            t-esc="student.date_of_birth.strftime('%d/%m/%Y')" />
                                                                    </t>
                                                                    <t t-else="">
                                                                        <t
                                                                            t-esc="student.date_of_birth" />
                                                                    </t>
                                                                </t>
                                                                <t t-else="">—</t>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Tuổi</th>
                                                            <td>
                                                                <t t-if="student.age">
                                                                    <t t-esc="student.age" /> tuổi <t
                                                                        t-if="student.age_months">(<t
                                                                            t-esc="student.age_months" />
                                                                    tháng)</t>
                                                                </t>
                                                                <t t-else="">—</t>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                            <td>
                                                <table class="iep-table">
                                                    <tbody>
                                                        <tr>
                                                            <th>Giới tính</th>
                                                            <td>
                                                                <t
                                                                    t-esc="dict(student.fields_get(['gender'])['gender']['selection']).get(student.gender, '—')" />
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Chẩn đoán chính</th>
                                                            <td>
                                                                <t
                                                                    t-esc="dict(student.fields_get(['primary_diagnosis'])['primary_diagnosis']['selection']).get(student.primary_diagnosis, '—')" />
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Trung tâm</th>
                                                            <td>
                                                                <t
                                                                    t-esc="student.center_id.name or '—'" />
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Ngày nhập học</th>
                                                            <td>
                                                                <t t-if="student.enrollment_date">
                                                                    <t t-if="is_vi">
                                                                        <t
                                                                            t-esc="student.enrollment_date.strftime('%d/%m/%Y')" />
                                                                    </t>
                                                                    <t t-else="">
                                                                        <t
                                                                            t-esc="student.enrollment_date" />
                                                                    </t>
                                                                </t>
                                                                <t t-else="">—</t>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- ═══════════════════════════════════════════
                                 PLAN DETAILS
                            ═══════════════════════════════════════════ -->
                            <h5>Chi tiết kế hoạch</h5>
                            <div class="iep-section">
                                <table class="iep-two-col">
                                    <tbody>
                                        <tr>
                                            <td>
                                                <table class="iep-table">
                                                    <tbody>
                                                        <tr>
                                                            <th>Giáo viên</th>
                                                            <td>
                                                                <t
                                                                    t-esc="plan.assigned_teacher_id.name or '—'" />
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Giám sát</th>
                                                            <td>
                                                                <t
                                                                    t-esc="plan.supervisor_id.name or '—'" />
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Phiên bản</th>
                                                            <td>
                                                                <t t-esc="plan.version_number" />
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                            <td>
                                                <table class="iep-table">
                                                    <tbody>
                                                        <tr>
                                                            <th>Ngày bắt đầu</th>
                                                            <td>
                                                                <t t-if="plan.start_date">
                                                                    <t t-if="is_vi">
                                                                        <t
                                                                            t-esc="plan.start_date.strftime('%d/%m/%Y')" />
                                                                    </t>
                                                                    <t t-else="">
                                                                        <t t-esc="plan.start_date" />
                                                                    </t>
                                                                </t>
                                                                <t t-else="">—</t>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Ngày kết thúc</th>
                                                            <td>
                                                                <t t-if="plan.end_date">
                                                                    <t t-if="is_vi">
                                                                        <t
                                                                            t-esc="plan.end_date.strftime('%d/%m/%Y')" />
                                                                    </t>
                                                                    <t t-else="">
                                                                        <t t-esc="plan.end_date" />
                                                                    </t>
                                                                </t>
                                                                <t t-else="">—</t>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Tần suất đánh giá</th>
                                                            <td>
                                                                <t
                                                                    t-esc="dict(plan.fields_get(['review_frequency'])['review_frequency']['selection']).get(plan.review_frequency, '—')" />
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- ═══════════════════════════════════════════
                                 APPROVAL INFO
                            ═══════════════════════════════════════════ -->
                            <t t-if="plan.status != 'draft'">
                                <div class="iep-section">
                                    <table class="iep-table" style="width:100%;">
                                        <tbody>
                                            <tr>
                                                <th style="width:25%;">Giám sát viên phê duyệt</th>
                                                <td style="width:25%;">
                                                    <t
                                                        t-esc="'Có' if plan.supervisor_approved else 'Không'" />
                                                </td>
                                                <th style="width:25%;">Ngày phê duyệt</th>
                                                <td style="width:25%;">
                                                    <t t-if="plan.approved_date">
                                                        <t t-if="is_vi">
                                                            <t
                                                                t-esc="plan.approved_date.strftime('%d/%m/%Y')" />
                                                        </t>
                                                        <t t-else="">
                                                            <t t-esc="plan.approved_date" />
                                                        </t>
                                                    </t>
                                                    <t t-else="">—</t>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </t>

                            <!-- ═══════════════════════════════════════════
                                 LATEST ASSESSMENT
                            ═══════════════════════════════════════════ -->
                            <t t-set="latest_assessment"
                                t-value="student.assessment_ids[:1] if student.assessment_ids else False" />
                            <t t-if="latest_assessment">
                                <h5>Đánh giá gần nhất</h5>
                                <div class="iep-section">
                                    <table class="iep-table" style="width:100%;">
                                        <tbody>
                                            <tr>
                                                <th style="width:20%;">Ngày</th>
                                                <td style="width:30%;">
                                                    <t t-if="latest_assessment.assessment_date">
                                                        <t t-if="is_vi">
                                                            <t
                                                                t-esc="latest_assessment.assessment_date.strftime('%d/%m/%Y')" />
                                                        </t>
                                                        <t t-else="">
                                                            <t
                                                                t-esc="latest_assessment.assessment_date" />
                                                        </t>
                                                    </t>
                                                    <t t-else="">—</t>
                                                </td>
                                                <th style="width:20%;">Loại</th>
                                                <td style="width:30%;">
                                                    <t
                                                        t-esc="dict(latest_assessment.fields_get(['assessment_type'])['assessment_type']['selection']).get(latest_assessment.assessment_type, '—')" />
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>VB-MAPP</th>
                                                <td>
                                                    <t t-esc="latest_assessment.vbmapp_score" />
                                                </td>
                                                <th>ABLLS-R</th>
                                                <td>
                                                    <t t-esc="latest_assessment.ablls_score" />
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Tiến độ tổng thể</th>
                                                <td>
                                                    <t
                                                        t-esc="dict(latest_assessment.fields_get(['overall_progress'])['overall_progress']['selection']).get(latest_assessment.overall_progress, '—')" />
                                                </td>
                                                <th>Phân loại</th>
                                                <td>
                                                    <t
                                                        t-esc="dict(latest_assessment.fields_get(['classification'])['classification']['selection']).get(latest_assessment.classification, '—')" />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Assessment lines grouped by domain -->
                                <t t-if="latest_assessment.line_ids">
                                    <h6>Đánh giá điểm mạnh / hạn chế theo lĩnh vực</h6>
                                    <t t-set="all_lines" t-value="latest_assessment.line_ids" />
                                    <t t-foreach="all_lines.mapped('domain_id')" t-as="domain">
                                        <div class="iep-section">
                                            <div class="iep-domain-header">
                                                <t t-esc="domain.name" />
                                            </div>
                                            <table class="iep-obj-table">
                                                <thead>
                                                    <tr>
                                                        <th style="width:24%;">Tiêu chí</th>
                                                        <th style="width:38%;">Điểm mạnh</th>
                                                        <th style="width:38%;">Hạn chế / Thách thức</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t
                                                        t-foreach="all_lines.filtered(lambda l: l.domain_id.id == domain.id)"
                                                        t-as="dl">
                                                        <tr>
                                                            <td>
                                                                <t t-esc="dl.item_id.name" />
                                                            </td>
                                                            <td>
                                                                <t t-esc="dl.strength_text or '—'" />
                                                            </td>
                                                            <td>
                                                                <t t-esc="dl.limitation_text or '—'" />
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </t>
                                </t>
                            </t>

                            <!-- ═══════════════════════════════════════════
                                 LONG-TERM GOALS
                            ═══════════════════════════════════════════ -->
                            <h5 style="margin-top:10px;">Mục tiêu dài hạn</h5>
                            <t t-if="not plan.goal_ids">
                                <p class="iep-text-muted">Chưa có mục tiêu nào được thêm vào kế
                                    hoạch.</p>
                            </t>
                            <t t-foreach="plan.goal_ids" t-as="goal">
                                <div class="iep-goal">
                                    <!-- Goal header: title left, badge right using table -->
                                    <table
                                        style="width:100%; border-collapse:collapse; margin-bottom:4px;">
                                        <tbody>
                                            <tr>
                                                <td style="vertical-align:top;">
                                                    <strong><t t-esc="goal.goal_code" /> — <t
                                                            t-esc="goal.name" /></strong>
                                                </td>
                                                <td
                                                    style="vertical-align:top; text-align:right; white-space:nowrap; padding-left:8px;">
                                                    <span class="iep-badge"
                                                        style="font-size:0.78rem;">
                                                        <t
                                                            t-esc="dict(goal.fields_get(['status'])['status']['selection']).get(goal.status, goal.status)" />
                                                    </span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>

                                    <!-- Goal meta info -->
                                    <table class="iep-goal-meta-table iep-goal-meta">
                                        <tbody>
                                            <tr>
                                                <td style="width:33%;">Lĩnh vực: <t
                                                        t-esc="goal.goal_domain_id.name or '—'" /></td>
                                                <td style="width:33%;">Ưu tiên: <t
                                                        t-esc="goal.priority or '—'" /></td>
                                                <td style="width:34%;">Ngày mục tiêu:&#160; <t
                                                        t-if="goal.target_date">
                                                        <t t-if="is_vi">
                                                            <t
                                                                t-esc="goal.target_date.strftime('%d/%m/%Y')" />
                                                        </t>
                                                        <t t-else="">
                                                            <t t-esc="goal.target_date" />
                                                        </t>
                                                    </t>
                                                    <t
                                                        t-else="">—</t>
                                                </td>
                                            </tr>
                                            <t t-if="goal.goal_description">
                                                <tr>
                                                    <td colspan="3">Mô tả: <t
                                                            t-esc="goal.goal_description" /></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>

                                    <!-- Objectives -->
                                    <t t-if="goal.objective_ids">
                                        <table class="iep-obj-table">
                                            <thead>
                                                <tr>
                                                    <th style="width:10%;">Mã</th>
                                                    <th style="width:35%;">Mục tiêu ngắn hạn</th>
                                                    <th style="width:13%;">Ngày mục tiêu</th>
                                                    <th style="width:12%;">Mức ban đầu (%)</th>
                                                    <th style="width:12%;">Mục tiêu (%)</th>
                                                    <th style="width:18%;">Trạng thái</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="goal.objective_ids" t-as="obj">
                                                    <tr>
                                                        <td>
                                                            <t t-esc="obj.objective_code" />
                                                        </td>
                                                        <td>
                                                            <t t-esc="obj.name" />
                                                        </td>
                                                        <td>
                                                            <t t-if="obj.target_date">
                                                                <t t-if="is_vi">
                                                                    <t
                                                                        t-esc="obj.target_date.strftime('%d/%m/%Y')" />
                                                                </t>
                                                                <t t-else="">
                                                                    <t t-esc="obj.target_date" />
                                                                </t>
                                                            </t>
                                                            <t t-else="">—</t>
                                                        </td>
                                                        <td>
                                                            <t t-esc="obj.baseline_accuracy_pct" />
                                                        </td>
                                                        <td>
                                                            <t t-esc="obj.target_accuracy_pct" />
                                                        </td>
                                                        <td>
                                                            <t
                                                                t-esc="dict(obj.fields_get(['status'])['status']['selection']).get(obj.status, obj.status)" />
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </t>
                                    <t t-else="">
                                        <p class="iep-text-muted iep-small"
                                            style="margin:4px 0 0 8px;">Chưa có mục tiêu ngắn hạn.</p>
                                    </t>
                                </div>
                            </t>

                            <!-- ═══════════════════════════════════════════
                                 SIGNATURES
                            ═══════════════════════════════════════════ -->
                            <table
                                style="width:100%; border-collapse:collapse; margin-top:40px; page-break-inside:avoid;">
                                <tbody>
                                    <tr>
                                        <td
                                            style="width:33%; text-align:center; padding-top:40px; border-top:1px solid #000;">
                                            Chữ ký Giáo viên
                                        </td>
                                        <td
                                            style="width:33%; text-align:center; padding-top:40px; border-top:1px solid #000;">
                                            Chữ ký Giám sát
                                        </td>
                                        <td
                                            style="width:33%; text-align:center; padding-top:40px; border-top:1px solid #000;">
                                            Chữ ký Phụ huynh / Người giám hộ
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                        </div><!--
                        end iep-page -->
                    </div><!--
                    end page -->
                </t>
            </t>
        </t>
    </template>
</odoo>