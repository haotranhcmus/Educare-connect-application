<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ==================== TREE VIEW ==================== -->
        <record id="educare_audit_log_tree_view" model="ir.ui.view">
            <field name="name">Educare Audit Log Tree</field>
            <field name="model">educare.audit.log</field>
            <field name="arch" type="xml">
                <tree string="System Audit Log"
                    create="false"
                    edit="false"
                    delete="false"
                    decoration-info="action == 'create'"
                    decoration-warning="action == 'write'"
                    decoration-danger="action == 'unlink'">

                    <field name="create_date" string="Timestamp" />
                    <field name="user_id" string="User" />
                    <field name="action" string="Action" />
                    <field name="model_name" string="Model" />
                    <field name="record_name" string="Record" />
                    <field name="center_id" string="Center" />

                </tree>
            </field>
        </record>


        <!-- ==================== FORM VIEW ==================== -->
        <record id="educare_audit_log_form_view" model="ir.ui.view">
            <field name="name">Educare Audit Log Form</field>
            <field name="model">educare.audit.log</field>
            <field name="arch" type="xml">
                <form string="Audit Log Details" edit="false">

                    <sheet>

                        <group>
                            <group string="Record Information">
                                <field name="model_name" readonly="1" />
                                <field name="record_id" readonly="1" />
                                <field name="record_name" readonly="1" />
                                <field name="action" readonly="1" />
                            </group>
                            <group string="Action Information">
                                <field name="user_id" readonly="1" />
                                <field name="create_date" string="Timestamp" readonly="1" />
                                <field name="ip_address" readonly="1" />
                                <field name="center_id" readonly="1" />
                            </group>
                        </group>

                        <group>
                            <field name="old_values"
                                string="Old Values (JSON)"
                                widget="text"
                                colspan="2"
                                readonly="1" />
                        </group>

                        <group>
                            <field name="new_values"
                                string="New Values (JSON)"
                                widget="text"
                                colspan="2"
                                readonly="1" />
                        </group>

                        <group>
                            <field name="notes"
                                string="Notes"
                                colspan="2"
                                readonly="1" />
                        </group>

                    </sheet>

                </form>
            </field>
        </record>


        <!-- ==================== SEARCH VIEW ==================== -->
        <record id="educare_audit_log_search_view" model="ir.ui.view">
            <field name="name">Educare Audit Log Search</field>
            <field name="model">educare.audit.log</field>
            <field name="arch" type="xml">
                <search string="Search Audit Log">

                    <field name="model_name" string="Model" />
                    <field name="record_name" string="Record Name" />
                    <field name="user_id" string="User" />

                    <separator />

                    <filter string="Create" name="filter_create"
                        domain="[('action', '=', 'create')]" />
                    <filter string="Write" name="filter_write"
                        domain="[('action', '=', 'write')]" />
                    <filter string="Delete" name="filter_unlink"
                        domain="[('action', '=', 'unlink')]" />

                    <separator />

                    <filter string="Today" name="filter_today"
                        domain="[('create_date', '>=', context_today().strftime('%Y-%m-%d'))]" />
                    <filter string="This Week" name="filter_this_week"
                        domain="[('create_date', '>=', (context_today() + relativedelta(weekday=0, days=-6)).strftime('%Y-%m-%d'))]" />
                    <filter string="This Month" name="filter_this_month"
                        domain="[('create_date', '>=', context_today().strftime('%Y-%m-01'))]" />

                    <group string="Group By">
                        <filter string="Model" name="group_by_model"
                            context="{'group_by': 'model_name'}" />
                        <filter string="Action" name="group_by_action"
                            context="{'group_by': 'action'}" />
                        <filter string="User" name="group_by_user"
                            context="{'group_by': 'user_id'}" />
                        <filter string="Center" name="group_by_center"
                            context="{'group_by': 'center_id'}" />
                    </group>

                </search>
            </field>
        </record>


        <!-- ==================== ACTION ==================== -->
        <record id="action_educare_audit_log" model="ir.actions.act_window">
            <field name="name">System Audit Log</field>
            <field name="res_model">educare.audit.log</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No audit log found.
                </p>
                <p>Audit logs are automatically recorded when create/update/delete operations are
                    performed on the system.</p>
            </field>
        </record>


    </data>
</odoo>