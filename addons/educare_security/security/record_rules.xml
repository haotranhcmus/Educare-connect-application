<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- ══════════════════════════════════════════════════════
         USER PROFILE RULES
    ══════════════════════════════════════════════════════ -->

        <!--
      Parent: read own profile only
      perm_write/create/unlink = False -> these operations are controlled by ACL, not rule
    -->
        <record id="rule_user_profile_parent" model="ir.rule">
            <field name="name">User Profile: Parent sees own</field>
            <field name="model_id" ref="model_educare_user_profile" />
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('educare_security.group_parent'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <!--
      Teacher: sees own profile + all profiles in the same center
      OR logic: user_id = self OR center_id in own centers
    -->
        <record id="rule_user_profile_teacher" model="ir.rule">
            <field name="name">User Profile: Teacher sees same center</field>
            <field name="model_id" ref="model_educare_user_profile" />
            <field name="domain_force">['|',
                ('user_id', '=', user.id),
                ('center_id', 'in', user.educare_profile_ids.center_id.ids)
                ]</field>
            <field name="groups" eval="[(4, ref('educare_security.group_teacher'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <!--
      Supervisor: sees all profiles in own center
      perm_* not declared -> defaults to True for all operations
    -->
        <record id="rule_user_profile_supervisor" model="ir.rule">
            <field name="name">User Profile: Supervisor sees all in center</field>
            <field name="model_id" ref="model_educare_user_profile" />
            <field name="domain_force">[('center_id', 'in', user.educare_profile_ids.center_id.ids)]</field>
            <field name="groups" eval="[(4, ref('educare_security.group_supervisor'))]" />
        </record>

        <!--
      Admin: sees all profiles - domain (1=1) is always True
    -->
        <record id="rule_user_profile_admin" model="ir.rule">
            <field name="name">User Profile: Admin sees all</field>
            <field name="model_id" ref="model_educare_user_profile" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('educare_security.group_admin'))]" />
        </record>


        <!-- ══════════════════════════════════════════════════════
         AUDIT LOG RULES
    ══════════════════════════════════════════════════════ -->

        <!--
      Supervisor: sees only audit logs from own center
      Teacher and Parent have no rule -> they cannot see any audit logs
      (controlled by ACL layer - no perm_read for teacher/parent groups)
    -->
        <record id="rule_audit_log_supervisor" model="ir.rule">
            <field name="name">Audit Log: Supervisor sees center logs</field>
            <field name="model_id" ref="model_educare_audit_log" />
            <field name="domain_force">[('center_id', 'in', user.educare_profile_ids.center_id.ids)]</field>
            <field name="groups" eval="[(4, ref('educare_security.group_supervisor'))]" />
        </record>

        <!--
      Admin: sees all audit logs
    -->
        <record id="rule_audit_log_admin" model="ir.rule">
            <field name="name">Audit Log: Admin sees all</field>
            <field name="model_id" ref="model_educare_audit_log" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('educare_security.group_admin'))]" />
        </record>


    </data>

    <!-- ══════════════════════════════════════════════════════
         SELF-ACCESS RULES (noupdate=0 — always updated on install/upgrade)
    ══════════════════════════════════════════════════════ -->
    <data noupdate="0">
        <!--
          Any authenticated user can read their OWN profile record.
          This is a safety baseline that allows "Hồ sơ của tôi" to work
          even when the group-specific rule (teacher/supervisor) would exclude
          the record (e.g. profile has no center_id yet).
          Rules within the same model/group are combined with OR per user,
          so this adds access without removing anything from existing role rules.
        -->
        <record id="rule_user_profile_self_read" model="ir.rule">
            <field name="name">User Profile: Any user reads own profile</field>
            <field name="model_id" ref="model_educare_user_profile" />
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>
    </data>

</odoo>