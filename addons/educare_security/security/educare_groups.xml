<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- Module Category: hiển thị trong Settings → Users → Access Rights -->
        <record id="module_category_educare" model="ir.module.category">
            <field name="name">Educare</field>
            <field name="description">Educare IEP Management System</field>
            <field name="sequence">200</field>
        </record>

        <!-- Group 1: Parent — base level, không implied gì -->
        <record id="group_parent" model="res.groups">
            <field name="name">Parent</field>
            <field name="category_id" ref="module_category_educare" />
            <field name="comment">Phụ huynh — chỉ đọc thông tin con mình</field>
        </record>

        <!-- Group 2: Teacher — kế thừa Parent -->
        <record id="group_teacher" model="res.groups">
            <field name="name">Teacher</field>
            <field name="category_id" ref="module_category_educare" />
            <field name="implied_ids" eval="[(4, ref('group_parent'))]" />
            <field name="comment">Giáo viên — quản lý hồ sơ HS phân công</field>
        </record>

        <!-- Group 3: Supervisor — kế thừa Teacher (và qua đó kế thừa Parent) -->
        <record id="group_supervisor" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="category_id" ref="module_category_educare" />
            <field name="implied_ids" eval="[(4, ref('group_teacher'))]" />
            <field name="comment">BCBA/Supervisor — giám sát toàn center</field>
        </record>

        <!-- Group 4: Admin — kế thừa tất cả qua chain -->
        <record id="group_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="category_id" ref="module_category_educare" />
            <field name="implied_ids" eval="[(4, ref('group_supervisor'))]" />
            <field name="comment">Admin — toàn quyền hệ thống</field>
        </record>

    </data>
</odoo>